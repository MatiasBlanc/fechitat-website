---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Tag from '../../components/Tag.astro';
import UIcon from '../../components/icons/UIcon.astro';
import { getEventoBySlug, getGaleriaByEventoId } from '../../lib/sanityQueries';
import { urlFor } from '../../lib/sanity';

const slug = Astro.params.slug;
const evento = slug ? await getEventoBySlug(slug) : null;

if (!evento) {
  return Astro.redirect('/eventos');
}

const albumRelacionado = evento._id ? await getGaleriaByEventoId(evento._id) : null;
const fotos = [...(evento.galeria ?? []), ...(albumRelacionado?.fotos ?? [])];
const fotosConUrl = fotos.map((foto, indice) => ({
  alt: foto.alt || `${evento.titulo} — foto ${indice + 1}`,
  miniatura: urlFor(foto).width(900).height(650).fit('crop').url(),
  original: urlFor(foto).width(1800).url(),
}));

const labelTipo = (tipo: string) => {
  if (tipo === 'competencia') return 'Competencia';
  if (tipo === 'examen') return 'Examen';
  if (tipo === 'seminario') return 'Seminario';
  if (tipo === 'exhibicion') return 'Exhibición';
  return 'Otro';
};

const fecha = new Date(evento.fecha).toLocaleDateString('es-CL', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<BaseLayout title={`${evento.titulo} — Eventos`}>
  <PageHero
    title={evento.titulo}
    crumb="Eventos"
    description={evento.descripcion}
    image={evento.flyer ? urlFor(evento.flyer).width(900).url() : undefined}
    imageAlt={`Flyer de ${evento.titulo}`}
  />

  <main class="py-10 md:py-[4.4em]">
    <div class="max-w-[1180px] mx-auto px-5 md:px-7">
      <a href="/eventos" class="inline-flex items-center gap-2 text-text-soft hover:text-red font-mono text-xs tracking-widest uppercase mb-8 transition-colors duration-150">
        <UIcon name="arrow-left" size={16} />
        Volver a eventos
      </a>

      <div class="flex flex-wrap items-center gap-3 mb-8">
        <Tag variant={evento.tipo === 'competencia' ? 'red' : evento.tipo === 'examen' ? 'blue' : evento.tipo === 'seminario' ? 'gold' : 'default'}>
          {labelTipo(evento.tipo)}
        </Tag>
        <span class="font-mono text-xs tracking-wider text-text-soft">{fecha}</span>
        {evento.lugar && <span class="font-mono text-xs tracking-wider text-text-soft">{evento.lugar}</span>}
      </div>

      {evento.descripcion && <p class="text-text-soft max-w-[70ch] mb-10">{evento.descripcion}</p>}

      <section aria-labelledby="galeria-titulo">
        <div class="flex items-end justify-between gap-4 mb-5">
          <div>
            <p class="font-mono text-[0.7rem] tracking-[0.14em] uppercase text-red mb-2">Memoria del evento</p>
            <h2 id="galeria-titulo">Galería de fotos</h2>
          </div>
          {fotosConUrl.length > 0 && <span class="font-mono text-xs text-text-soft">{fotosConUrl.length} fotos</span>}
        </div>

        {fotosConUrl.length > 0 ? (
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {fotosConUrl.map((foto) => (
              <a href={foto.original} target="_blank" rel="noreferrer" class="group block bg-white border border-line rounded-sm overflow-hidden">
                <div class="aspect-[4/3] overflow-hidden bg-ink/5">
                  <img src={foto.miniatura} alt={foto.alt} loading="lazy" class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105" />
                </div>
                <span class="block px-4 py-3 font-mono text-[0.65rem] tracking-wider uppercase text-text-soft group-hover:text-red transition-colors duration-150">
                  Ver foto completa
                </span>
              </a>
            ))}
          </div>
        ) : (
          <div class="bg-white border border-line rounded-sm p-6 text-text-soft">
            Aún no hay fotos publicadas para este evento.
          </div>
        )}
      </section>
    </div>
  </main>
</BaseLayout>
