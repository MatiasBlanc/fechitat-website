---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';

export const prerender = true;
---

<BaseLayout title="Redirigiendo a Formación | FECHITAT" description="Redirigiendo al centro oficial de formación marcial.">
  <div class="py-24 text-center max-w-lg mx-auto px-4">
    <h1 class="text-2xl font-bold text-slate-900 mb-4">Centro de Formación FECHITAT</h1>
    <p class="text-slate-600 mb-6">El material de estudio ahora se encuentra en nuestra biblioteca formativa oficial.</p>
    <Button href="/formacion" variant="primary" size="md">Ir a Formación</Button>
  </div>
  <script>
    window.location.replace('/formacion');
  </script>
</BaseLayout>
