---
import BaseLayout from '../../layouts/BaseLayout.astro';

const titulo = 'Herramientas — FECHITAT';
const descripcion = 'Herramientas digitales independientes para practicantes y escuelas de Taekwon-Do ITF.';
const tools = [
  {
    titulo: 'TUL · Sonkal ITF',
    descripcion: 'Estudia las formas del Taekwon-Do ITF con la aplicación Sonkal ITF.',
    href: 'https://play.google.com/store/apps/details?id=cz.principal.tul.tkd.itf&hl=en-US',
    accion: 'Descargar en Google Play',
  },
  {
    titulo: 'Temporizador de formas',
    descripcion: 'Usa un temporizador configurable para organizar tu práctica de formas.',
    href: 'https://tools.fechitat.cl/temporizador',
    accion: 'Abrir temporizador',
  },
];
---

<BaseLayout title={titulo} description={descripcion}>
  <section class="bg-ink text-white">
    <div class="max-w-6xl mx-auto px-5 md:px-7 py-16 md:py-24">
      <span class="font-mono text-xs tracking-[0.18em] uppercase text-red">Herramientas digitales FECHITAT</span>
      <h1 class="text-white text-4xl md:text-6xl mt-4">Herramientas para tu práctica</h1>
      <p class="text-light-soft max-w-2xl mt-5">
        Recursos digitales para estudiar las formas ITF y organizar tu práctica con el temporizador.
      </p>
    </div>
  </section>

  <section class="py-12 md:py-16">
    <div class="max-w-6xl mx-auto px-5 md:px-7 grid gap-5 md:grid-cols-2">
      {tools.map((tool) => (
        <article class="bg-white border border-line rounded-sm p-6 md:p-8">
          <h2 class="text-2xl">{tool.titulo}</h2>
          <p class="text-text-soft mt-3">{tool.descripcion}</p>
          <a
            href={tool.href}
            class="inline-flex mt-6 text-red font-mono text-xs tracking-wider uppercase hover:underline"
          >
            {tool.accion} →
          </a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
