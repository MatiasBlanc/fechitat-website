---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const titulo = 'Material de estudio — FECHITAT';

const recursos = [
  {
    titulo: 'Principios del Taekwon-Do',
    descripcion:
      'Los cinco pilares que guían cada aspecto del entrenamiento: cortesía, integridad, perseverancia, autocontrol y espíritu indomable.',
    tipo: 'Fundamentos',
    color: 'bg-red',
    items: ['Significado de cada principio', 'Aplicación en el dojang', 'Reflexiones del General Choi'],
  },
  {
    titulo: 'Terminología coreana',
    descripcion:
      'Vocabulario esencial para comunicarte en clase y entender las instrucciones del instructor.',
    tipo: 'Vocabulario',
    color: 'bg-blue',
    items: ['Posiciones (sogui)', 'Defensas (makki)', 'Ataques (jireugi)', 'Patadas (chagi)'],
  },
  {
    titulo: 'Tuls y movimientos fundamentales',
    descripcion:
      'Secuencias de formas que cada practicante debe dominar para avanzar de grado.',
    tipo: 'Técnica',
    color: 'bg-gold',
    items: ['Chon-Ji a Choong-Moo', 'Diagramas y direcciones', 'Puntos de atención por tul'],
  },
  {
    titulo: 'Preparación para el examen',
    descripcion:
      'Lista de repaso completa para llegar preparado y con confianza a tu próximo examen de grado.',
    tipo: 'Grados',
    color: 'bg-ink',
    items: ['Requisitos por grado (gup)', 'Teoría y significados', 'Formato del examen'],
  },
];
---

<BaseLayout title={titulo}>
  <PageHero
    title="Material de estudio"
    description="Guías y recursos para estudiar en casa y complementar el trabajo de tu dojang."
  />

  <section class="py-10 md:py-16">
    <div class="max-w-7xl mx-auto px-5 md:px-7">
      <div class="mb-10">
        <h2>Aprende para tu próximo grado</h2>
        <p class="text-text-soft text-sm md:text-base max-w-[60ch] mt-2">
          Todo lo que necesitas para preparar tu examen de grado, organizado por
          temática. Estudia en casa y complementa lo que aprendes en el dojang.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {recursos.map((recurso) => (
          <article class="bg-white border border-line rounded-sm overflow-hidden transition-transform duration-200 hover:-translate-y-1 hover:shadow-lg">
            {/* Barra de acento superior */}
            <div class={`h-1.5 ${recurso.color}`} />

            <div class="p-5">
              <span class="font-mono text-xs tracking-widest uppercase text-text-soft">
                {recurso.tipo}
              </span>
              <h3 class="text-ink text-base md:text-lg mt-2 mb-2">
                {recurso.titulo}
              </h3>
              <p class="text-text-soft text-sm leading-relaxed mb-4">
                {recurso.descripcion}
              </p>

              {/* Lista de contenido */}
              <ul class="space-y-1.5">
                {recurso.items.map((item) => (
                  <li class="text-sm text-text-soft flex items-start gap-2">
                    <span class="text-red mt-0.5">•</span>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
