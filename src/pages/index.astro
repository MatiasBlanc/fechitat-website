---
import EventBadge from "../components/EventBadge.astro";
import HangulRail from "../components/HangulRail.astro";
import Stat from "../components/Stat.astro";
import Tag from "../components/Tag.astro";
import Card from "../components/ui/Card.astro";
import Badge from "../components/ui/Badge.astro";
import UIcon from "../components/icons/UIcon.astro";
import Button from "../components/ui/Button.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import heroImg from "../assets/hero/hero.webp";
import { img } from "../lib/imagenes";
import {
  getMetricas,
  getProximoEventoDestacado,
  getBlogPostsDestacados,
  getEscuelasPorRegion,
} from "../lib/sanityQueries";
import { urlFor } from "../lib/sanity";
import "leaflet/dist/leaflet.css";

export const prerender = true;
export const revalidate = 3600;

const titulo = "FECHITAT — Federación Chilena de Taekwon-Do Tradicional";
const descripcion =
  "Encuentra dojangs afiliados, eventos y formación de Taekwon-Do ITF en Chile. Entrena con FECHITAT desde tu ciudad.";

// Datos de Sanity
const [metricas, proximoEvento, noticias, escuelas] = await Promise.all([
  getMetricas(),
  getProximoEventoDestacado(),
  getBlogPostsDestacados(),
  getEscuelasPorRegion(),
]);

const escuelasMapa = escuelas.map((escuela: any) => ({
  _id: escuela._id,
  nombre: escuela.nombre,
  slug: escuela.slug?.current ?? "",
  ciudad: escuela.ciudad ?? "",
  region: escuela.region ?? "",
  lat: escuela.ubicacion?.lat ?? null,
  lng: escuela.ubicacion?.lng ?? null,
  logo: escuela.logo ? urlFor(escuela.logo).width(64).height(64).fit("crop").url() : null,
}));

const regionesDisponibles = [...new Set(escuelas.map((e: any) => e.region).filter(Boolean))].sort();

const riel = [
  ...(proximoEvento ? [{ href: "#eventos", kr: "대회", label: "Eventos" }] : []),
  { href: "#participar", kr: "길", label: "Tu camino" },
  { href: "#quienes-somos", kr: "정신", label: "Valores" },
  { href: "#dojangs", kr: "도장", label: "Dojangs" },
  { href: "#noticias", kr: "소식", label: "Noticias" },
];
---

<BaseLayout title={titulo} description={descripcion}>
  <HangulRail links={riel} />

  <!-- Hero con altura balanceada para permitir visualizar que se puede seguir haciendo scroll -->
  <section
    class="hero relative min-h-[50vh] md:min-h-[60vh] flex items-end text-white overflow-hidden bg-slate-950"
  >
    <Image
      src={heroImg}
      alt=""
      fill
      sizes="100vw"
      fetchpriority="high"
      class="absolute inset-0 object-cover object-center opacity-45"
    />
    <div
      class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/60 to-slate-950/30"
    >
    </div>

    <div
      class="relative z-10 py-10 md:py-14 pb-8 md:pb-12 w-full max-w-7xl mx-auto px-5 md:px-7"
    >
      <h1 class="text-white text-3xl sm:text-4xl md:text-6xl font-bold tracking-tight max-w-xl leading-tight mb-3">
        Encuentra tu camino<br />en el Taekwon-Do
      </h1>
      <p
        class="text-sm md:text-base text-slate-200 max-w-lg mb-6 font-normal leading-relaxed"
      >
        Dojangs de Arica a Punta Arenas, instructores certificados por ITF y una
        comunidad que entrena con disciplina, respeto y proyección
        internacional.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 sm:gap-4">
        <Button href="#dojangs" variant="primary" size="md">
          Encuentra tu dojang
        </Button>
        <Button href="/federacion" variant="ghost" size="md">
          Conoce la federación
        </Button>
      </div>
    </div>
  </section>

  <!-- Próximo campeonato inmediatamente después del hero (sin badges redundantes ni botón duplicado) -->
  {proximoEvento && (
    <section class="py-5 md:py-7 bg-white border-b border-slate-200" id="eventos">
      <div class="max-w-7xl mx-auto px-5 md:px-7">
        <div class="flex flex-col md:flex-row items-start md:items-center gap-4 md:gap-6 justify-between">
          <div class="flex items-center gap-4">
            <EventBadge
              mes={new Date(proximoEvento.fecha).toLocaleDateString('es-CL', { month: 'short' }).toUpperCase()}
              dia={new Date(proximoEvento.fecha).getDate().toString()}
            />
            <div>
              <span class="font-mono text-xs tracking-wider uppercase text-itf-red font-bold">
                Próximo campeonato
              </span>
              <div class="font-heading font-bold text-base md:text-lg text-slate-900">
                {proximoEvento.titulo}
              </div>
              {proximoEvento.lugar && (
                <div class="text-xs text-slate-500 flex items-center gap-1 mt-0.5">
                  <UIcon name="map-pin" size={13} />
                  <span>{proximoEvento.lugar}</span>
                </div>
              )}
            </div>
          </div>
          <div class="flex flex-col sm:flex-row gap-3 w-full md:w-auto">
            <Button href="/eventos" variant="primary" size="sm">
              Ver campeonato
            </Button>
            <Button href="/eventos" variant="secondary" size="sm">
              Ver todos los torneos
            </Button>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- ¿Cómo deseas participar en FECHITAT? (2 opciones principales) -->
  <section class="py-12 md:py-16 bg-slate-50 border-b border-slate-200" id="participar" aria-labelledby="participar-titulo">
    <div class="max-w-7xl mx-auto px-5 md:px-7">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <h2 id="participar-titulo" class="text-2xl sm:text-3xl font-bold text-slate-900">
          ¿Cómo deseas participar en FECHITAT?
        </h2>
        <p class="text-slate-600 text-sm sm:text-base mt-2">
          Selecciona tu perfil de interés para acceder directamente a la información y recursos correspondientes.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 max-w-5xl mx-auto">
        <!-- Opción 1: Familias / Hijo o hija -->
        <Card hoverable class="p-6 md:p-8 flex flex-col justify-between h-full group">
          <div>
            <div class="w-12 h-12 rounded-xl bg-itf-red-light text-itf-red flex items-center justify-center mb-5 transition-colors group-hover:bg-itf-red group-hover:text-white">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
              </svg>
            </div>
            <div class="flex items-center gap-2 mb-3">
              <Badge variant="campeonato">Familias & Niños</Badge>
            </div>
            <h3 class="text-xl md:text-2xl font-bold text-slate-900 group-hover:text-itf-red transition-colors">
              Busco para mi hijo/a o familiar
            </h3>
            <p class="text-slate-600 text-sm sm:text-base mt-3 leading-relaxed">
              Formación integral en disciplina, respeto, autocontrol y seguridad personal. Conoce los beneficios para el desarrollo infantil y juvenil, medidas de seguridad y cómo reservar una clase de prueba.
            </p>
          </div>
          <div class="mt-8 pt-5 border-t border-slate-100">
            <a href="/padres" class="inline-flex items-center gap-2 text-sm font-semibold text-itf-red group-hover:underline">
              <span>Conocer el programa para familias</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </Card>

        <!-- Opción 2: Competidor -->
        <Card hoverable class="p-6 md:p-8 flex flex-col justify-between h-full group">
          <div>
            <div class="w-12 h-12 rounded-xl bg-itf-blue-light text-itf-blue flex items-center justify-center mb-5 transition-colors group-hover:bg-itf-blue group-hover:text-white">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 18.75h-9m9 0a3 3 0 0 1 3 3h-15a3 3 0 0 1 3-3m9 0v-3.375c0-.621-.503-1.125-1.125-1.125h-.871M7.5 18.75v-3.375c0-.621.504-1.125 1.125-1.125h.872m5.003 0H9.497m5.003 0a3 3 0 0 0 3-3V7.5a2.25 2.25 0 0 0-2.25-2.25h-6A2.25 2.25 0 0 0 7 7.5v4.875a3 3 0 0 0 3 3Z" />
              </svg>
            </div>
            <div class="flex items-center gap-2 mb-3">
              <Badge variant="noticia">Competidores</Badge>
            </div>
            <h3 class="text-xl md:text-2xl font-bold text-slate-900 group-hover:text-itf-blue transition-colors">
              Quiero avanzar y competir
            </h3>
            <p class="text-slate-600 text-sm sm:text-base mt-3 leading-relaxed">
              Avanza en la escala de grados Gup y Dan, accede al calendario de torneos federados, reglamentos de pesaje y llaves, y conoce el proceso de postulación a la Selección Nacional.
            </p>
          </div>
          <div class="mt-8 pt-5 border-t border-slate-100">
            <a href="/jovenes" class="inline-flex items-center gap-2 text-sm font-semibold text-itf-blue group-hover:underline">
              <span>Conocer el camino competitivo</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </Card>
      </div>
    </div>
  </section>

  <!-- Quiénes somos / Formamos artistas marciales -->
  <section class="py-10 md:py-16" id="quienes-somos">
    <div
      class="max-w-7xl mx-auto px-5 md:px-7 grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center"
    >
      <div>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-slate-900 leading-tight">
          Formamos artistas marciales,<br />no solo competidores
        </h2>
        <p class="text-slate-600 text-sm md:text-base max-w-xl mt-4 leading-relaxed">
          Trabajamos junto a instituciones deportivas que apoyan el desarrollo
          del Taekwon-Do ITF en Chile. Cada medalla representa el trabajo
          constante de nuestros dojangs y el orgullo de vestir la bandera
          chilena.
        </p>
        <div class="h-px bg-slate-200 my-6"></div>
        <div class="grid grid-cols-2 gap-4 md:gap-6">
          {metricas.length > 0 ? (
            metricas.map((m) => (
              <Stat count={m.valor} suffix={m.sufijo} label={m.titulo} />
            ))
          ) : (
            <>
              <Stat count={50} suffix="+" label="Cinturones negros" />
              <Stat count={150} suffix="+" label="Competidores activos" />
            </>
          )}
        </div>
      </div>
      <div>
        <img
          src={img.competidora}
          alt="Competidora de Taekwon-Do ITF con el uniforme nacional"
          width="1000"
          height="667"
          loading="lazy"
          decoding="async"
          class="rounded-lg w-full h-auto shadow-md"
        />
      </div>
    </div>
  </section>

  <!-- Red de dojangs: Nuevo buscador rápido + Mapa interactivo ("Encuentra una escuela certificada") -->
  <section class="py-12 md:py-16 bg-slate-50 border-t border-b border-slate-200" id="dojangs">
    <div class="max-w-7xl mx-auto px-5 md:px-7">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-8">
        <div>
          <span class="font-mono text-xs tracking-wider uppercase text-itf-red font-semibold block mb-1">Red Nacional de Dojangs</span>
          <h2 class="text-2xl sm:text-3xl font-bold text-slate-900">Encuentra una escuela certificada</h2>
          <p class="text-slate-600 text-sm md:text-base mt-2 max-w-2xl">
            Escribe una ciudad o nombre y localiza el dojang oficial más cercano en el mapa interactivo.
          </p>
        </div>
        <a href="/escuelas" class="inline-flex items-center gap-2 font-mono text-xs tracking-widest uppercase text-itf-red font-semibold hover:underline self-start md:self-auto">
          Ver todas las escuelas ({escuelas.length})
          <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        <!-- Panel de Búsqueda y Resultados -->
        <div class="lg:col-span-5 flex flex-col gap-4">
          <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-xs space-y-3">
            <div>
              <label for="buscar-escuela" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
                Buscar por nombre o ciudad
              </label>
              <div class="relative">
                <input
                  id="buscar-escuela"
                  type="search"
                  class="w-full border border-slate-300 bg-white px-4 py-2.5 text-sm font-medium rounded-lg focus-visible:outline-2 focus-visible:outline-itf-blue"
                  placeholder="Ej: La Serena, Santiago, Sipjin..."
                  autocomplete="off"
                />
              </div>
            </div>

            {regionesDisponibles.length > 0 && (
              <div>
                <label for="filtro-region-home" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
                  Filtrar por región
                </label>
                <select
                  id="filtro-region-home"
                  class="w-full border border-slate-300 bg-white px-3 py-2 text-sm font-medium rounded-lg focus-visible:outline-2 focus-visible:outline-itf-blue"
                >
                  <option value="">Todas las regiones</option>
                  {regionesDisponibles.map((region) => (
                    <option value={region}>{region}</option>
                  ))}
                </select>
              </div>
            )}
          </div>

          <!-- Lista interactiva de resultados -->
          <div class="bg-white rounded-xl border border-slate-200 overflow-hidden shadow-xs">
            <div class="px-4 py-2.5 bg-slate-50 border-b border-slate-200 flex items-center justify-between text-xs font-semibold text-slate-600">
              <span>Dojangs certificados</span>
              <span id="contador-escuelas-home">{escuelas.length} disponibles</span>
            </div>
            <ul
              id="lista-escuelas"
              class="list-none p-0 m-0 max-h-96 overflow-y-auto divide-y divide-slate-100"
              aria-label="Resultados de búsqueda de escuelas"
              aria-live="polite"
            >
            </ul>
            <p id="estado-escuelas" class="sr-only" role="status" aria-live="polite"></p>
          </div>
        </div>

        <!-- Mapa interactivo con Leaflet + OpenStreetMap -->
        <div class="lg:col-span-7">
          <div class="bg-white p-2 rounded-xl border border-slate-200 shadow-xs">
            <div
              id="mapa-dojangs"
              class="relative h-96 lg:h-120 rounded-lg overflow-hidden border border-slate-200 bg-slate-100 z-0"
              aria-label="Mapa interactivo de dojangs oficiales en Chile"
              data-escuelas={JSON.stringify(escuelasMapa)}
              role="region"
            >
              <button
                id="activar-mapa"
                type="button"
                aria-label="Activar navegación táctil en el mapa"
                class="absolute inset-0 z-50 flex touch-none items-center justify-center bg-slate-900/60 text-center overscroll-none lg:hidden"
              >
                <span class="text-xs font-semibold uppercase tracking-wider text-white bg-itf-red px-4 py-2 rounded-lg shadow-md">
                  Toca para explorar el mapa
                </span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Últimas noticias -->
  <section class="py-10 md:py-16 bg-white" id="noticias">
    <div class="max-w-7xl mx-auto px-5 md:px-7">
      <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-4 mb-8">
        <div>
          <h2 class="text-2xl sm:text-3xl font-bold text-slate-900">Últimas noticias</h2>
        </div>
        <a
          href="/blog"
          class="inline-flex items-center gap-2 font-mono text-xs tracking-widest uppercase text-itf-red font-semibold hover:underline"
        >
          Ver todo el blog
          <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {noticias.length > 0 ? (
          noticias.map((post) => (
            <a
              class="bg-white border border-slate-200 rounded-xl overflow-hidden shadow-xs hover:shadow-md transition-shadow"
              href={`/blog/${post.slug?.current || '#'}`}
            >
              {post.imagen && (
                <div class="aspect-video overflow-hidden">
                  <img
                    src={urlFor(post.imagen).width(600).auto('format').url()}
                    alt={`Imagen de ${post.titulo}`}
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover"
                  />
                </div>
              )}
              <div class="p-5">
                <div class="flex items-center gap-3 mb-2">
                  {post.categorias?.[0] && <Tag>{post.categorias[0]}</Tag>}
                  {post.fecha && (
                    <time class="font-mono text-xs text-slate-500" datetime={post.fecha}>
                      {new Date(post.fecha).toLocaleDateString('es-CL', { day: 'numeric', month: 'short', year: 'numeric' })}
                    </time>
                  )}
                </div>
                <h3 class="text-base md:text-lg font-bold text-slate-900 m-0">{post.titulo}</h3>
              </div>
            </a>
          ))
        ) : (
          <>
            <a class="bg-white border border-slate-200 rounded-xl overflow-hidden shadow-xs hover:shadow-md transition-shadow" href="/blog">
              <div class="aspect-video bg-cover bg-center" role="img" aria-label="Practicante realizando una técnica de defensa personal" style={`background-image:url('${img.postDefensa}');`} />
              <div class="p-5">
                <Tag variant="red">Ensayos</Tag>
                <h3 class="text-base md:text-lg font-bold text-slate-900 mt-2">Principios de la defensa personal</h3>
              </div>
            </a>
            <a class="bg-white border border-slate-200 rounded-xl overflow-hidden shadow-xs hover:shadow-md transition-shadow" href="/blog">
              <div class="aspect-video bg-cover bg-center" role="img" aria-label="Competencia de Taekwon-Do ITF" style={`background-image:url('${img.postNacional}');`} />
              <div class="p-5">
                <Tag>Noticias</Tag>
                <h3 class="text-base md:text-lg font-bold text-slate-900 mt-2">Resultados del campeonato nacional</h3>
              </div>
            </a>
          </>
        )}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import L from 'leaflet';

  const input = document.getElementById('buscar-escuela') as HTMLInputElement;
  const lista = document.getElementById('lista-escuelas') as HTMLUListElement;
  const estado = document.getElementById('estado-escuelas') as HTMLParagraphElement;
  const contenedorMapa = document.getElementById('mapa-dojangs') as HTMLElement;
  const botonActivarMapa = document.getElementById('activar-mapa') as HTMLButtonElement;
  const selectorRegion = document.getElementById('filtro-region-home') as HTMLSelectElement;
  const contadorHome = document.getElementById('contador-escuelas-home');
  const escuelas = JSON.parse(contenedorMapa?.dataset.escuelas || '[]');

  /** Cache de coordenadas geocodificadas (Nominatim) por ciudad, en localStorage. */
  const CACHE_GEO = 'fechitat:geo';
  const leerCache = (): Record<string, [number, number]> => {
    try { return JSON.parse(localStorage.getItem(CACHE_GEO) || '{}'); }
    catch { return {}; }
  };
  const guardarEnCache = (cache: Record<string, [number, number]>) => {
    try { localStorage.setItem(CACHE_GEO, JSON.stringify(cache)); } catch { /* sin storage */ }
  };

  /** Geocodifica una ciudad chilena con Nominatim (1 request/seg, sin API key). */
  async function geocodificar(ciudad: string, region = ''): Promise<[number, number] | null> {
    const cache = leerCache();
    if (cache[ciudad]) return cache[ciudad];
    try {
      const url = `https://nominatim.openstreetmap.org/search?format=json&limit=1&countrycodes=cl&accept-language=es&q=${encodeURIComponent(`${ciudad}${region ? ', ' + region : ''}`)}`;
      const resp = await fetch(url, { headers: { Accept: 'application/json' } });
      const datos = await resp.json();
      if (datos?.[0]) {
        const coord: [number, number] = [parseFloat(datos[0].lat), parseFloat(datos[0].lon)];
        cache[ciudad] = coord;
        guardarEnCache(cache);
        return coord;
      }
    } catch { /* red caída */ }
    return null;
  }

  if (input && lista && contenedorMapa) {
    const esPantallaTactil =
      window.matchMedia('(hover: none)').matches || window.matchMedia('(pointer: coarse)').matches;

    const mapa = L.map(contenedorMapa, {
      center: [-35.6751, -71.5429],
      zoom: 5,
      scrollWheelZoom: true,
      touchZoom: false,
      dragging: !esPantallaTactil,
    });

    if (esPantallaTactil && botonActivarMapa) {
      const bloquearScrollMapa = (event: TouchEvent) => event.preventDefault();
      mapa.getContainer().style.touchAction = 'none';
      contenedorMapa.classList.add('mapa-tactil-inactivo');
      contenedorMapa.addEventListener('touchmove', bloquearScrollMapa, { passive: false });
      botonActivarMapa.addEventListener('click', () => {
        contenedorMapa.classList.remove('mapa-tactil-inactivo');
        contenedorMapa.removeEventListener('touchmove', bloquearScrollMapa);
        botonActivarMapa.remove();
        mapa.getContainer().style.touchAction = 'none';
        mapa.dragging.enable();
        mapa.touchZoom.enable();
        mapa.scrollWheelZoom.enable();
      });
    } else if (botonActivarMapa) {
      botonActivarMapa.remove();
    }

    // Tiles limpios y de alto contraste de OpenStreetMap / CartoDB
    L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
      subdomains: 'abcd',
      maxZoom: 20,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> &copy; <a href="https://carto.com/attributions">CARTO</a>',
    }).addTo(mapa);

    const markers = new Map<string, { marker: L.Marker; coords: [number, number] }>();
    const tieneCoordenadas = (e: any) =>
      Number.isFinite(e.lat) && Number.isFinite(e.lng);

    const iconosDojang = new Map<string, L.DivIcon>();
    const obtenerIconoDojang = (logo: string | null) => {
      const urlLogo = logo ?? '/images/general/fechitat-logo.svg';
      const iconoExistente = iconosDojang.get(urlLogo);
      if (iconoExistente) return iconoExistente;

      const icono = L.divIcon({
        className: 'marcador-dojang',
        html: `<span class="marcador-dojang__pin"><img src="${urlLogo}" alt="" /></span>`,
        iconSize: [44, 44],
        iconAnchor: [22, 22],
        popupAnchor: [0, -22],
      });
      iconosDojang.set(urlLogo, icono);
      return icono;
    };

    const agregarMarcador = (escuela: any, coords: [number, number]) => {
      if (markers.has(escuela._id)) return;
      const popup = document.createElement('div');
      popup.className = 'text-center p-1 font-sans';
      const nombrePopup = document.createElement('strong');
      nombrePopup.className = 'block text-sm font-bold text-slate-900 leading-snug';
      nombrePopup.textContent = escuela.nombre;
      const ciudadPopup = document.createElement('span');
      ciudadPopup.className = 'block text-xs text-slate-500 mt-0.5 mb-2';
      ciudadPopup.textContent = `${escuela.ciudad ?? ''}${escuela.region ? ` · ${escuela.region}` : ''}`;
      popup.append(nombrePopup, ciudadPopup);

      if (escuela.slug) {
        const btnFicha = document.createElement('a');
        btnFicha.href = `/escuelas/${escuela.slug}`;
        btnFicha.className = 'inline-block text-xs font-semibold text-white bg-itf-red px-2.5 py-1 rounded hover:bg-itf-red-dark transition-colors';
        btnFicha.textContent = 'Ver dojang';
        popup.append(btnFicha);
      }

      const marker = L.marker(coords, { icon: obtenerIconoDojang(escuela.logo) }).addTo(mapa).bindPopup(popup);
      markers.set(escuela._id, { marker, coords });
    };

    const enfocarEscuelas = (resultados: any[]) => {
      const coordenadas = resultados
        .map((e) => markers.get(e._id)?.coords)
        .filter((coords): coords is [number, number] => Boolean(coords));
      if (coordenadas.length === 1) {
        mapa.setView(coordenadas[0], 13, { animate: false });
      } else if (coordenadas.length > 1) {
        mapa.fitBounds(coordenadas, { padding: [32, 32], maxZoom: 12, animate: false });
      }
    };

    const pintarLista = () => {
      const q = (input?.value || '').toLowerCase().trim();
      const regionFiltro = selectorRegion?.value || '';
      lista.innerHTML = '';
      let visibles = 0;
      const resultados: any[] = [];

      escuelas.forEach((e: any) => {
        const nombre = e.nombre ?? '';
        const ciudad = e.ciudad ?? '';
        const region = e.region ?? '';

        const coincideTexto = !q || nombre.toLowerCase().includes(q) || ciudad.toLowerCase().includes(q) || region.toLowerCase().includes(q);
        const coincideRegion = !regionFiltro || region === regionFiltro;

        if (!coincideTexto || !coincideRegion) return;

        resultados.push(e);
        visibles++;
        const li = document.createElement('li');
        li.className = 'p-3 hover:bg-slate-50 transition-colors flex items-center justify-between gap-3';

        const infoBtn = document.createElement('button');
        infoBtn.type = 'button';
        infoBtn.className = 'flex-1 text-left cursor-pointer bg-transparent border-none p-0 focus-visible:outline-none';

        const nombreElemento = document.createElement('span');
        nombreElemento.className = 'block text-sm font-semibold text-slate-900 hover:text-itf-red transition-colors';
        nombreElemento.textContent = nombre;

        const ubicacionElemento = document.createElement('span');
        ubicacionElemento.className = 'block text-xs text-slate-500 mt-0.5';
        ubicacionElemento.textContent = `${ciudad}${region ? ` · ${region}` : ''}`;

        infoBtn.append(nombreElemento, ubicacionElemento);
        infoBtn.addEventListener('click', () => {
          const marcador = markers.get(e._id);
          if (marcador) mapa.setView(marcador.coords, 13, { animate: false });
        });

        li.appendChild(infoBtn);

        if (e.slug) {
          const fichaLink = document.createElement('a');
          fichaLink.href = `/escuelas/${e.slug}`;
          fichaLink.className = 'text-xs font-semibold text-itf-red hover:underline whitespace-nowrap px-2.5 py-1 rounded bg-red-50 hover:bg-red-100 transition-colors';
          fichaLink.textContent = 'Ver dojang';
          li.appendChild(fichaLink);
        }

        lista.appendChild(li);
      });

      if (contadorHome) {
        contadorHome.textContent = `${visibles} disponibles`;
      }
      estado.textContent = visibles === 0 ? 'No se encontraron escuelas con ese criterio.' : `${visibles} escuelas encontradas.`;
      if (q || regionFiltro) enfocarEscuelas(resultados);
    };

    escuelas.filter(tieneCoordenadas).forEach((escuela: any) => {
      agregarMarcador(escuela, [escuela.lat, escuela.lng]);
    });

    const ciudades = [...new Set(
      escuelas
        .filter((e: any) => !tieneCoordenadas(e))
        .map((e: any) => `${e.ciudad ?? ''}|||${e.region ?? ''}`)
    )].filter((c) => c !== '|||');

    (async () => {
      for (const clave of ciudades) {
        const [ciudad, region] = (clave as string).split('|||');
        const coord = await geocodificar(ciudad, region);
        if (coord) {
          escuelas
            .filter((e: any) => !tieneCoordenadas(e) && (e.ciudad ?? '') === ciudad)
            .forEach((e: any) => agregarMarcador(e, coord));
          if (input?.value.trim() || selectorRegion?.value) pintarLista();
        }
        await new Promise((r) => setTimeout(r, 1100));
      }
    })();

    input?.addEventListener('input', pintarLista);
    selectorRegion?.addEventListener('change', pintarLista);
    pintarLista();
  }
</script>

