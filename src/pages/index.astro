  #mapa-dojangs.mapa-tactil-inactivo .leaflet-pane,
  #mapa-dojangs.mapa-tactil-inactivo .leaflet-control-container {
    pointer-events: none;
  }

  #mapa-dojangs .marcador-dojang {
    background: transparent;
    border: 0;
  }

  #mapa-dojangs .marcador-dojang__pin {
    display: block;
    width: 44px;
    height: 44px;
    overflow: hidden;
    border-radius: 50%;
    border: 2px solid white;
    background-color: white;
    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
  }

  #mapa-dojangs .marcador-dojang__pin img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  @media (max-width: 767px) {
    #mapa-dojangs .leaflet-container {
      touch-action: pan-y;
    }
  }
</style>