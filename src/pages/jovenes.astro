---
import BaseLayout from '../layouts/BaseLayout.astro';
import HangulRail from '../components/HangulRail.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Tag from '../components/Tag.astro';
import Stat from '../components/Stat.astro';
import PageHero from '../components/PageHero.astro';
import BeltBar from '../components/BeltBar.astro';
import { img } from '../lib/imagenes';

const titulo = 'Para jóvenes competidores — FECHITAT';

const riel = [
  { href: '#camino', kr: '단계', label: 'Camino de grados' },
  { href: '#seleccion', kr: '국가대표', label: 'Selección nacional' },
  { href: '#semana', kr: '일정', label: 'Semana tipo' },
];

const grados = [
  { rango: '10° – 7° Gup', nombre: 'Fundamentos', texto: 'Posturas base, primeros Tul (formas) y disciplina de dojang.' },
  { rango: '6° – 3° Gup', nombre: 'Técnica intermedia', texto: 'Combinaciones, primeras competencias locales y trabajo de combate controlado.' },
  { rango: '2° – 1° Gup', nombre: 'Preparación a Dan', texto: 'Tul avanzados, liderazgo en clase y elegibilidad para torneos nacionales.' },
  { rango: '1° Dan +', nombre: 'Cinturón negro', texto: 'Certificación ITF internacional y camino hacia instructor o selección nacional.' },
];

const semana = [
  { dias: 'Lun / Mié / Vie', variante: 'red', nombre: 'Técnica y Tul', texto: 'Trabajo de formas, precisión y examen progresivo.' },
  { dias: 'Martes / Jueves', variante: 'blue', nombre: 'Combate y táctica', texto: 'Sparring controlado, reglas de competencia y estrategia.' },
  { dias: 'Sábado', variante: 'gold', nombre: 'Preparación física', texto: 'Fuerza, velocidad y flexibilidad específica del deporte.' },
  { dias: 'Domingo', variante: 'default', nombre: 'Descanso activo', texto: 'Recuperación, movilidad y análisis de video con el instructor.' },
];
---

<BaseLayout title={titulo}>
  <HangulRail links={riel} />

  <PageHero
    title="Del cinturón blanco<br />a la selección nacional"
    crumb="Para jóvenes"
    description="Si ya entrenas y quieres llevarlo en serio: esta es la ruta técnica y competitiva que sigue todo deportista de FECHITAT."
    image={img.jovenCompetidor}
    imageAlt="Joven competidor de Taekwon-Do ITF"
    imageStyle="border-radius:2px;"
  >
    <div class="flex flex-wrap gap-3 mt-5">
      <a href="/eventos" class="inline-flex items-center gap-2 bg-red text-white font-mono text-xs tracking-widest uppercase py-3 px-5 rounded-sm transition-all duration-150 hover:bg-red-dark hover:-translate-y-px">
        Ver calendario de competencias
      </a>
    </div>
  </PageHero>

  <!-- Camino de grados -->
  <section id="camino" class="py-10 md:py-[4.4em]">
    <div class="max-w-[1180px] mx-auto px-5 md:px-7">
      <div class="flex flex-col md:flex-row items-start md:items-end justify-between gap-4 mb-6">
        <div>
          <Eyebrow>Sistema de grados ITF</Eyebrow>
          <h2>Tu camino de cinturón</h2>
        </div>
        <p class="text-text-soft text-sm md:text-base">10 Gup hasta llegar a cinturón negro, y desde ahí, los grados Dan.</p>
      </div>
      <BeltBar />
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mt-6">
        {grados.map((grado) => (
          <div class="bg-white border border-line rounded-sm overflow-hidden">
            <div class="p-4 md:p-5">
              <Eyebrow>{grado.rango}</Eyebrow>
              <h4 class="text-sm md:text-base">{grado.nombre}</h4>
              <p class="text-text-soft text-sm">{grado.texto}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Selección nacional -->
  <section class="py-10 md:py-[4.4em] bg-ink text-light" id="seleccion">
    <div class="max-w-[1180px] mx-auto px-5 md:px-7 grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center">
      <div>
        <Eyebrow>Alto rendimiento</Eyebrow>
        <h2 class="text-white">Camino a la selección nacional</h2>
        <p class="text-light-soft">
          Cada año, FECHITAT convoca clasificatorios nacionales en Poomsae (Tul)
          y Combate. Los mejores resultados definen la nómina que representa a
          Chile en campeonatos panamericanos y mundiales ITF.
        </p>
        <div class="grid grid-cols-2 gap-4 md:gap-6 mt-6">
          <Stat count={12} label="Deportistas en la nómina actual" dark />
          <Stat count={3} label="Medallas panamericanas 2018–2024" dark />
        </div>
      </div>
      <div class="bg-ink-soft border border-dark-soft rounded-sm overflow-hidden">
        <div class="p-5 md:p-6">
          <Eyebrow>Requisitos para postular</Eyebrow>
          <ul class="text-light-soft pl-5 leading-8 text-sm">
            <li>Mínimo 1° Gup vigente</li>
            <li>Dojang afiliado a FECHITAT</li>
            <li>Participación en clasificatorio nacional</li>
            <li>Certificado médico deportivo al día</li>
          </ul>
          <a href="#" class="inline-flex items-center gap-2 bg-red text-white font-mono text-xs tracking-widest uppercase py-3 px-5 rounded-sm transition-all duration-150 hover:bg-red-dark hover:-translate-y-px mt-4">
            Ver bases de la convocatoria
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Semana tipo -->
  <section id="semana" class="py-10 md:py-[4.4em]">
    <div class="max-w-[1180px] mx-auto px-5 md:px-7">
      <Eyebrow>Vida de un competidor</Eyebrow>
      <h2 class="mb-6">Semana tipo de entrenamiento</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {semana.map((dia) => (
          <div class="bg-white border border-line rounded-sm overflow-hidden">
            <div class="p-4 md:p-5">
              <Tag variant={dia.variante}>{dia.dias}</Tag>
              <h4 class="text-sm md:text-base mt-3">{dia.nombre}</h4>
              <p class="text-text-soft text-sm">{dia.texto}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-10 md:py-[4.4em] bg-white">
    <div class="max-w-[1180px] mx-auto px-5 md:px-7 flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
      <div>
        <Eyebrow>¿Vas en serio?</Eyebrow>
        <h2 class="max-w-[18ch] m-0">Habla con el director técnico de tu dojang</h2>
      </div>
      <a href="/federacion#directivos" class="inline-flex items-center gap-2 bg-ink text-white font-mono text-xs tracking-widest uppercase py-3 px-5 rounded-sm transition-all duration-150 hover:bg-black hover:-translate-y-px whitespace-nowrap">
        Ver directorio técnico
      </a>
    </div>
  </section>
</BaseLayout>
