---
// Jóvenes — sistema de grados, selección nacional y semana tipo.
import BaseLayout from '../layouts/BaseLayout.astro';
import HangulRail from '../components/HangulRail.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Tag from '../components/Tag.astro';
import Stat from '../components/Stat.astro';
import PageHero from '../components/PageHero.astro';
import BeltBar from '../components/BeltBar.astro';
import { img } from '../lib/imagenes';

const titulo = 'Para jóvenes competidores — FECHITAT';

const riel = [
  { href: '#camino', kr: '단계', label: 'Camino de grados' },
  { href: '#seleccion', kr: '국가대표', label: 'Selección nacional' },
  { href: '#semana', kr: '일정', label: 'Semana tipo' },
];

const grados = [
  { rango: '10° – 7° Gup', nombre: 'Fundamentos', texto: 'Posturas base, primeros Tul (formas) y disciplina de dojang.' },
  { rango: '6° – 3° Gup', nombre: 'Técnica intermedia', texto: 'Combinaciones, primeras competencias locales y trabajo de combate controlado.' },
  { rango: '2° – 1° Gup', nombre: 'Preparación a Dan', texto: 'Tul avanzados, liderazgo en clase y elegibilidad para torneos nacionales.' },
  { rango: '1° Dan +', nombre: 'Cinturón negro', texto: 'Certificación ITF internacional y camino hacia instructor o selección nacional.' },
];

const semana = [
  { dias: 'Lun / Mié / Vie', variante: 'red', nombre: 'Técnica y Tul', texto: 'Trabajo de formas, precisión y examen progresivo.' },
  { dias: 'Martes / Jueves', variante: 'blue', nombre: 'Combate y táctica', texto: 'Sparring controlado, reglas de competencia y estrategia.' },
  { dias: 'Sábado', variante: 'gold', nombre: 'Preparación física', texto: 'Fuerza, velocidad y flexibilidad específica del deporte.' },
  { dias: 'Domingo', variante: 'default', nombre: 'Descanso activo', texto: 'Recuperación, movilidad y análisis de video con el instructor.' },
];
---

<BaseLayout title={titulo}>
  <HangulRail links={riel} />

  <PageHero
    title="Del cinturón blanco<br />a la selección nacional"
    crumb="Para jóvenes"
    description="Si ya entrenas y quieres llevarlo en serio: esta es la ruta técnica y competitiva que sigue todo deportista de FECHITAT."
    image={img.jovenCompetidor}
    imageAlt="Joven competidor de Taekwon-Do ITF"
    imageStyle="border-radius:2px;"
  >
    <div class="flex gap-[1em] flex-wrap mt-[1.4em]">
      <a href="/eventos" class="inline-flex items-center gap-[0.5em] bg-red text-white font-mono text-[0.78rem] tracking-[0.08em] uppercase py-[0.9em] px-[1.5em] rounded-[var(--radius-sm)] cursor-pointer transition-transform duration-150 ease-[ease] hover:bg-red-dark hover:-translate-y-[1px]">Ver calendario de competencias</a>
    </div>
  </PageHero>

  <!-- Camino de grados -->
  <section id="camino" class="py-[4.4em]">
    <div class="max-w-[var(--maxw)] mx-auto px-[28px]">
      <div class="flex items-end justify-between gap-[2em] flex-wrap mb-[2em]">
        <div><Eyebrow>Sistema de grados ITF</Eyebrow><h2>Tu camino de cinturón</h2></div>
        <p>10 Gup hasta llegar a cinturón negro, y desde ahí, los grados Dan.</p>
      </div>
      <BeltBar />
      <div class="grid grid-cols-4 gap-[1.6em] mt-[1.6em] max-[900px]:grid-cols-2 max-[600px]:grid-cols-1">
        {
          grados.map((grado) => (
            <div class="bg-white border border-line rounded-[var(--radius-sm)] overflow-hidden">
              <div class="p-[1.2em_1.3em_1.4em]">
                <Eyebrow>{grado.rango}</Eyebrow>
                <h4 class="text-[1.05rem]">{grado.nombre}</h4>
                <p class="text-text-soft text-[0.88rem]">{grado.texto}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Selección nacional -->
  <section class="py-[4.4em] bg-ink text-[#e6e8ee]" id="seleccion">
    <div class="max-w-[var(--maxw)] mx-auto px-[28px] grid grid-cols-2 gap-[3em] items-center max-[900px]:grid-cols-1">
      <div>
        <Eyebrow>Alto rendimiento</Eyebrow>
        <h2 class="text-white">Camino a la selección nacional</h2>
        <p class="text-[#c9cdd6]">
          Cada año, FECHITAT convoca clasificatorios nacionales en Poomsae (Tul)
          y Combate. Los mejores resultados definen la nómina que representa a
          Chile en campeonatos panamericanos y mundiales ITF.
        </p>
        <div class="grid grid-cols-2 gap-[1.6em] mt-[1.6em]">
          <Stat count={12} label="Deportistas en la nómina actual" dark />
          <Stat count={3} label="Medallas panamericanas 2018–2024" dark />
        </div>
      </div>
      <div class="bg-[#101a2c] border-[#26365a] border rounded-[var(--radius-sm)] overflow-hidden">
        <div class="p-[1.2em_1.3em_1.4em]">
          <Eyebrow>Requisitos para postular</Eyebrow>
          <ul class="text-[#c9cdd6] pl-[1.1em] leading-8 text-[0.92rem]">
            <li>Mínimo 1° Gup vigente</li>
            <li>Dojang afiliado a FECHITAT</li>
            <li>Participación en clasificatorio nacional</li>
            <li>Certificado médico deportivo al día</li>
          </ul>
          <a href="#" class="inline-flex items-center gap-[0.5em] bg-red text-white font-mono text-[0.78rem] tracking-[0.08em] uppercase py-[0.9em] px-[1.5em] rounded-[var(--radius-sm)] cursor-pointer transition-transform duration-150 ease-[ease] hover:bg-red-dark hover:-translate-y-[1px] mt-[0.6em]">Ver bases de la convocatoria</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Semana tipo -->
  <section id="semana" class="py-[4.4em]">
    <div class="max-w-[var(--maxw)] mx-auto px-[28px]">
      <Eyebrow>Vida de un competidor</Eyebrow>
      <h2 class="mb-[1.4em]">Semana tipo de entrenamiento</h2>
      <div class="grid grid-cols-4 gap-[1.6em] max-[900px]:grid-cols-2 max-[600px]:grid-cols-1">
        {
          semana.map((dia) => (
            <div class="bg-white border border-line rounded-[var(--radius-sm)] overflow-hidden">
              <div class="p-[1.2em_1.3em_1.4em]">
                <Tag variant={dia.variante}>{dia.dias}</Tag>
                <h4 class="text-[1rem] mt-[0.7em]">{dia.nombre}</h4>
                <p class="text-text-soft text-[0.85rem]">{dia.texto}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-[4.4em] bg-white">
    <div
      class="max-w-[var(--maxw)] mx-auto px-[28px] flex justify-between items-center flex-wrap gap-[1.6em]"
    >
      <div><Eyebrow>¿Vas en serio?</Eyebrow><h2 class="max-w-[18ch] m-0">Habla con el director técnico de tu dojang</h2></div>
      <a href="/federacion#directivos" class="inline-flex items-center gap-[0.5em] bg-ink text-white font-mono text-[0.78rem] tracking-[0.08em] uppercase py-[0.9em] px-[1.5em] rounded-[var(--radius-sm)] cursor-pointer transition-transform duration-150 ease-[ease] hover:bg-black hover:-translate-y-[1px]">Ver directorio técnico</a>
    </div>
  </section>
</BaseLayout>
