---
// Páginas 2+ del blog (paginación por ruta, genera páginas estáticas).
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import BlogGrid from '../../../components/BlogGrid.astro';
import Paginacion from '../../../components/Paginacion.astro';
import { getBlogPosts, getTotalBlogPosts } from '../../../lib/sanityQueries';

export const prerender = true;
export const revalidate = 3600;

const POR_PAGINA = 12;

/** Genera las rutas /blog/pagina/2, /blog/pagina/3, … */
export async function getStaticPaths() {
  const porPagina = 12;
  const total = await getTotalBlogPosts();
  const totalPaginas = Math.max(1, Math.ceil(total / porPagina));
  return Array.from({ length: totalPaginas - 1 }, (_, i) => ({
    params: { numero: String(i + 2) },
  }));
}

const numero = Number(Astro.params.numero ?? 2);
const posts = await getBlogPosts(numero, POR_PAGINA);
const totalPosts = await getTotalBlogPosts();
const totalPaginas = Math.max(1, Math.ceil(totalPosts / POR_PAGINA));

const titulo = `Blog — Página ${numero} — FECHITAT`;
const descripcion = `Página ${numero} del blog de FECHITAT: noticias, técnica e historia del Taekwon-Do ITF en Chile.`;
---

<BaseLayout title={titulo} description={descripcion} noindex>
  <PageHero
    title="Blog"
    crumb="Blog"
    description={`Artículos del Blog de FECHITAT — página ${numero} de ${totalPaginas}.`}
  />

  <section class="py-10 md:py-16">
    <div class="max-w-7xl mx-auto px-5 md:px-7">
      <div class="mb-8">
        <p class="text-text-soft text-sm">
          Página {numero} de {totalPaginas}
        </p>
      </div>

      <BlogGrid posts={posts} />

      <Paginacion actual={numero} total={totalPaginas} base="/blog" />
    </div>
  </section>
</BaseLayout>