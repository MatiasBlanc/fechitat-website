---
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Tag from '../components/Tag.astro';
import PageHero from '../components/PageHero.astro';
import { img } from '../lib/imagenes';

const titulo = 'Blog — FECHITAT';

const posts = [
  { titulo: 'Resultados del campeonato nacional 2025', etiqueta: 'Noticias', variante: 'default', fecha: '30 ene 2025', imagen: img.postNacional, tags: 'noticias,historia' },
  { titulo: '5 deportistas chilenos destacados de 2025', etiqueta: 'Historia', variante: 'gold', fecha: '30 ene 2025', imagen: img.postHistoria, tags: 'historia' },
  { titulo: 'El Taekwon-Do ITF en Chile: una línea de tiempo', etiqueta: 'Documentos', variante: 'blue', fecha: '28 ene 2025', imagen: img.postDocumento, tags: 'documentos,historia' },
  { titulo: 'Los 11 principios del entrenamiento según el General Choi', etiqueta: 'Teoría', variante: 'red', fecha: '22 ene 2025', imagen: img.competidora, tags: 'teoria,ensayos' },
  { titulo: 'Convocatoria: selección nacional rumbo a Jesolo', etiqueta: 'Noticias', variante: 'default', fecha: '18 ene 2025', imagen: img.postConvocatoria, tags: 'noticias' },
  { titulo: 'Nuevo reglamento de exámenes de grado 2025', etiqueta: 'Documentos', variante: 'blue', fecha: '12 ene 2025', imagen: img.postReglamento, tags: 'documentos' },
];

const etiquetas = ['Todos', 'Noticias', 'Historia', 'Documentos', 'Ensayos', 'Teoría'];
const slugEtiqueta = (e) => e === 'Todos' ? 'todos' : e.toLowerCase();

const recursos = [
  {
    titulo: 'Principios del Taekwon-Do',
    descripcion: 'Repasa cortesía, integridad, perseverancia, autocontrol y espíritu indomable.',
    tipo: 'Fundamentos',
  },
  {
    titulo: 'Terminología coreana',
    descripcion: 'Aprende los nombres de las posiciones, bloqueos, golpes, patadas y desplazamientos.',
    tipo: 'Vocabulario',
  },
  {
    titulo: 'Tuls y movimientos fundamentales',
    descripcion: 'Organiza tu estudio con los conceptos técnicos que corresponden a cada etapa.',
    tipo: 'Técnica',
  },
  {
    titulo: 'Preparación para el examen',
    descripcion: 'Una lista de repaso para llegar preparado a tu próximo examen de grado.',
    tipo: 'Grados',
  },
];
---

<BaseLayout title={titulo}>
  <PageHero
    title="Blog"
    description="Historia, técnica y noticias del Taekwon-Do ITF en Chile — escrito por instructores y la propia federación."
  />

  <section class="py-10 md:py-[4.4em]">
    <div class="max-w-[1180px] mx-auto px-5 md:px-7">
      <!-- Recursos de aprendizaje para estudiantes -->
      <section id="recursos" class="bg-white text-ink border border-line rounded-sm p-5 md:p-8 mb-10">
        <Eyebrow>Documentos y guías</Eyebrow>
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-3 mb-6">
          <div>
            <h2 class="text-ink text-xl md:text-2xl">Aprende para tu próximo grado</h2>
            <p class="text-text-soft text-sm md:text-base mt-2 max-w-[60ch]">
              Material de apoyo para estudiar en casa y complementar el trabajo de tu dojang.
            </p>
          </div>
          <span class="font-mono text-[0.65rem] tracking-widest uppercase text-text-soft">Material de estudio</span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
          {recursos.map((recurso) => (
            <article class="bg-paper text-ink border border-line rounded-sm p-4 hover:border-red transition-colors duration-150">
              <span class="font-mono text-[0.65rem] tracking-widest uppercase text-red">{recurso.tipo}</span>
              <h3 class="text-ink text-sm md:text-base mt-3 mb-2">{recurso.titulo}</h3>
              <p class="text-text-soft text-sm leading-relaxed">{recurso.descripcion}</p>
            </article>
          ))}
        </div>
      </section>

      <!-- Filtro por etiquetas -->
      <div class="flex flex-wrap gap-2 mb-8" role="toolbar" aria-label="Filtrar por categoría">
        {etiquetas.map((etiqueta, i) => (
          <button
            class:list={[
              'font-mono text-xs tracking-wider uppercase border px-4 py-2 rounded-full cursor-pointer transition-all duration-150',
              i === 0
                ? 'bg-red text-white border-red'
                : 'bg-white text-ink border-line hover:bg-ink hover:text-white hover:border-ink',
            ]}
            data-tag={slugEtiqueta(etiqueta)}
            type="button"
          >
            {etiqueta}
          </button>
        ))}
      </div>

      <!-- Grilla de posts -->
      <div id="post-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {posts.map((post) => (
          <a class="bg-white border border-line rounded-sm overflow-hidden transition-transform duration-200 hover:-translate-y-1 hover:shadow-lg" href="#" data-post-tags={post.tags}>
            <div class="aspect-[16/10] bg-cover" style={`background-image:url('${post.imagen}');`}></div>
            <div class="p-4 md:p-5">
              <Tag variant={post.variante}>{post.etiqueta}</Tag>
              <h4 class="text-sm md:text-base mt-2 mb-1">{post.titulo}</h4>
              <p class="font-mono text-xs text-text-soft">{post.fecha}</p>
            </div>
          </a>
        ))}
      </div>
      <div class="text-center mt-8">
        <button class="inline-flex items-center gap-2 bg-ink text-white font-mono text-xs tracking-widest uppercase py-3 px-5 rounded-sm transition-all duration-150 hover:bg-black hover:-translate-y-px">
          Cargar más artículos
        </button>
      </div>
    </div>
  </section>

  <script>
    const pills = document.querySelectorAll('[data-tag]');
    const posts = document.querySelectorAll('[data-post-tags]');
    if (pills.length && posts.length) {
      pills.forEach((pill) => {
        pill.addEventListener('click', () => {
          pills.forEach((p) => {
            p.classList.remove('bg-red', 'text-white', 'border-red');
            p.classList.add('bg-white', 'text-ink', 'border-line');
          });
          pill.classList.remove('bg-white', 'text-ink', 'border-line');
          pill.classList.add('bg-red', 'text-white', 'border-red');
          const tag = pill.dataset.tag;
          posts.forEach((post) => {
            const tags = post.dataset.postTags?.split(',') ?? [];
            post.style.display = tag === 'todos' || tags.includes(tag) ? '' : 'none';
          });
        });
      });
    }
  </script>
</BaseLayout>
