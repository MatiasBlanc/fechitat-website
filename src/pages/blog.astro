---
import BaseLayout from '../layouts/BaseLayout.astro';
import UIcon from '../components/icons/UIcon.astro';
import PageHero from '../components/PageHero.astro';
import BlogGrid from '../components/BlogGrid.astro';
import Paginacion from '../components/Paginacion.astro';
import { getBlogPosts, getTotalBlogPosts } from '../lib/sanityQueries';

export const prerender = true;
export const revalidate = 3600; // ISR: regenerar como máximo 1 vez por hora

const POR_PAGINA = 12;

const titulo = 'Blog — FECHITAT';
const descripcion =
  'Noticias, técnica, historia y entrevistas sobre Taekwon-Do ITF en Chile, publicadas por FECHITAT.';

// Datos reales desde Sanity (página 1)
const [posts, totalPosts] = await Promise.all([
  getBlogPosts(1, POR_PAGINA),
  getTotalBlogPosts(),
]);
const totalPaginas = Math.max(1, Math.ceil(totalPosts / POR_PAGINA));

const NOMBRES_CATEGORIAS: Record<string, string> = {
  noticias: 'Noticias',
  tecnica: 'Técnica',
  entrevistas: 'Entrevistas',
  eventos: 'Eventos',
  historia: 'Historia',
};

// Etiquetas detectadas de los posts de esta página
const etiquetas = ['todos', ...new Set(posts.flatMap((p) => p.categorias ?? []))];
---

<BaseLayout title={titulo} description={descripcion}>
  <PageHero
    title="Blog"
    description="Historia, técnica y noticias del Taekwon-Do ITF en Chile — escrito por instructores y la propia federación."
  />

  <section class="py-10 md:py-16">
    <div class="max-w-7xl mx-auto px-5 md:px-7">
      <!-- Acceso a material de estudio -->
      <section id="recursos" class="bg-white text-ink border border-line rounded-sm p-5 mb-10">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
          <div>
            <h2 class="text-ink text-xl md:text-2xl m-0">Aprende para tu próximo grado</h2>
            <p class="text-text-soft text-sm md:text-base mt-2 max-w-[60ch]">
              Material de apoyo para estudiar en casa y complementar el trabajo de tu dojang. Todas las guías están reunidas en una página dedicada.
            </p>
          </div>
          <a
            href="/estudio"
            class="inline-flex items-center gap-2 bg-red text-white font-mono text-xs tracking-widest uppercase py-3 px-5 rounded-sm transition-all duration-150 hover:bg-red-dark hover:-translate-y-px flex-none"
          >
            Ver material de estudio
            <UIcon name="arrow-right" size={16} />
          </a>
        </div>
      </section>

      {
        etiquetas.length > 1 && (
          <div
            class="flex flex-wrap gap-2 mb-8"
            role="group"
            aria-label="Filtrar por categoría"
          >
            {etiquetas.map((etiqueta, i) => (
              <button
                class:list={[
                  'font-mono text-xs tracking-wider uppercase border px-4 py-2 rounded-full cursor-pointer transition-all duration-150',
                  i === 0
                    ? 'bg-red text-white border-red'
                    : 'bg-white text-ink border-line hover:bg-ink hover:text-white hover:border-ink',
                ]}
                data-tag={etiqueta}
                type="button"
              >
                {NOMBRES_CATEGORIAS[etiqueta] ?? 'Todos'}
              </button>
            ))}
          </div>
        )
      }

      <!-- Grilla de posts -->
      <div id="post-grid">
        <BlogGrid posts={posts} />
      </div>

      <Paginacion actual={1} total={totalPaginas} base="/blog" />
    </div>
  </section>

  <script>
    // Filtro client-side por categoría (sobre la página visible)
    const pills = document.querySelectorAll('[data-tag]');
    const cards = document.querySelectorAll('#post-grid [data-post-categoria]') || [];
    if (pills.length) {
      pills.forEach((pill) => {
        pill.addEventListener('click', () => {
          pills.forEach((p) => {
            p.classList.remove('bg-red', 'text-white', 'border-red');
            p.classList.add('bg-white', 'text-ink', 'border-line');
          });
          pill.classList.remove('bg-white', 'text-ink', 'border-line');
          pill.classList.add('bg-red', 'text-white', 'border-red');
          const tag = pill.dataset.tag;
          document.querySelectorAll('#post-grid li').forEach((item) => {
            const cats = (item.dataset.postCategoria ?? '').split(',');
            item.style.display = tag === 'todos' || cats.includes(tag) ? '' : 'none';
          });
        });
      });
    }
  </script>
</BaseLayout>