---
// Blog — artículos filtrables por etiqueta.
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Tag from '../components/Tag.astro';
import PageHero from '../components/PageHero.astro';
import { img } from '../lib/imagenes';

const titulo = 'Blog — FECHITAT';

const postDestacado = {
  titulo: 'Principios de la defensa personal en el Taekwon-Do tradicional',
  etiqueta: 'Destacado · Ensayos',
  variante: 'red',
  extracto:
    'Un repaso de los fundamentos de Ap Chagi, Momtong Makgi y el control mental detrás de cada técnica de autodefensa ITF.',
  fecha: '30 ene 2025 · 6 min',
  imagen: img.postDefensa,
};

const posts = [
  { titulo: 'Resultados del campeonato nacional 2025', etiqueta: 'Noticias', variante: 'default', fecha: '30 ene 2025', imagen: img.postNacional, tags: 'noticias,historia' },
  { titulo: '5 deportistas chilenos destacados de 2025', etiqueta: 'Historia', variante: 'gold', fecha: '30 ene 2025', imagen: img.postHistoria, tags: 'historia' },
  { titulo: 'El Taekwon-Do ITF en Chile: una línea de tiempo', etiqueta: 'Documentos', variante: 'blue', fecha: '28 ene 2025', imagen: img.postDocumento, tags: 'documentos,historia' },
  { titulo: 'Los 11 principios del entrenamiento según el General Choi', etiqueta: 'Teoría', variante: 'red', fecha: '22 ene 2025', imagen: img.competidora, tags: 'teoria,ensayos' },
  { titulo: 'Convocatoria: selección nacional rumbo a Jesolo', etiqueta: 'Noticias', variante: 'default', fecha: '18 ene 2025', imagen: img.postConvocatoria, tags: 'noticias' },
  { titulo: 'Nuevo reglamento de exámenes de grado 2025', etiqueta: 'Documentos', variante: 'blue', fecha: '12 ene 2025', imagen: img.postReglamento, tags: 'documentos' },
];

const etiquetas = ['Todos', 'Noticias', 'Historia', 'Documentos', 'Ensayos', 'Teoría'];
const slugEtiqueta = (etiqueta) =>
  etiqueta === 'Todos' ? 'todos' : etiqueta.toLowerCase();
---

<BaseLayout title={titulo}>
  <PageHero
    title="Blog"
    description="Historia, técnica y noticias del Taekwon-Do ITF en Chile — escrito por instructores y la propia federación."
  />

  <section class="py-[4.4em]">
    <div class="max-w-[var(--maxw)] mx-auto px-[28px]">
      <!-- Artículo destacado -->
      <a
        href="#"
        class="grid grid-cols-[1.3fr_1fr] bg-white border border-line rounded-[var(--radius-sm)] overflow-hidden mb-[2.6em] transition-transform duration-180 ease-[ease] hover:-translate-y-[3px] hover:shadow-[0_14px_28px_-14px_rgba(11,18,32,0.35)] max-[800px]:grid-cols-1"
      >
        <div class="aspect-auto bg-[linear-gradient(135deg,#26365a,#0d1524)] relative flex items-center justify-center bg-cover" style={`background-image:url('${postDestacado.imagen}');`}></div>
        <div class="flex flex-col justify-center p-[2em]">
          <Tag variant={postDestacado.variante} style="width:fit-content;">{postDestacado.etiqueta}</Tag>
          <h2 class="text-[1.7rem] mt-[0.6em] mb-[0.4em]">{postDestacado.titulo}</h2>
          <p class="text-text-soft text-[0.92rem]">{postDestacado.extracto}</p>
          <p class="font-mono text-[0.72rem] text-text-soft mt-[0.8em]">{postDestacado.fecha}</p>
        </div>
      </a>

      <!-- Filtro por etiquetas (barra horizontal) -->
      <div class="flex flex-wrap gap-[0.5em] mb-[2em]" role="toolbar" aria-label="Filtrar por categoría">
        {
          etiquetas.map((etiqueta, indice) => (
            <button
              class:list={[
                'font-mono text-[0.72rem] tracking-[0.06em] uppercase border border-line px-[1em] py-[0.5em] rounded-[20px] bg-white cursor-pointer transition-all duration-150',
                indice === 0
                  ? 'bg-ink text-white border-ink'
                  : 'hover:bg-ink hover:text-white hover:border-ink',
              ]}
              data-tag={slugEtiqueta(etiqueta)}
              type="button"
            >
              {etiqueta}
            </button>
          ))
        }
      </div>

      <!-- Grilla de posts -->
      <div id="post-grid" class="grid grid-cols-3 gap-[1.6em] max-[900px]:grid-cols-2 max-[600px]:grid-cols-1">
        {
          posts.map((post) => (
            <a class="bg-white border border-line rounded-[var(--radius-sm)] overflow-hidden transition-transform duration-180 ease-[ease] hover:-translate-y-[3px] hover:shadow-[0_14px_28px_-14px_rgba(11,18,32,0.35)]" href="#" data-post-tags={post.tags}>
              <div class="aspect-[16/10] bg-[linear-gradient(135deg,#26365a,#0d1524)] relative flex items-center justify-center bg-cover" style={`background-image:url('${post.imagen}');`}></div>
              <div class="p-[1.2em_1.3em_1.4em]">
                <Tag variant={post.variante}>{post.etiqueta}</Tag>
                <h4 class="text-[1rem] mt-[0.7em] mb-[0.4em]">{post.titulo}</h4>
                <p class="font-mono text-[0.7rem] text-text-soft">{post.fecha}</p>
              </div>
            </a>
          ))
        }
      </div>
      <div class="text-center mt-[2.4em]">
        <!-- TODO: paginación / carga incremental desde Sanity -->
        <button class="inline-flex items-center gap-[0.5em] bg-ink text-white font-mono text-[0.78rem] tracking-[0.08em] uppercase py-[0.9em] px-[1.5em] rounded-[var(--radius-sm)] cursor-pointer transition-transform duration-150 ease-[ease] hover:bg-black hover:-translate-y-[1px]">Cargar más artículos</button>
      </div>
    </div>
  </section>

  <script>
    const pills = document.querySelectorAll('.pill[data-tag]');
    const posts = document.querySelectorAll('[data-post-tags]');
    if (pills.length && posts.length) {
      pills.forEach((pill) => {
        pill.addEventListener('click', () => {
          pills.forEach((p) => p.classList.remove('active'));
          pill.classList.add('active');
          const tag = pill.dataset.tag;
          posts.forEach((post) => {
            const tags = post.dataset.postTags?.split(',') ?? [];
            post.style.display = tag === 'todos' || tags.includes(tag) ? '' : 'none';
          });
        });
      });
    }
  </script>
</BaseLayout>
