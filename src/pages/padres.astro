---
// Padres — beneficios, seguridad, FAQ, testimonios y formulario de clase de prueba.
import BaseLayout from '../layouts/BaseLayout.astro';
import HangulRail from '../components/HangulRail.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Tag from '../components/Tag.astro';
import PageHero from '../components/PageHero.astro';
import { img } from '../lib/imagenes';

const titulo = 'Para padres — FECHITAT';

const riel = [
  { href: '#beneficios', kr: '혜택', label: 'Beneficios' },
  { href: '#seguridad', kr: '안전', label: 'Seguridad' },
  { href: '#testimonios', kr: '후기', label: 'Testimonios' },
  { href: '#inscribir', kr: '등록', label: 'Inscribir' },
];

const beneficios = [
  { etiqueta: 'Disciplina', variante: 'red', texto: 'Rutinas claras y metas por cinturón que enseñan constancia dentro y fuera del dojang.' },
  { etiqueta: 'Confianza', variante: 'blue', texto: 'Cada examen superado refuerza la seguridad en sí mismos, en el tatami y en la vida diaria.' },
  { etiqueta: 'Respeto', variante: 'gold', texto: 'El saludo, la jerarquía de grados y el trabajo en pareja enseñan a respetar a otros y a sí mismos.' },
  { etiqueta: 'Condición física', variante: 'default', texto: 'Coordinación, flexibilidad y resistencia, con progresiones adecuadas a cada edad.' },
];

const testimonios = [
  { texto: '"Mi hija pasó de ser tímida a presentarse voluntaria en la escuela. El cambio se nota en su seguridad diaria, no solo en el dojang."', autor: 'Madre de alumna, 8 años' },
  { texto: '"Los instructores son exigentes pero muy pacientes. Nunca sentí que fuera un ambiente de presión, sino de aprendizaje real."', autor: 'Padre de alumno, 11 años' },
  { texto: '"Nos encantó que la federación tenga proyección internacional. Mi hijo ahora sueña con representar a Chile."', autor: 'Madre de alumno, 13 años' },
];

const faqs = [
  { pregunta: '¿A qué edad puede empezar mi hijo/a?', respuesta: 'Recibimos alumnos desde los 5 años en clases infantiles, con progresiones adaptadas a cada etapa de desarrollo.' },
  { pregunta: '¿Necesita experiencia previa?', respuesta: 'No. La mayoría de los alumnos comienza sin experiencia; el uniforme y el cinturón blanco se entregan al inscribirse.' },
  { pregunta: '¿Cuántas veces por semana se entrena?', respuesta: 'Los dojangs afiliados ofrecen entre 2 y 3 clases semanales; cada escuela define su propio horario.' },
  { pregunta: '¿Pueden competir a nivel nacional?', respuesta: 'Sí, una vez alcanzado el nivel adecuado pueden participar en el calendario nacional y, con buen desempeño, en la selección para torneos internacionales.' },
];
---

<BaseLayout title={titulo}>
  <HangulRail links={riel} />

  <PageHero
    title="Un deporte que forma<br />el carácter de tu hijo/a"
    crumb="Para padres"
    description="Más que patadas y cinturones: disciplina, respeto, autocontrol y confianza, guiados por instructores certificados en un ambiente seguro y supervisado."
    image={img.ninosClase}
    imageAlt="Niños practicando Taekwon-Do ITF"
    imageStyle="border-radius:2px;"
  >
    <div class="flex gap-[1em] flex-wrap mt-[1.4em]">
      <a href="#inscribir" class="inline-flex items-center gap-[0.5em] bg-red text-white font-mono text-[0.78rem] tracking-[0.08em] uppercase py-[0.9em] px-[1.5em] rounded-[var(--radius-sm)] cursor-pointer transition-transform duration-150 ease-[ease] hover:bg-red-dark hover:-translate-y-[1px]">Reservar clase de prueba gratis</a>
    </div>
  </PageHero>

  <!-- Beneficios -->
  <section id="beneficios" class="py-[4.4em]">
    <div class="max-w-[var(--maxw)] mx-auto px-[28px]">
      <div class="flex items-end justify-between gap-[2em] flex-wrap mb-[2em]">
        <div><Eyebrow>Por qué Taekwon-Do</Eyebrow><h2>Lo que tu hijo/a se lleva a casa</h2></div>
      </div>
      <div class="grid grid-cols-4 gap-[1.6em] max-[900px]:grid-cols-2 max-[600px]:grid-cols-1">
        {
          beneficios.map((beneficio) => (
            <div class="bg-white border border-line rounded-[var(--radius-sm)] overflow-hidden">
              <div class="p-[1.2em_1.3em_1.4em]">
                <Tag variant={beneficio.variante} style="margin-bottom:0.8em;">{beneficio.etiqueta}</Tag>
                <p class="text-text-soft text-[0.9rem]">{beneficio.texto}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Seguridad -->
  <section class="py-[4.4em] bg-white" id="seguridad">
    <div class="max-w-[var(--maxw)] mx-auto px-[28px] grid grid-cols-2 gap-[3em] items-center max-[900px]:grid-cols-1">
      <img
        src={img.instructorInfantil}
        alt="Instructor supervisando entrenamiento infantil"
        class="rounded-[var(--radius-sm)]"
      />
      <div>
        <Eyebrow>Tranquilidad para ti</Eyebrow>
        <h2>Un ambiente seguro y supervisado</h2>
        <ul class="text-text-soft pl-[1.1em] leading-8">
          <li>Instructores certificados por FECHITAT e ITF</li>
          <li>Grupos separados por edad y nivel</li>
          <li>Protecciones obligatorias en todo contacto</li>
          <li>Seguro de accidentes en clases y competencias oficiales</li>
          <li>Comunicación directa con el instructor sobre el progreso</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-[4.4em]">
    <div class="max-w-[820px] mx-auto px-[28px]">
      <Eyebrow>Preguntas frecuentes</Eyebrow>
      <h2 class="mb-[1em]">Antes de inscribir</h2>
      <div class="border-t border-line">
        {
          faqs.map((faq) => (
            <details class="py-[1.1em] border-b border-line">
              <summary class="cursor-pointer font-heading font-bold uppercase">{faq.pregunta}</summary>
              <p class="text-text-soft mt-[0.7em]">{faq.respuesta}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Testimonios -->
  <section class="py-[4.4em] bg-ink text-[#e6e8ee]" id="testimonios">
    <div class="max-w-[var(--maxw)] mx-auto px-[28px] grid grid-cols-3 gap-[1.6em] max-[900px]:grid-cols-1">
      {
        testimonios.map((testimonio) => (
          <div>
            <p class="text-[1.05rem] text-[#e6e8ee]">{testimonio.texto}</p>
            <Eyebrow>— {testimonio.autor}</Eyebrow>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Inscripción / clase de prueba -->
  <section id="inscribir" class="py-[4.4em]">
    <div class="max-w-[var(--maxw)] mx-auto px-[28px] grid grid-cols-2 gap-[3em] max-[900px]:grid-cols-1">
      <div>
        <Eyebrow>Da el primer paso</Eyebrow>
        <h2>Reserva una clase de prueba gratuita</h2>
        <p class="text-text-soft">
          Completa el formulario y te contactaremos con el dojang más cercano a
          tu domicilio para coordinar la primera clase, sin costo ni compromiso.
        </p>
      </div>
      <form class="bg-white border border-line rounded-[var(--radius-sm)] overflow-hidden p-[1.6em]" id="form-clase-prueba">
        <div class="grid grid-cols-2 gap-[1.6em] max-[600px]:grid-cols-1">
          <div class="mb-[1.1em]">
            <label for="nombre" class="block font-mono text-[0.7rem] tracking-[0.06em] uppercase text-text-soft mb-[0.5em]">Nombre del niño/a</label>
            <input id="nombre" type="text" required class="w-full border border-line bg-white p-[0.8em_0.9em] font-body text-[0.95rem] rounded-[var(--radius-sm)] focus:outline-2 focus:outline-blue focus:outline-offset-[1px]" />
          </div>
          <div class="mb-[1.1em]">
            <label for="edad" class="block font-mono text-[0.7rem] tracking-[0.06em] uppercase text-text-soft mb-[0.5em]">Edad</label>
            <input id="edad" type="number" min="4" max="17" required class="w-full border border-line bg-white p-[0.8em_0.9em] font-body text-[0.95rem] rounded-[var(--radius-sm)] focus:outline-2 focus:outline-blue focus:outline-offset-[1px]" />
          </div>
        </div>
        <div class="mb-[1.1em]">
          <label for="comuna" class="block font-mono text-[0.7rem] tracking-[0.06em] uppercase text-text-soft mb-[0.5em]">Comuna</label>
          <input id="comuna" type="text" placeholder="Ej. La Serena" class="w-full border border-line bg-white p-[0.8em_0.9em] font-body text-[0.95rem] rounded-[var(--radius-sm)] focus:outline-2 focus:outline-blue focus:outline-offset-[1px]" />
        </div>
        <div class="grid grid-cols-2 gap-[1.6em] max-[600px]:grid-cols-1">
          <div class="mb-[1.1em]">
            <label for="tel" class="block font-mono text-[0.7rem] tracking-[0.06em] uppercase text-text-soft mb-[0.5em]">Teléfono de contacto</label>
            <input id="tel" type="tel" required class="w-full border border-line bg-white p-[0.8em_0.9em] font-body text-[0.95rem] rounded-[var(--radius-sm)] focus:outline-2 focus:outline-blue focus:outline-offset-[1px]" />
          </div>
          <div class="mb-[1.1em]">
            <label for="mail" class="block font-mono text-[0.7rem] tracking-[0.06em] uppercase text-text-soft mb-[0.5em]">Correo</label>
            <input id="mail" type="email" required class="w-full border border-line bg-white p-[0.8em_0.9em] font-body text-[0.95rem] rounded-[var(--radius-sm)] focus:outline-2 focus:outline-blue focus:outline-offset-[1px]" />
          </div>
        </div>
        <button type="submit" class="inline-flex items-center gap-[0.5em] bg-red text-white font-mono text-[0.78rem] tracking-[0.08em] uppercase py-[0.9em] px-[1.5em] rounded-[var(--radius-sm)] cursor-pointer transition-transform duration-150 ease-[ease] hover:bg-red-dark hover:-translate-y-[1px] w-full justify-center">
          Solicitar clase de prueba
        </button>
      </form>
    </div>
  </section>

  <script>
    // TODO: conectar a [servicio elegido] (Formspree o function serverless).
    // Por ahora se previene el envío para no recargar la página.
    const form = document.querySelector('#form-clase-prueba');
    form?.addEventListener('submit', (evento) => {
      evento.preventDefault();
      // TODO: enviar los datos del formulario al endpoint de leads.
    });
  </script>
</BaseLayout>
