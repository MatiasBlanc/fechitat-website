---
import BaseLayout from '../layouts/BaseLayout.astro';
import HangulRail from '../components/HangulRail.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Tag from '../components/Tag.astro';
import PageHero from '../components/PageHero.astro';
import { img } from '../lib/imagenes';

const titulo = 'Para padres — FECHITAT';

const riel = [
  { href: '#beneficios', kr: '혜택', label: 'Beneficios' },
  { href: '#seguridad', kr: '안전', label: 'Seguridad' },
  { href: '#testimonios', kr: '후기', label: 'Testimonios' },
  { href: '#inscribir', kr: '등록', label: 'Inscribir' },
];

const beneficios = [
  { etiqueta: 'Disciplina', variante: 'red', texto: 'Rutinas claras y metas por cinturón que enseñan constancia dentro y fuera del dojang.' },
  { etiqueta: 'Confianza', variante: 'blue', texto: 'Cada examen superado refuerza la seguridad en sí mismos, en el tatami y en la vida diaria.' },
  { etiqueta: 'Respeto', variante: 'gold', texto: 'El saludo, la jerarquía de grados y el trabajo en pareja enseñan a respetar a otros y a sí mismos.' },
  { etiqueta: 'Condición física', variante: 'default', texto: 'Coordinación, flexibilidad y resistencia, con progresiones adecuadas a cada edad.' },
];

const testimonios = [
  { texto: '"Mi hija pasó de ser tímida a presentarse voluntaria en la escuela. El cambio se nota en su seguridad diaria, no solo en el dojang."', autor: 'Madre de alumna, 8 años' },
  { texto: '"Los instructores son exigentes pero muy pacientes. Nunca sentí que fuera un ambiente de presión, sino de aprendizaje real."', autor: 'Padre de alumno, 11 años' },
  { texto: '"Nos encantó que la federación tenga proyección internacional. Mi hijo ahora sueña con representar a Chile."', autor: 'Madre de alumno, 13 años' },
];

const faqs = [
  { pregunta: '¿A qué edad puede empezar mi hijo/a?', respuesta: 'Recibimos alumnos desde los 5 años en clases infantiles, con progresiones adaptadas a cada etapa de desarrollo.' },
  { pregunta: '¿Necesita experiencia previa?', respuesta: 'No. La mayoría de los alumnos comienza sin experiencia; el uniforme y el cinturón blanco se entregan al inscribirse.' },
  { pregunta: '¿Cuántas veces por semana se entrena?', respuesta: 'Los dojangs afiliados ofrecen entre 2 y 3 clases semanales; cada escuela define su propio horario.' },
  { pregunta: '¿Pueden competir a nivel nacional?', respuesta: 'Sí, una vez alcanzado el nivel adecuado pueden participar en el calendario nacional y, con buen desempeño, en la selección para torneos internacionales.' },
];
---

<BaseLayout title={titulo}>
  <HangulRail links={riel} />

  <PageHero
    title="Un deporte que forma<br />el carácter de tu hijo/a"
    crumb="Para padres"
    description="Más que patadas y cinturones: disciplina, respeto, autocontrol y confianza, guiados por instructores certificados en un ambiente seguro y supervisado."
    image={img.ninosClase}
    imageAlt="Niños practicando Taekwon-Do ITF"
    imageStyle="border-radius:2px;"
  >
    <div class="flex flex-wrap gap-3 mt-5">
      <a href="#inscribir" class="inline-flex items-center gap-2 bg-red text-white font-mono text-xs tracking-widest uppercase py-3 px-5 rounded-sm transition-all duration-150 hover:bg-red-dark hover:-translate-y-px">
        Reservar clase de prueba gratis
      </a>
    </div>
  </PageHero>

  <!-- Beneficios -->
  <section id="beneficios" class="py-10 md:py-[4.4em]">
    <div class="max-w-[1180px] mx-auto px-5 md:px-7">
      <div class="mb-8">
        <Eyebrow>Por qué Taekwon-Do</Eyebrow>
        <h2>Lo que tu hijo/a se lleva a casa</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {beneficios.map((b) => (
          <div class="bg-white border border-line rounded-sm overflow-hidden">
            <div class="p-4 md:p-5">
              <Tag variant={b.variante} style="margin-bottom:0.6em;">{b.etiqueta}</Tag>
              <p class="text-text-soft text-sm">{b.texto}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Seguridad -->
  <section class="py-10 md:py-[4.4em] bg-white" id="seguridad">
    <div class="max-w-[1180px] mx-auto px-5 md:px-7 grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center">
      <img
        src={img.instructorInfantil}
        alt="Instructor supervisando entrenamiento infantil"
        class="rounded-sm w-full order-2 lg:order-1"
      />
      <div class="order-1 lg:order-2">
        <Eyebrow>Tranquilidad para ti</Eyebrow>
        <h2>Un ambiente seguro y supervisado</h2>
        <ul class="text-text-soft pl-5 leading-8 text-sm md:text-base">
          <li>Instructores certificados por FECHITAT e ITF</li>
          <li>Grupos separados por edad y nivel</li>
          <li>Protecciones obligatorias en todo contacto</li>
          <li>Seguro de accidentes en clases y competencias oficiales</li>
          <li>Comunicación directa con el instructor sobre el progreso</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-10 md:py-[4.4em]">
    <div class="max-w-[820px] mx-auto px-5 md:px-7">
      <Eyebrow>Preguntas frecuentes</Eyebrow>
      <h2 class="mb-6">Antes de inscribir</h2>
      <div class="border-t border-line">
        {faqs.map((faq) => (
          <details class="py-4 border-b border-line group">
            <summary class="cursor-pointer font-heading font-bold uppercase text-sm md:text-base list-none flex justify-between items-center gap-4">
              {faq.pregunta}
              <span class="text-text-soft transition-transform duration-200 group-open:rotate-45 text-lg">+</span>
            </summary>
            <p class="text-text-soft mt-3 text-sm md:text-base">{faq.respuesta}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonios -->
  <section class="py-10 md:py-[4.4em] bg-ink text-[#e6e8ee]" id="testimonios">
    <div class="max-w-[1180px] mx-auto px-5 md:px-7 grid grid-cols-1 md:grid-cols-3 gap-8">
      {testimonios.map((t) => (
        <div>
          <p class="text-base md:text-lg text-[#e6e8ee]">{t.texto}</p>
          <Eyebrow>— {t.autor}</Eyebrow>
        </div>
      ))}
    </div>
  </section>

  <!-- Inscripción / clase de prueba -->
  <section id="inscribir" class="py-10 md:py-[4.4em]">
    <div class="max-w-[1180px] mx-auto px-5 md:px-7 grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">
      <div>
        <Eyebrow>Da el primer paso</Eyebrow>
        <h2>Reserva una clase de prueba gratuita</h2>
        <p class="text-text-soft">
          Completa el formulario y te contactaremos con el dojang más cercano a
          tu domicilio para coordinar la primera clase, sin costo ni compromiso.
        </p>
      </div>
      <form class="bg-white border border-line rounded-sm overflow-hidden p-5 md:p-6" id="form-clase-prueba">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="mb-4">
            <label for="nombre" class="block font-mono text-xs tracking-wider uppercase text-text-soft mb-2">Nombre del niño/a</label>
            <input id="nombre" type="text" required class="w-full border border-line bg-white p-3 font-body text-sm rounded-sm focus:outline-2 focus:outline-blue focus:outline-offset-[1px]" />
          </div>
          <div class="mb-4">
            <label for="edad" class="block font-mono text-xs tracking-wider uppercase text-text-soft mb-2">Edad</label>
            <input id="edad" type="number" min="4" max="17" required class="w-full border border-line bg-white p-3 font-body text-sm rounded-sm focus:outline-2 focus:outline-blue focus:outline-offset-[1px]" />
          </div>
        </div>
        <div class="mb-4">
          <label for="comuna" class="block font-mono text-xs tracking-wider uppercase text-text-soft mb-2">Comuna</label>
          <input id="comuna" type="text" placeholder="Ej. La Serena" class="w-full border border-line bg-white p-3 font-body text-sm rounded-sm focus:outline-2 focus:outline-blue focus:outline-offset-[1px]" />
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="mb-4">
            <label for="tel" class="block font-mono text-xs tracking-wider uppercase text-text-soft mb-2">Teléfono de contacto</label>
            <input id="tel" type="tel" required class="w-full border border-line bg-white p-3 font-body text-sm rounded-sm focus:outline-2 focus:outline-blue focus:outline-offset-[1px]" />
          </div>
          <div class="mb-4">
            <label for="mail" class="block font-mono text-xs tracking-wider uppercase text-text-soft mb-2">Correo</label>
            <input id="mail" type="email" required class="w-full border border-line bg-white p-3 font-body text-sm rounded-sm focus:outline-2 focus:outline-blue focus:outline-offset-[1px]" />
          </div>
        </div>
        <button type="submit" class="inline-flex items-center justify-center gap-2 bg-red text-white font-mono text-xs tracking-widest uppercase py-3 px-5 rounded-sm transition-all duration-150 hover:bg-red-dark hover:-translate-y-px w-full">
          Solicitar clase de prueba
        </button>
      </form>
    </div>
  </section>

  <script>
    const form = document.querySelector('#form-clase-prueba');
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
    });
  </script>
</BaseLayout>
