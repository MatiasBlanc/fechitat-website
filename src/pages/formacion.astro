---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/ui/Breadcrumbs.astro";
import Badge from "../components/ui/Badge.astro";
import Button from "../components/ui/Button.astro";
import Card from "../components/ui/Card.astro";
import UIcon from "../components/icons/UIcon.astro";
import { pilaresFormacion } from "../data/formacionData";
import { getMaterialEstudio } from "../lib/sanityQueries";

export const prerender = true;
export const revalidate = 3600;

const titulo = "Formación y Estudio del Taekwon-Do ITF | FECHITAT";
const descripcion =
  "Centro de formación oficial de FECHITAT: enciclopedia técnica (Tul, Sogi, Chagi, Matsogi), principios morales, programa de cinturones Gup y Dan, y reglamento de arbitraje ITF.";

const materialesSanity = await getMaterialEstudio();

const breadcrumbItems = [
  { name: "Centro de Formación", href: "/formacion" },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Formación y Estudio del Taekwon-Do ITF",
  description: descripcion,
  url: "https://fechitat.cl/formacion",
  publisher: {
    "@type": "SportsOrganization",
    name: "FECHITAT",
    url: "https://fechitat.cl",
  },
};
---

<BaseLayout title={titulo} description={descripcion} structuredData={jsonLd} breadcrumbs={breadcrumbItems}>
  <!-- Hero Section Formación -->
  <section class="bg-slate-900 text-white py-12 md:py-16 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={breadcrumbItems} class="text-slate-400 mb-6" />

      <div class="max-w-3xl">
        <Badge variant="formacion" class="mb-3">Biblioteca Marcial Oficial</Badge>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-white tracking-tight leading-tight mb-4">
          Formación y Estudio del Taekwon-Do ITF
        </h1>
        <p class="text-slate-300 text-base sm:text-lg leading-relaxed font-medium">
          El Taekwon-Do ITF es un arte marcial formativo y científico. Ponemos a disposición de alumnos, instructores y familias la doctrina filosófica, los fundamentos técnicos, la guía de exámenes y el reglamento deportivo internacional.
        </p>
      </div>
    </div>
  </section>

  <!-- Los 4 Pilares de Formación -->
  <section class="py-12 md:py-16 bg-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900">
          Los Cuatro Pilares del Conocimiento
        </h2>
        <p class="text-slate-600 text-sm sm:text-base mt-2">
          Selecciona una de las cuatro áreas fundamentales para profundizar en el estudio del arte marcial.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {pilaresFormacion.map((pilar, index) => (
          <Card
            as="article"
            hoverable
            class="p-6 md:p-8 flex flex-col justify-between h-full group border-slate-200"
          >
            <div>
              <div class="flex items-center justify-between gap-4 mb-4">
                <div class="flex items-center gap-3">
                  <span class="text-3xl p-3 bg-slate-100 rounded-xl group-hover:scale-110 transition-transform">
                    {pilar.icono}
                  </span>
                  <div>
                    <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">
                      Pilar 0{index + 1}
                    </span>
                    <Badge variant={pilar.badge} class="block mt-0.5">
                      {pilar.slug === 'tecnica' ? 'Biomecánica & Formas' : pilar.slug === 'filosofia' ? 'Doctrina & Moral' : pilar.slug === 'grados' ? 'Escalafón & Exámenes' : 'Arbitraje & Normativa'}
                    </Badge>
                  </div>
                </div>
                <span class="text-xs font-medium text-slate-500 bg-slate-100 px-2.5 py-1 rounded-md">
                  {pilar.tiempoLectura}
                </span>
              </div>

              <h3 class="text-xl sm:text-2xl font-bold text-slate-900 group-hover:text-itf-red transition-colors leading-snug mb-2">
                <a href={`/formacion/${pilar.slug}`}>
                  {pilar.titulo}
                </a>
              </h3>

              <p class="text-slate-600 text-sm leading-relaxed mb-6">
                {pilar.extracto}
              </p>

              <!-- Lista de temas incluidos -->
              <div class="bg-slate-50 p-4 rounded-xl border border-slate-100 mb-6">
                <p class="text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
                  Temas centrales:
                </p>
                <ul class="space-y-1.5 text-xs text-slate-600">
                  {pilar.secciones.slice(0, 3).map((sec) => (
                    <li class="flex items-center gap-2">
                      <span class="w-1.5 h-1.5 rounded-full bg-itf-blue"></span>
                      <span>{sec.titulo}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="pt-4 border-t border-slate-100 flex items-center justify-between gap-4">
              <a
                href={`/formacion/${pilar.slug}`}
                class="inline-flex items-center gap-1.5 text-sm font-semibold text-itf-red group-hover:underline"
              >
                <span>Leer guía completa</span>
                <span aria-hidden="true">→</span>
              </a>

              <a
                href={`/formacion/${pilar.slug}#descargas`}
                class="inline-flex items-center gap-1 text-xs font-semibold text-slate-500 hover:text-slate-900"
              >
                <UIcon name="download" size={14} />
                <span>PDF de estudio</span>
              </a>
            </div>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <!-- Biblioteca de Materiales Complementarios (Sanity o Federativos) -->
  {materialesSanity && materialesSanity.length > 0 && (
    <section class="py-12 md:py-16 bg-white border-b border-slate-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
          <div>
            <Badge variant="oficial" class="mb-2">Documentación Pedagógica</Badge>
            <h2 class="text-2xl sm:text-3xl font-bold text-slate-900">
              Guías descargables de examen
            </h2>
            <p class="text-slate-600 text-sm mt-1">
              Materiales complementarios provistos por la Comisión Técnica de FECHITAT para la preparación de alumnos y docentes.
            </p>
          </div>
          <Button href="/documentos" variant="secondary" size="sm">
            Ver todos los documentos oficiales
          </Button>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {materialesSanity.map((mat: any) => (
            <Card class="p-5 flex flex-col justify-between h-full">
              <div>
                <div class="flex items-center gap-2 mb-2">
                  <Badge variant="formacion">Grado: {mat.grado || 'General'}</Badge>
                </div>
                <h3 class="text-base font-bold text-slate-900 mb-2">
                  {mat.titulo}
                </h3>
                {mat.descripcion && (
                  <p class="text-xs text-slate-600 line-clamp-2 mb-4">
                    {mat.descripcion}
                  </p>
                )}
              </div>
              {mat.archivoUrl && (
                <div class="pt-3 border-t border-slate-100">
                  <a
                    href={mat.archivoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 text-xs font-semibold text-itf-blue hover:underline"
                  >
                    <UIcon name="download" size={14} />
                    <span>Descargar {mat.archivoNombre || 'documento'}</span>
                  </a>
                </div>
              )}
            </Card>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Banner de Exámenes y Homologación -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <Badge variant="oficial" class="mb-3">Homologación Nacional e Internacional</Badge>
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-3">
        ¿Rendirás examen de grado en los próximos meses?
      </h2>
      <p class="text-slate-600 text-sm sm:text-base mb-6 max-w-2xl mx-auto leading-relaxed">
        Revisa los requisitos de asistencia y la tesis teórica requerida para tu próximo grado Gup o Dan. Todos los certificados son emitidos con folio oficial de FECHITAT e ITF.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <Button href="/formacion/grados" variant="primary" size="md">
          Ver requisitos de examen por cinturón
        </Button>
        <Button href="/escuelas" variant="secondary" size="md">
          Consultar con tu instructor
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>
