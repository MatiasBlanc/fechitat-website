---
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Tag from '../components/Tag.astro';
import EventBadge from '../components/EventBadge.astro';
import PageHero from '../components/PageHero.astro';
import UIcon from '../components/icons/UIcon.astro';
import { img } from '../lib/imagenes';
import { getProximoEventoDestacado, getProximosEventos, getEventosPasados } from '../lib/sanityQueries';
import { urlFor } from '../lib/sanity';

const titulo = 'Eventos — FECHITAT';

// Datos de Sanity
const eventoPrincipal = await getProximoEventoDestacado();
const proximos = await getProximosEventos();
const pasados = await getEventosPasados();

const colorTipo = (tipo: string) => {
  if (tipo === 'competencia') return 'red';
  if (tipo === 'examen') return 'blue';
  if (tipo === 'seminario') return 'gold';
  return 'default';
};

const labelTipo = (tipo: string) => {
  if (tipo === 'competencia') return 'Competencia';
  if (tipo === 'examen') return 'Examen';
  if (tipo === 'seminario') return 'Seminario';
  if (tipo === 'exhibicion') return 'Exhibición';
  return 'Otro';
};
---

<BaseLayout title={titulo}>
  <PageHero
    title="Eventos y competencias"
    description="Campeonatos, seminarios técnicos y exámenes de grado de FECHITAT."
  />

  <!-- Evento principal -->
  {eventoPrincipal && (
    <section class="py-10 md:py-[4.4em]">
      <div class="max-w-[1180px] mx-auto px-5 md:px-7">
        <a href={`/eventos/${eventoPrincipal.slug.current}`} class="block bg-ink rounded-sm overflow-hidden text-white transition-transform duration-200 hover:-translate-y-1 hover:shadow-xl">
          <div class="grid grid-cols-1 lg:grid-cols-[1.1fr_1fr]">
            {eventoPrincipal.flyer && (
              <div class="aspect-[16/9] lg:aspect-auto lg:min-h-[360px] bg-cover bg-center" style={`background-image:url('${urlFor(eventoPrincipal.flyer).width(800).url()}');`}></div>
            )}
            <div class="p-6 md:p-10">
              <Eyebrow>Próximo evento</Eyebrow>
              <h2 class="text-white text-[clamp(1.5rem,4vw,2.8rem)] mb-2">{eventoPrincipal.titulo}</h2>
              <div class="flex flex-wrap gap-4 font-mono text-xs tracking-wider text-light-soft">
                {eventoPrincipal.lugar && <span class="flex items-center gap-1"><UIcon name="map-pin" size={14} /> {eventoPrincipal.lugar}</span>}
                <span>{new Date(eventoPrincipal.fecha).toLocaleDateString('es-CL', {day: 'numeric', month: 'short', year: 'numeric'})}</span>
              </div>
              {eventoPrincipal.descripcion && <p class="text-text-soft mt-4 mb-6 max-w-[48ch] text-sm md:text-base">{eventoPrincipal.descripcion}</p>}
              <span class="inline-flex items-center gap-2 bg-red text-white font-mono text-xs tracking-widest uppercase py-2.5 px-5 rounded-sm">
                Ver detalle del evento
              </span>
            </div>
          </div>
        </a>
      </div>
    </section>
  )}

  <!-- Próximos eventos -->
  <section class="py-10 md:py-[4.4em] bg-white">
    <div class="max-w-[1180px] mx-auto px-5 md:px-7">
      <div class="mb-8">
        <Eyebrow>Calendario</Eyebrow>
        <h2>Próximos eventos</h2>
      </div>
      <div class="flex flex-col">
        {proximos.length > 0 ? (
          proximos.map((evento) => (
            <a href={`/eventos/${evento.slug.current}`} class="flex items-start gap-4 md:gap-6 py-5 md:py-6 border-b border-line transition-colors duration-150 hover:bg-ink/3 last:border-b-none group">
              <div class="flex-none relative z-[1]">
                <EventBadge
                  mes={new Date(evento.fecha).toLocaleDateString('es-CL', {month: 'short'}).toUpperCase()}
                  dia={new Date(evento.fecha).getDate().toString()}
                  large
                />
              </div>
              <div class="flex-1 min-w-0">
                <Tag variant={colorTipo(evento.tipo)} style="margin-bottom:0.5em;">{labelTipo(evento.tipo)}</Tag>
                <h3 class="text-base md:text-lg mb-1">{evento.titulo}</h3>
                <div class="flex gap-3 font-mono text-xs tracking-wider text-text-soft">
                  {evento.lugar && <span class="flex items-center gap-1"><UIcon name="map-pin" size={12} /> {evento.lugar}</span>}
                </div>
                {evento.descripcion && <p class="text-text-soft text-sm mt-2">{evento.descripcion}</p>}
              </div>
              <div class="self-center text-text-soft transition-all duration-150 group-hover:text-red group-hover:translate-x-1 hidden md:block">
                <UIcon name="arrow-right" size={20} />
              </div>
            </a>
          ))
        ) : (
          <p class="text-text-soft py-8">No hay eventos próximos programados.</p>
        )}
      </div>
    </div>
  </section>

  <!-- Eventos pasados -->
  {pasados.length > 0 && (
    <section class="py-10 md:py-[4.4em]">
      <div class="max-w-[1180px] mx-auto px-5 md:px-7">
        <div class="mb-8">
          <Eyebrow>Archivo</Eyebrow>
          <h2>Eventos pasados</h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {pasados.map((evento) => (
            <a href={`/eventos/${evento.slug.current}`} class="block bg-white border border-line rounded-sm overflow-hidden transition-transform duration-200 hover:-translate-y-1 hover:shadow-lg">
              {evento.flyer && (
                <div class="aspect-[16/10] bg-cover" style={`background-image:url('${urlFor(evento.flyer).width(400).url()}');`}></div>
              )}
              <div class="p-4 md:p-5">
                <Tag>{new Date(evento.fecha).getFullYear()}</Tag>
                <h4 class="text-sm md:text-base mt-2 mb-1">{evento.titulo}</h4>
                {evento.lugar && (
                  <p class="text-text-soft text-sm">
                    <UIcon name="map-pin" size={12} /> {evento.lugar}
                  </p>
                )}
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
