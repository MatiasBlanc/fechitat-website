---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/ui/Breadcrumbs.astro";
import Badge from "../components/ui/Badge.astro";
import Button from "../components/ui/Button.astro";
import Card from "../components/ui/Card.astro";
import UIcon from "../components/icons/UIcon.astro";
import EventBadge from "../components/EventBadge.astro";
import { getEventos } from "../lib/sanityQueries";
import { urlFor } from "../lib/sanity";

export const prerender = true;
export const revalidate = 3600;

const titulo = "Campeonatos y Eventos de Taekwon-Do ITF | FECHITAT";
const descripcion =
  "Calendario oficial de campeonatos nacionales, torneos internacionales, seminarios técnicos y mesas de examen de grado de la Federación Chilena de Taekwon-Do Tradicional.";

const eventos = await getEventos();

// Clasificar eventos por estado
const ahora = new Date();
const eventosConEstado = eventos.map((e: any) => {
  const fechaEvento = new Date(e.fecha);
  let estadoCalculado = e.estado || "proximo";
  if (e.estado === "en_curso") {
    estadoCalculado = "en_curso";
  } else if (fechaEvento < ahora && estadoCalculado !== "en_curso") {
    estadoCalculado = "finalizado";
  }
  return {
    ...e,
    estadoFinal: estadoCalculado,
  };
});

const proximosCount = eventosConEstado.filter((e: any) => e.estadoFinal === "proximo").length;
const enCursoCount = eventosConEstado.filter((e: any) => e.estadoFinal === "en_curso").length;
const finalizadosCount = eventosConEstado.filter((e: any) => e.estadoFinal === "finalizado").length;

const breadcrumbItems = [
  { name: "Competición y Eventos", href: "/eventos" },
];

const jsonLdEventos = {
  "@context": "https://schema.org",
  "@graph": eventosConEstado.map((evento: any) => ({
    "@type": "SportsEvent",
    name: evento.titulo,
    startDate: evento.fecha,
    ...(evento.fechaFin ? { endDate: evento.fechaFin } : {}),
    ...(evento.flyer ? { image: urlFor(evento.flyer).width(1200).url() } : {}),
    description: evento.descripcion ?? `Evento oficial ${evento.titulo} de FECHITAT`,
    eventStatus: evento.estadoFinal === "finalizado"
      ? "https://schema.org/EventMovedOnline"
      : "https://schema.org/EventScheduled",
    location: {
      "@type": "Place",
      name: evento.lugar ?? evento.ciudad ?? "Chile",
      address: {
        "@type": "PostalAddress",
        addressLocality: evento.ciudad ?? "Chile",
        addressCountry: "CL",
      },
    },
    organizer: {
      "@type": "SportsOrganization",
      name: "FECHITAT",
      url: "https://fechitat.cl",
    },
  })),
};

const labelTipo = (tipo: string) => {
  if (tipo === "competencia") return "Campeonato";
  if (tipo === "examen") return "Examen de Grado";
  if (tipo === "seminario") return "Seminario Técnico";
  if (tipo === "exhibicion") return "Exhibición";
  return "Actividad Oficial";
};
---

<BaseLayout title={titulo} description={descripcion} structuredData={jsonLdEventos} breadcrumbs={breadcrumbItems}>
  <!-- Hero Section Eventos -->
  <section class="bg-slate-900 text-white py-12 md:py-16 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={breadcrumbItems} class="text-slate-400 mb-6" />

      <div class="max-w-3xl">
        <Badge variant="campeonato" class="mb-3">Circuito Nacional e Internacional</Badge>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-white tracking-tight leading-tight mb-4">
          Campeonatos y Eventos de Taekwon-Do ITF
        </h1>
        <p class="text-slate-300 text-base sm:text-lg leading-relaxed font-medium">
          Calendario competitivo de FECHITAT: torneos zonales, campeonatos nacionales, pesajes reglamentarios, cursos técnicos de jueces y el calendario de la Selección Chilena de Taekwon-Do ITF.
        </p>
      </div>
    </div>
  </section>

  <!-- Pestañas de Estado & Filtros de Tipo -->
  <section class="bg-white border-b border-slate-200 sticky top-16 z-30 shadow-xs" aria-label="Filtros de estado de campeonatos">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 py-3">
        <!-- Tabs de Estado (Todos, Próximos, En Curso, Finalizados) -->
        <div class="flex items-center gap-1.5 overflow-x-auto py-1" role="tablist" aria-label="Filtrar por estado del evento">
          <button
            type="button"
            class="tab-estado px-3.5 py-1.5 text-xs font-semibold rounded-lg transition-colors cursor-pointer bg-itf-blue text-white"
            data-estado="todos"
            role="tab"
            aria-selected="true"
          >
            Todos ({eventosConEstado.length})
          </button>
          <button
            type="button"
            class="tab-estado px-3.5 py-1.5 text-xs font-semibold rounded-lg transition-colors cursor-pointer bg-slate-100 text-slate-700 hover:bg-slate-200"
            data-estado="proximo"
            role="tab"
            aria-selected="false"
          >
            Próximos ({proximosCount})
          </button>
          <button
            type="button"
            class="tab-estado px-3.5 py-1.5 text-xs font-semibold rounded-lg transition-colors cursor-pointer bg-slate-100 text-slate-700 hover:bg-slate-200"
            data-estado="en_curso"
            role="tab"
            aria-selected="false"
          >
            En Curso ({enCursoCount})
          </button>
          <button
            type="button"
            class="tab-estado px-3.5 py-1.5 text-xs font-semibold rounded-lg transition-colors cursor-pointer bg-slate-100 text-slate-700 hover:bg-slate-200"
            data-estado="finalizado"
            role="tab"
            aria-selected="false"
          >
            Finalizados ({finalizadosCount})
          </button>
        </div>

        <!-- Filtro por tipo de evento -->
        <div class="flex items-center gap-2">
          <label for="select-tipo" class="text-xs font-semibold text-slate-600 whitespace-nowrap">Tipo:</label>
          <select
            id="select-tipo"
            class="border border-slate-300 bg-slate-50 focus:bg-white text-xs font-semibold text-slate-800 rounded-lg px-2.5 py-1.5 focus-visible:outline-2 focus-visible:outline-itf-blue cursor-pointer"
          >
            <option value="todos">Todos los tipos</option>
            <option value="competencia">Campeonatos y Torneos</option>
            <option value="seminario">Seminarios Técnicos</option>
            <option value="examen">Exámenes de Grado</option>
          </select>
        </div>
      </div>
    </div>
  </section>

  <!-- Listado de Campeonatos y Eventos -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div id="grid-eventos" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {eventosConEstado.map((evento: any) => {
          const fechaObj = new Date(evento.fecha);
          const mes = fechaObj.toLocaleDateString("es-CL", { month: "short" }).toUpperCase();
          const dia = fechaObj.getDate().toString();
          const anio = fechaObj.getFullYear();
          const slug = evento.slug?.current;
          const hrefDetalle = slug ? `/eventos/${slug}` : null;
          const flyerUrl = evento.flyer ? urlFor(evento.flyer).width(800).height(450).auto("format").url() : null;

          return (
            <Card
              as="article"
              hoverable
              class="evento-card flex flex-col justify-between h-full group"
              data-estado={evento.estadoFinal}
              data-tipo={evento.tipo || "otro"}
            >
              <div>
                <!-- Flyer / Cover -->
                {flyerUrl ? (
                  <div class="aspect-video overflow-hidden bg-slate-100 relative">
                    <img
                      src={flyerUrl}
                      alt={`Afiche de ${evento.titulo}`}
                      loading="lazy"
                      decoding="async"
                      class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                    />
                    <div class="absolute top-3 right-3">
                      {evento.estadoFinal === "proximo" && (
                        <Badge variant="campeonato" class="shadow-xs">Próximo</Badge>
                      )}
                      {evento.estadoFinal === "en_curso" && (
                        <Badge variant="noticia" class="shadow-xs animate-pulse">En Curso</Badge>
                      )}
                      {evento.estadoFinal === "finalizado" && (
                        <Badge variant="evento" class="shadow-xs">Finalizado</Badge>
                      )}
                    </div>
                  </div>
                ) : (
                  <div class="h-24 bg-gradient-to-r from-itf-blue to-slate-900 p-4 flex items-center justify-between">
                    <span class="text-white/80 font-bold text-xs tracking-wider uppercase">{labelTipo(evento.tipo)}</span>
                    {evento.estadoFinal === "proximo" && (
                      <Badge variant="campeonato" class="shadow-xs">Próximo</Badge>
                    )}
                    {evento.estadoFinal === "en_curso" && (
                      <Badge variant="noticia" class="shadow-xs animate-pulse">En Curso</Badge>
                    )}
                    {evento.estadoFinal === "finalizado" && (
                      <Badge variant="evento" class="shadow-xs">Finalizado</Badge>
                    )}
                  </div>
                )}

                <!-- Contenido del Evento -->
                <div class="p-6">
                  <div class="flex items-start gap-4 mb-4">
                    <EventBadge mes={mes} dia={dia} large />
                    <div class="min-w-0">
                      <span class="text-xs font-bold text-itf-blue uppercase tracking-wider block mb-0.5">
                        {labelTipo(evento.tipo)} · {anio}
                      </span>
                      <h2 class="text-lg font-bold text-slate-900 group-hover:text-itf-red transition-colors leading-snug m-0">
                        {hrefDetalle ? (
                          <a href={hrefDetalle}>{evento.titulo}</a>
                        ) : (
                          evento.titulo
                        )}
                      </h2>
                    </div>
                  </div>

                  <div class="space-y-2 text-xs text-slate-600 mb-4">
                    {evento.lugar && (
                      <p class="flex items-center gap-2 font-medium">
                        <span class="text-itf-red"><UIcon name="map-pin" size={14} /></span>
                        <span>{evento.lugar}</span>
                      </p>
                    )}
                    {evento.ciudad && !evento.lugar?.includes(evento.ciudad) && (
                      <p class="text-slate-500 pl-5">
                        {evento.ciudad}, Chile
                      </p>
                    )}
                  </div>

                  {evento.descripcion && (
                    <p class="text-xs text-slate-600 line-clamp-2 leading-relaxed mb-4">
                      {evento.descripcion}
                    </p>
                  )}
                </div>
              </div>

              <!-- Footer / CTA -->
              <div class="p-6 pt-0 border-t border-slate-100 mt-auto flex items-center gap-2">
                {hrefDetalle ? (
                  <Button
                    href={hrefDetalle}
                    variant={evento.estadoFinal === "proximo" ? "primary" : "secondary"}
                    size="sm"
                    class="w-full justify-center"
                  >
                    {evento.estadoFinal === "finalizado" ? "Ver resultados y fotos" : "Ver bases e inscripción"}
                  </Button>
                ) : (
                  <span class="text-xs text-slate-400 font-medium py-1.5">Información próximamente</span>
                )}
              </div>
            </Card>
          );
        })}
      </div>

      <!-- Sin resultados en filtro -->
      <div id="sin-eventos" class="hidden py-16 text-center max-w-md mx-auto">
        <div class="w-16 h-16 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center text-2xl mx-auto mb-4">
          🏆
        </div>
        <h2 class="text-xl font-bold text-slate-900 mb-2">No hay eventos en esta categoría</h2>
        <p class="text-slate-600 text-sm mb-6">
          No existen torneos o actividades que coincidan con la combinación de filtros seleccionada.
        </p>
        <button
          id="btn-reset-eventos"
          type="button"
          class="inline-flex items-center gap-2 px-4 py-2 bg-itf-blue text-white text-sm font-semibold rounded-lg hover:bg-slate-900 transition-colors cursor-pointer"
        >
          Ver todos los eventos
        </button>
      </div>
    </div>
  </section>

  <!-- CTA para anfitriones de torneos -->
  <section class="py-12 md:py-16 bg-white border-t border-slate-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <Badge variant="campeonato" class="mb-3">Reglamentación y Arbitraje</Badge>
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-3">
        Reglamentos Oficiales de Competición ITF
      </h2>
      <p class="text-slate-600 text-sm sm:text-base mb-6 max-w-2xl mx-auto leading-relaxed">
        Todos los campeonatos organizados y patrocinados por FECHITAT se rigen bajo el reglamento oficial de combate y formas de la International Taekwon-Do Federation.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <Button href="/formacion#competicion" variant="primary" size="md">
          Consultar reglamento oficial ITF
        </Button>
        <Button href="/documentos" variant="secondary" size="md">
          Ver circulares de competición
        </Button>
      </div>
    </div>
  </section>

  <script>
    const tabs = document.querySelectorAll<HTMLButtonElement>('.tab-estado');
    const selectTipo = document.getElementById('select-tipo') as HTMLSelectElement;
    const cards = document.querySelectorAll<HTMLElement>('.evento-card');
    const sinEventos = document.getElementById('sin-eventos');
    const grid = document.getElementById('grid-eventos');
    const btnReset = document.getElementById('btn-reset-eventos');

    let estadoActivo = 'todos';

    function filtrarEventos() {
      const tipoActivo = selectTipo?.value || 'todos';
      let visibles = 0;

      cards.forEach((card) => {
        const estadoCard = card.dataset.estado || '';
        const tipoCard = card.dataset.tipo || '';

        const coincideEstado = estadoActivo === 'todos' || estadoCard === estadoActivo;
        const coincideTipo = tipoActivo === 'todos' || tipoCard === tipoActivo;

        if (coincideEstado && coincideTipo) {
          card.style.display = '';
          visibles++;
        } else {
          card.style.display = 'none';
        }
      });

      if (sinEventos && grid) {
        if (visibles === 0) {
          sinEventos.classList.remove('hidden');
          grid.classList.add('hidden');
        } else {
          sinEventos.classList.add('hidden');
          grid.classList.remove('hidden');
        }
      }
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        estadoActivo = tab.dataset.estado || 'todos';

        tabs.forEach((t) => {
          const esActivo = t === tab;
          t.setAttribute('aria-selected', esActivo ? 'true' : 'false');
          if (esActivo) {
            t.classList.remove('bg-slate-100', 'text-slate-700', 'hover:bg-slate-200');
            t.classList.add('bg-itf-blue', 'text-white');
          } else {
            t.classList.remove('bg-itf-blue', 'text-white');
            t.classList.add('bg-slate-100', 'text-slate-700', 'hover:bg-slate-200');
          }
        });

        filtrarEventos();
      });
    });

    selectTipo?.addEventListener('change', filtrarEventos);

    btnReset?.addEventListener('click', () => {
      estadoActivo = 'todos';
      if (selectTipo) selectTipo.value = 'todos';
      tabs[0]?.click();
    });
  </script>
</BaseLayout>