---
import EventBadge from "../components/EventBadge.astro";
import PageHero from "../components/PageHero.astro";
import Tag from "../components/Tag.astro";
import UIcon from "../components/icons/UIcon.astro";
import Button from "../components/ui/Button.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { urlFor } from "../lib/sanity";
import {
  getEventosPasados,
  getProximoEventoDestacado,
  getProximosEventos,
} from "../lib/sanityQueries";

const titulo = "Eventos — FECHITAT";

// Datos de Sanity
const eventoPrincipal = await getProximoEventoDestacado();
const proximosRaw = await getProximosEventos();
// Excluir el evento destacado de la lista de próximos
const proximos = eventoPrincipal
  ? proximosRaw.filter((e) => e._id !== eventoPrincipal._id)
  : proximosRaw;
const pasados = await getEventosPasados();

const labelTipo = (tipo: string) => {
  if (tipo === "competencia") return "Competencia";
  if (tipo === "examen") return "Examen";
  if (tipo === "seminario") return "Seminario";
  if (tipo === "exhibicion") return "Exhibición";
  return "Otro";
};

/**
 * Determina si un evento tiene contenido suficiente para abrir su detalle.
 *
 * @param evento - Evento recibido desde Sanity.
 * @returns true cuando tiene descripción o una galería con fotos.
 */
const puedeAbrirEvento = (evento) =>
  Boolean(evento.descripcion || evento.galeria?.length || evento.tieneGaleria);
---

<BaseLayout title={titulo}>
  <PageHero
    title="Eventos y competencias"
    description="Campeonatos, seminarios técnicos y exámenes de grado de FECHITAT."
  />

  <!-- Calendario: próximo evento destacado + próximos eventos -->
  <section class="py-10 md:py-16">
    <div class="max-w-7xl mx-auto px-5 md:px-7">
      {
        eventoPrincipal && (
          <a
            href={
              puedeAbrirEvento(eventoPrincipal)
                ? `/eventos/${eventoPrincipal.slug.current}`
                : undefined
            }
            aria-disabled={
              !puedeAbrirEvento(eventoPrincipal) ? "true" : undefined
            }
            class:list={[
              "block bg-white border border-line rounded-sm overflow-hidden text-ink transition-transform duration-200",
              puedeAbrirEvento(eventoPrincipal)
                ? "hover:-translate-y-1 hover:shadow-xl"
                : "cursor-default",
            ]}
          >
            <div class="grid grid-cols-1 lg:grid-cols-[1.1fr_1fr]">
              {eventoPrincipal.flyer && (
                <div
                  class="aspect-[16/9] lg:aspect-auto lg:min-h-96 bg-cover bg-center"
                  style={`background-image:url('${urlFor(eventoPrincipal.flyer).width(800).url()}');`}
                />
              )}
              <div class="p-6 md:p-10">
                <span class="font-mono text-xs tracking-wider uppercase text-red">
                  Próximo evento
                </span>
                <h2 class="text-ink text-[clamp(1.5rem,4vw,2.8rem)] mb-4">{eventoPrincipal.titulo}</h2>
                <div class="flex flex-wrap gap-4 font-mono text-xs tracking-wider text-text-soft mb-6">
                  {eventoPrincipal.lugar && <span class="flex items-center gap-1"><UIcon name="map-pin" size={14} /> {eventoPrincipal.lugar}</span>}
                  <span>{new Date(eventoPrincipal.fecha).toLocaleDateString('es-CL', {day: 'numeric', month: 'short', year: 'numeric'})}</span>
                </div>
                {eventoPrincipal.descripcion && <p class="text-text-soft mt-4 mb-6 max-w-[48ch] text-sm md:text-base">{eventoPrincipal.descripcion}</p>}
                <span class="inline-flex items-center gap-2 bg-red text-white font-mono text-xs tracking-widest uppercase py-2.5 px-5 rounded-sm">
                  Ver detalle del evento
                </span>
              </div>
            </div>
          </a>
        )
      }

      <div class="mt-10 mb-8">
        <h2>Próximos eventos</h2>
      </div>

      {
        proximos.length > 0 ? (
          <div class="flex flex-col mt-8">
            {proximos.map((evento) => (
              <a
                href={
                  puedeAbrirEvento(evento)
                    ? `/eventos/${evento.slug.current}`
                    : undefined
                }
                aria-disabled={!puedeAbrirEvento(evento) ? "true" : undefined}
                class:list={[
                  "flex items-start gap-4 md:gap-6 py-5 md:py-6 border-b border-line transition-colors duration-150 group",
                  puedeAbrirEvento(evento)
                    ? "hover:bg-ink/3"
                    : "cursor-default",
                ]}
              >
                <div class="flex-none relative z-[1]">
                  <EventBadge
                    mes={new Date(evento.fecha)
                      .toLocaleDateString("es-CL", { month: "short" })
                      .toUpperCase()}
                    dia={new Date(evento.fecha).getDate().toString()}
                    large
                  />
                </div>
                <div class="flex-1 min-w-0">
                  <span class="font-mono text-xs tracking-wider uppercase text-text-soft">{labelTipo(evento.tipo)}</span>
                  <h3 class="text-base md:text-lg mb-1">{evento.titulo}</h3>
                  <div class="flex gap-3 font-mono text-xs tracking-wider text-text-soft">
                    {evento.lugar && <span class="flex items-center gap-1"><UIcon name="map-pin" size={12} /> {evento.lugar}</span>}
                  </div>
                  {evento.descripcion && <p class="text-text-soft text-sm mt-2">{evento.descripcion}</p>}
                </div>
                <div class="self-center text-text-soft transition-all duration-150 group-hover:text-red group-hover:translate-x-1 hidden md:block">
                  <UIcon name="arrow-right" size={20} />
                </div>
              </a>
            ))}
          </div>
        ) : (
          <p class="text-text-soft py-8">
            No hay eventos próximos programados.
          </p>
        )
      }
    </div>
  </section>

  <!-- Eventos pasados -->
  {
    pasados.length > 0 && (
      <section class="py-10 md:py-16">
        <div class="max-w-7xl mx-auto px-5 md:px-7">
          <div class="mb-8">
            <h2>Eventos pasados</h2>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {pasados.map((evento) => (
              <a
                href={
                  puedeAbrirEvento(evento)
                    ? `/eventos/${evento.slug.current}`
                    : undefined
                }
                aria-disabled={!puedeAbrirEvento(evento) ? "true" : undefined}
                class:list={[
                  "block bg-white border border-line rounded-sm overflow-hidden transition-transform duration-200",
                  puedeAbrirEvento(evento)
                    ? "hover:-translate-y-1 hover:shadow-lg"
                    : "cursor-default",
                ]}
              >
                {evento.flyer && (
                  <div
                    class="aspect-[16/10] bg-cover"
                    style={`background-image:url('${urlFor(evento.flyer).width(400).url()}');`}
                  />
                )}
                <div class="p-4 md:p-5">
                  <h4 class="text-sm md:text-base mb-1">
                    {evento.titulo}
                  </h4>
                  <div class="flex items-center gap-2 text-text-soft text-sm">
                    <span>
                      {new Date(evento.fecha).toLocaleDateString('es-CL', { day: 'numeric', month: 'short' })}
                    </span>
                    {evento.lugar && (
                      <>
                        <span>·</span>
                        <span class="flex items-center gap-1">
                          <UIcon name="map-pin" size={12} />
                          {evento.lugar}
                        </span>
                      </>
                    )}
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
