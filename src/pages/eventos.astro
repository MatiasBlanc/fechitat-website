---
// Eventos — agenda de campeonatos, seminarios y exámenes de grado.
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Tag from '../components/Tag.astro';
import EventBadge from '../components/EventBadge.astro';
import PageHero from '../components/PageHero.astro';
import UIcon from '../components/icons/UIcon.astro';
import { img } from '../lib/imagenes';

const titulo = 'Eventos — FECHITAT';

const eventoPrincipal = {
  mes: 'OCT',
  dia: '03',
  nombre: 'XVIII Campeonato Mundial ITF',
  sede: 'Jesolo, Italia',
  detalle: 'Poomsae y combate · Delegación nacional confirmada',
  imagen: img.heroTkd,
};

const proximos = [
  { mes: '2026', dia: 'PAN', nombre: 'Panamericano ITF 2026', sede: 'Sede por confirmar', detalle: 'Clasificatorio nacional en marzo', tipo: 'Competencia' },
  { mes: 'NOV', dia: '15', nombre: 'Examen nacional de grado', sede: 'Santiago, Chile', detalle: 'Todos los niveles · Inscripción a través de tu dojang', tipo: 'Examen' },
  { mes: 'DIC', dia: '07', nombre: 'Seminario técnico nacional', sede: 'La Serena, Chile', detalle: 'Con instructores invitados de ITF', tipo: 'Seminario' },
];

const pasados = [
  { anio: '2024', nombre: 'Campeonato Nacional Absoluto', sede: 'Santiago', imagen: img.eventoNacional },
  { anio: '2024', nombre: 'Seminario técnico con el Maestro Rojas', sede: 'La Serena', imagen: img.seminario },
  { anio: '2023', nombre: 'Panamericano ITF', sede: 'Montevideo, Uruguay', imagen: img.postDocumento },
];

const colorTipo = (tipo) => {
  if (tipo === 'Competencia') return 'red';
  if (tipo === 'Examen') return 'blue';
  if (tipo === 'Seminario') return 'gold';
  return 'default';
};
---

<BaseLayout title={titulo}>
  <PageHero
    title="Eventos y competencias"
    description="Campeonatos, seminarios técnicos y exámenes de grado de FECHITAT."
  />

  <!-- Evento principal -->
  <section class="py-[4.4em]">
    <div class="max-w-[var(--maxw)] mx-auto px-[28px]">
      <a href="#" class="grid grid-cols-[1.1fr_1fr] bg-ink rounded-[var(--radius-sm)] overflow-hidden text-white transition-transform duration-200 ease-[ease] hover:-translate-y-[3px] hover:shadow-[0_18px_36px_-14px_rgba(11,18,32,0.45)] max-[800px]:grid-cols-1">
        <div class="min-h-[360px] bg-cover bg-center max-[800px]:min-h-[220px]" style={`background-image:url('${eventoPrincipal.imagen}');`}></div>
        <div class="p-[2.8em] flex flex-col justify-center max-[800px]:p-[2em]">
          <Eyebrow>Próximo evento</Eyebrow>
          <h2 class="text-white text-[clamp(1.8rem,4vw,2.8rem)] mb-[0.3em]">{eventoPrincipal.nombre}</h2>
          <div class="flex gap-[1.6em] font-mono text-[0.78rem] tracking-[0.04em] text-[#c9cdd6]">
            <span class="flex items-center gap-[0.4em]"><UIcon name="map-pin" size={16} /> {eventoPrincipal.sede}</span>
            <span>{eventoPrincipal.mes} {eventoPrincipal.dia}</span>
          </div>
          <p class="text-text-soft mt-[1em] mb-[1.4em] max-w-[48ch]">{eventoPrincipal.detalle}</p>
          <span class="inline-flex items-center gap-[0.5em] bg-red text-white font-mono text-[0.78rem] tracking-[0.08em] uppercase py-[0.9em] px-[1.5em] rounded-[var(--radius-sm)]">Ver detalle del evento</span>
        </div>
      </a>
    </div>
  </section>

  <!-- Próximos eventos -->
  <section class="py-[4.4em] bg-white">
    <div class="max-w-[var(--maxw)] mx-auto px-[28px]">
      <div class="flex items-end justify-between gap-[2em] flex-wrap mb-[2em]">
        <div><Eyebrow>Calendario</Eyebrow><h2>Próximos eventos</h2></div>
      </div>
      <div class="flex flex-col relative">
        <div class="absolute left-[38px] top-0 bottom-0 w-[2px] bg-line max-[600px]:left-[28px]"></div>
        {
          proximos.map((evento) => (
            <a href="#" class="flex items-start gap-[1.6em] py-[1.6em] border-b border-line text-inherit transition-bg duration-150 ease-[ease] hover:bg-ink/3 last:border-b-none max-[600px]:gap-[1em]">
              <div class="flex-none relative z-[1]">
                <EventBadge mes={evento.mes} dia={evento.dia} large />
              </div>
              <div class="flex-1 min-w-0">
                <Tag variant={colorTipo(evento.tipo)} style="margin-bottom:0.6em;">{evento.tipo}</Tag>
                <h3 class="text-[1.2rem] mb-[0.2em]">{evento.nombre}</h3>
                <div class="flex gap-[1em] font-mono text-[0.76rem] tracking-[0.04em] text-text-soft">
                  <span class="flex items-center gap-[0.3em]"><UIcon name="map-pin" size={14} /> {evento.sede}</span>
                </div>
                <p class="text-text-soft text-[0.88rem] mt-[0.5em]">{evento.detalle}</p>
              </div>
              <div class="self-center text-text-soft transition-all duration-150 ease-[ease] hover:text-red hover:translate-x-[3px]">
                <UIcon name="arrow-right" size={20} />
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Eventos pasados -->
  <section class="py-[4.4em]">
    <div class="max-w-[var(--maxw)] mx-auto px-[28px]">
      <div class="flex items-end justify-between gap-[2em] flex-wrap mb-[2em]">
        <div><Eyebrow>Archivo</Eyebrow><h2>Eventos pasados</h2></div>
      </div>
      <div class="grid grid-cols-3 gap-[1.6em] max-[900px]:grid-cols-2 max-[600px]:grid-cols-1">
        {
          pasados.map((evento) => (
            <div class="bg-white border border-line rounded-[var(--radius-sm)] overflow-hidden transition-transform duration-180 ease-[ease] hover:-translate-y-[3px] hover:shadow-[0_14px_28px_-14px_rgba(11,18,32,0.35)]">
              <div class="aspect-[16/10] bg-[linear-gradient(135deg,#26365a,#0d1524)] relative flex items-center justify-center bg-cover" style={`background-image:url('${evento.imagen}');`}></div>
              <div class="p-[1.2em_1.3em_1.4em]">
                <Tag>{evento.anio}</Tag>
                <h4 class="text-[1rem] mt-[0.6em] mb-[0.2em]">{evento.nombre}</h4>
                <p class="text-text-soft text-[0.85rem] m-0">
                  <UIcon name="map-pin" size={13} /> {evento.sede}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
