---
import BaseLayout from '../layouts/BaseLayout.astro';
import HangulRail from '../components/HangulRail.astro';
import PageHero from '../components/PageHero.astro';
import BeltBar from '../components/BeltBar.astro';
import Timeline from '../components/Timeline.astro';
import Button from '../components/ui/Button.astro';
import { img } from '../lib/imagenes';
import { getOrganigrama, getComisiones, getCampeones, getHitoHistorico } from '../lib/sanityQueries';
import { urlFor } from '../lib/sanity';

export const prerender = true;
export const revalidate = 3600;

const titulo = 'Sobre FECHITAT — Federación de Taekwon-Do ITF';
const descripcion =
  'Conoce FECHITAT, la federación chilena de Taekwon-Do ITF: historia, directiva, campeones y escuelas afiliadas.';

const riel = [
  { href: '#quienes', kr: '소개', label: 'Quiénes somos' },
  { href: '#historia', kr: '역사', label: 'Historia' },
  { href: '#directivos', kr: '임원', label: 'Directivos' },
  { href: '#comisiones', kr: '위원회', label: 'Comisiones' },
  { href: '#documentos', kr: '문서', label: 'Documentos' },
  { href: '#campeones', kr: '챔피언', label: 'Campeones' },
  { href: '#afiliacion', kr: '가입', label: 'Afiliación' },
];

// Obtener datos de Sanity
const [directivos, comisiones, campeones, hitos] = await Promise.all([
  getOrganigrama(),
  getComisiones(),
  getCampeones(),
  getHitoHistorico(),
]);
---

<BaseLayout title={titulo} description={descripcion}>
  <HangulRail links={riel} />

  <PageHero
    title="Sobre FECHITAT"
    crumb="FECHITAT"
    description="FECHITAT es la organización que representa oficialmente al Taekwon-Do ITF Original en Chile, reuniendo dojangs, instructores y practicantes de todo el país."
  />

  <!-- Quiénes somos -->
  <section id="quienes" class="py-10 md:py-16">
    <div class="max-w-7xl mx-auto px-5 md:px-7 grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center">
      <div>
        <h2>Más que una federación, una familia</h2>
        <p class="text-text-soft">
          FECHITAT agrupa dojangs de todo Chile bajo un mismo sello: el
          Taekwon-Do ITF Original. Cinturones certificados por la ITF,
          competencias nacionales e internacionales y una comunidad que crece
          año a año.
        </p>
        <p class="text-text-soft">
          Detrás de cada técnica hay una filosofía — disciplina, respeto,
          superación — que nuestros instructores transmiten en cada clase,
          dentro y fuera del dojang.
        </p>
      </div>
      <img
        src="/images/hero/OIP.webp"
        alt="Equipo nacional de Taekwon-Do ITF junto a la bandera de Chile"
        class="rounded-sm w-full"
      />
    </div>
  </section>

  <!-- Línea de tiempo -->
  {hitos.length > 0 && (
    <section class="py-10 md:py-16" id="historia">
      <div class="max-w-7xl mx-auto px-5 md:px-7">
        <h2 class="mb-6">Línea de tiempo de la federación</h2>
      </div>
      <div class="max-w-7xl mx-auto px-5 md:px-7">
        <Timeline hitos={hitos} />
      </div>
    </section>
  )}

  <!-- Directorio -->
  {directivos.length > 0 && (
    <section id="directivos" class="py-10 md:py-16">
      <div class="max-w-7xl mx-auto px-5 md:px-7">
        <h2 class="mb-6">Directorio</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-5">
          {directivos.map((d) => (
            <div class="bg-white border border-line rounded-sm overflow-hidden">
              <div class="text-center">
                {/* Foto o iniciales */}
                <div>
                  {d.foto ? (
                    <img
                      src={urlFor(d.foto).width(240).height(300).url()}
                      alt={d.nombre}
                      class="w-full aspect-[4/5] object-cover"
                    />
                  ) : (
                    <div class="w-full aspect-[4/5] bg-ink text-white flex items-center justify-center font-heading font-extrabold text-3xl">
                      {d.nombre.split(' ').map((n: string) => n[0]).join('')}
                    </div>
                  )}
                </div>

                {/* Info */}
                <div class="px-4 pb-5 pt-3">
                  <h3 class="text-base md:text-lg mb-1">{d.nombre}</h3>
                  <p class="text-red font-mono text-xs tracking-wider uppercase mb-1">{d.cargo}</p>
                  {d.grado && <p class="text-text-soft text-xs mb-4">{d.grado}</p>}

                  {/* Botón de contacto */}
                  {d.email && (
                    <Button href={`mailto:${d.email}`} variant="dark-ghost" size="sm">
                      Contactar
                    </Button>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Comisiones -->
  {comisiones.length > 0 && (
    <section id="comisiones" class="py-10 md:py-16 bg-paper">
      <div class="max-w-7xl mx-auto px-5 md:px-7">
        <div class="mb-8">
          <h2>Comisiones</h2>
          <p class="text-text-soft max-w-[65ch] mt-2">
            Equipos de trabajo que apoyan la gestión y el funcionamiento de FECHITAT.
          </p>
        </div>

        <div class="space-y-6">
          {comisiones.map((comision) => (
            <article class="bg-white border border-line rounded-sm p-5 md:p-6">
              <h3 class="text-xl mb-2">{comision.nombre}</h3>
              {comision.descripcion && <p class="text-text-soft text-sm mb-5">{comision.descripcion}</p>}
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                {comision.miembros?.map((miembro) => (
                  <div class="border-t-2 border-red pt-3">
                    <div class="flex items-center gap-3">
                      {miembro.foto ? (
                        <img
                          src={urlFor(miembro.foto).width(96).height(96).url()}
                          alt={miembro.nombre}
                          class="w-12 h-12 rounded-full object-cover flex-none"
                        />
                      ) : (
                        <div class="w-12 h-12 rounded-full bg-ink text-white flex items-center justify-center font-heading font-extrabold text-sm flex-none">
                          {miembro.nombre.split(' ').map((n: string) => n[0]).join('')}
                        </div>
                      )}
                      <div>
                        <h4 class="text-base m-0">{miembro.nombre}</h4>
                        {miembro.grado && <p class="text-red font-mono text-xs tracking-wider uppercase mt-1">{miembro.grado}</p>}
                      </div>
                    </div>
                    {miembro.email && (
                      <Button href={`mailto:${miembro.email}`} variant="dark-ghost" size="sm" class="mt-3">
                        Contactar
                      </Button>
                    )}
                  </div>
                ))}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Documentos oficiales -->
  <section id="documentos" class="py-10 md:py-14">
    <div class="max-w-7xl mx-auto px-5 md:px-7">
      <div class="bg-ink text-white rounded-sm p-6 md:p-8 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
        <div>
          <span class="font-mono text-xs tracking-widest uppercase text-red">Información institucional</span>
          <h2 class="text-white text-2xl md:text-3xl mt-2">Documentos oficiales</h2>
          <p class="text-light-soft text-sm max-w-[58ch] mt-2">
            Consulta los protocolos, reglamentos, estatutos y comunicados publicados por FECHITAT.
          </p>
        </div>
        <Button href="/federacion/documentos" variant="primary" size="md" class="self-start md:self-center">
          Ver documentos
        </Button>
      </div>
    </div>
  </section>

  <!-- Salón de campeones -->
  {campeones.length > 0 && (
    <section class="py-10 md:py-16 bg-ink text-light" id="campeones">
      <div class="max-w-7xl mx-auto px-5 md:px-7">
        <div class="mb-8">
          <h2 class="text-white">Maestros que marcaron escuela</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {campeones.map((c) => (
            <div class="flex gap-4 items-center py-4 border-b border-white/10">
              {c.foto ? (
                <img
                  src={urlFor(c.foto).width(128).height(128).url()}
                  alt={c.nombre}
                  class="w-14 h-14 md:w-16 md:h-16 rounded-full object-cover flex-none"
                />
              ) : (
                <div class="w-14 h-14 md:w-16 md:h-16 rounded-full bg-red text-white flex items-center justify-center font-heading font-extrabold text-lg flex-none">
                  {c.nombre.split(' ').map((n: string) => n[0]).join('')}
                </div>
              )}
              <div>
                <span class="font-mono text-xs tracking-wider uppercase text-light-muted">{c.grado}{c.titulo ? ` · ${c.titulo}` : ''}</span>
                <h3 class="text-white text-sm md:text-base m-0">{c.nombre}</h3>
                {c.competencia && <p class="text-white/60 text-xs mt-1">{c.competencia} {c.anio}</p>}
              </div>
            </div>
          ))}
        </div>
        <div class="text-center mt-8">
          <Button href="#" variant="primary" size="md">
            Conocer más maestros
          </Button>
        </div>
      </div>
    </section>
  )}

  <!-- Beneficios de afiliación -->
  <section id="afiliacion" class="py-10 md:py-16">
    <div class="max-w-7xl mx-auto px-5 md:px-7">
      <div>
        <h2>Por qué ser parte de FECHITAT</h2>
        <p class="text-text-soft">
          Al afiliar tu escuela a la federación, tus alumnos acceden a exámenes
          de grado reconocidos por ITF, seguro deportivo en competencias
          oficiales y la posibilidad de representar a Chile en torneos
          panamericanos y mundiales.
        </p>
        <ul class="text-text-soft pl-5 leading-8 text-sm md:text-base">
          <li>Presencia activa a nivel internacional</li>
          <li>Certificación oficial de grados y cinturones negros</li>
          <li>Acceso a seminarios técnicos con maestros invitados</li>
          <li>Cobertura en el calendario nacional de competencias</li>
        </ul>
        <Button href="#" variant="secondary" size="md" class="mt-4">
          Afiliar mi escuela
        </Button>
      </div>

    </div>
  </section>

</BaseLayout>
