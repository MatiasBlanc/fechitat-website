---
import BaseLayout from '../layouts/BaseLayout.astro';
import HangulRail from '../components/HangulRail.astro';
import PageHero from '../components/PageHero.astro';
import BeltBar from '../components/BeltBar.astro';
import Timeline from '../components/Timeline.astro';
import Button from '../components/ui/Button.astro';
import { img } from '../lib/imagenes';
import { getOrganigrama, getCampeones, getHitoHistorico, getEscuelasPorRegion } from '../lib/sanityQueries';
import { urlFor } from '../lib/sanity';

const titulo = 'La Federación — FECHITAT';

const riel = [
  { href: '#historia', kr: '역사', label: 'Historia' },
  { href: '#directivos', kr: '임원', label: 'Directivos' },
  { href: '#campeones', kr: '챔피언', label: 'Campeones' },
  { href: '#escuelas', kr: '도장', label: 'Escuelas' },
];

// Obtener datos de Sanity
const directivos = await getOrganigrama();
const campeones = await getCampeones();
const hitos = await getHitoHistorico();
const escuelas = await getEscuelasPorRegion();
const escuelasPorRegion = escuelas.reduce((acc: any, escuela: any) => {
  const region = escuela.region || 'Sin región';
  (acc[region] = acc[region] || []).push(escuela);
  return acc;
}, {} as Record<string, any[]>);
const regiones = Object.keys(escuelasPorRegion).sort();
---

<BaseLayout title={titulo}>
  <HangulRail links={riel} />

  <PageHero
    title="La Federación"
    crumb="Federación"
    description="FECHITAT es la organización que representa oficialmente al Taekwon-Do ITF Original en Chile, reuniendo dojangs, instructores y practicantes de todo el país."
  />

  <!-- Quiénes somos -->
  <section id="quienes" class="py-10 md:py-16">
    <div class="max-w-7xl mx-auto px-5 md:px-7 grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center">
      <div>
        <h2>Más que una federación, una familia</h2>
        <p class="text-text-soft">
          FECHITAT agrupa dojangs de todo Chile bajo un mismo sello: el
          Taekwon-Do ITF Original. Cinturones certificados por la ITF,
          competencias nacionales e internacionales y una comunidad que crece
          año a año.
        </p>
        <p class="text-text-soft">
          Detrás de cada técnica hay una filosofía — disciplina, respeto,
          superación — que nuestros instructores transmiten en cada clase,
          dentro y fuera del dojang.
        </p>
      </div>
      <img
        src="/images/hero/OIP.webp"
        alt="Equipo nacional de Taekwon-Do ITF junto a la bandera de Chile"
        class="rounded-sm w-full"
      />
    </div>
  </section>

  <!-- Línea de tiempo -->
  {hitos.length > 0 && (
    <section class="py-10 md:py-16" id="historia">
      <div class="max-w-7xl mx-auto px-5 md:px-7">
        <h2 class="mb-6">Línea de tiempo de la federación</h2>
      </div>
      <div class="max-w-7xl mx-auto px-5 md:px-7">
        <Timeline hitos={hitos} />
      </div>
    </section>
  )}

  <!-- Directorio -->
  {directivos.length > 0 && (
    <section id="directivos" class="py-10 md:py-16">
      <div class="max-w-7xl mx-auto px-5 md:px-7">
        <h2 class="mb-6">Directorio</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-5">
          {directivos.map((d) => (
            <div class="bg-white border border-line rounded-sm overflow-hidden">
              <div class="text-center">
                {/* Foto o iniciales */}
                <div>
                  {d.foto ? (
                    <img
                      src={urlFor(d.foto).width(240).height(300).url()}
                      alt={d.nombre}
                      class="w-full aspect-[4/5] object-cover"
                    />
                  ) : (
                    <div class="w-full aspect-[4/5] bg-ink text-white flex items-center justify-center font-heading font-extrabold text-3xl">
                      {d.nombre.split(' ').map((n: string) => n[0]).join('')}
                    </div>
                  )}
                </div>

                {/* Info */}
                <div class="px-4 pb-5 pt-3">
                  <h4 class="text-base md:text-lg mb-1">{d.nombre}</h4>
                  <p class="text-red font-mono text-xs tracking-wider uppercase mb-4">{d.cargo}</p>

                  {/* Botón de contacto */}
                  {d.email && (
                    <Button href={`mailto:${d.email}`} variant="dark-ghost" size="sm">
                      Contactar
                    </Button>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Salón de campeones -->
  {campeones.length > 0 && (
    <section class="py-10 md:py-16 bg-ink text-light" id="campeones">
      <div class="max-w-7xl mx-auto px-5 md:px-7">
        <div class="mb-8">
          <h2 class="text-white">Maestros que marcaron escuela</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {campeones.map((c) => (
            <div class="flex gap-4 items-center py-4 border-b border-white/10">
              {c.foto ? (
                <img
                  src={urlFor(c.foto).width(128).height(128).url()}
                  alt={c.nombre}
                  class="w-14 h-14 md:w-16 md:h-16 rounded-full object-cover flex-none"
                />
              ) : (
                <div class="w-14 h-14 md:w-16 md:h-16 rounded-full bg-red text-white flex items-center justify-center font-heading font-extrabold text-lg flex-none">
                  {c.nombre.split(' ').map((n: string) => n[0]).join('')}
                </div>
              )}
              <div>
                <span class="font-mono text-xs tracking-wider uppercase text-light-muted">{c.grado}{c.titulo ? ` · ${c.titulo}` : ''}</span>
                <h4 class="text-white text-sm md:text-base m-0">{c.nombre}</h4>
                {c.competencia && <p class="text-white/60 text-xs mt-1">{c.competencia} {c.anio}</p>}
              </div>
            </div>
          ))}
        </div>
        <div class="text-center mt-8">
          <Button href="#" variant="primary" size="md">
            Conocer más maestros
          </Button>
        </div>
      </div>
    </section>
  )}

  <!-- Beneficios de afiliación -->
  <section id="afiliacion" class="py-10 md:py-16">
    <div class="max-w-7xl mx-auto px-5 md:px-7">
      <div>
        <h2>Por qué ser parte de FECHITAT</h2>
        <p class="text-text-soft">
          Al afiliar tu escuela a la federación, tus alumnos acceden a exámenes
          de grado reconocidos por ITF, seguro deportivo en competencias
          oficiales y la posibilidad de representar a Chile en torneos
          panamericanos y mundiales.
        </p>
        <ul class="text-text-soft pl-5 leading-8 text-sm md:text-base">
          <li>Presencia activa a nivel internacional</li>
          <li>Certificación oficial de grados y cinturones negros</li>
          <li>Acceso a seminarios técnicos con maestros invitados</li>
          <li>Cobertura en el calendario nacional de competencias</li>
        </ul>
        <Button href="#" variant="secondary" size="md" class="mt-4">
          Afiliar mi escuela
        </Button>
      </div>

    </div>
  </section>

  <!-- Escuelas afiliadas -->
  {regiones.length > 0 && (
    <section class="py-10 md:py-16" id="escuelas">
      <div class="max-w-7xl mx-auto px-5 md:px-7">
        <div class="mb-10">
          <h2>Escuelas afiliadas</h2>
          <p class="text-text-soft text-sm md:text-base max-w-[60ch] mt-2">
            Red de dojangs de FECHITAT a lo largo de Chile. Cada escuela está
            dirigida por un instructor certificado por la ITF.
          </p>
        </div>

        <div class="space-y-10">
          {regiones.map((region) => (
            <div>
              <div class="flex items-center gap-3 mb-4">
                <h3 class="text-base md:text-lg m-0">{region}</h3>
                <span class="font-mono text-xs text-text-soft">({escuelasPorRegion[region].length})</span>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                {escuelasPorRegion[region].map((escuela: any) => (
                  <div class="escuela-card bg-white border border-line rounded-sm overflow-hidden">
                    {escuela.foto && (
                      <div
                        class="aspect-[16/9] bg-cover bg-center"
                        style={`background-image:url('${urlFor(escuela.foto).width(500).url()}');`}
                      />
                    )}
                    <div class="p-5">
                      <div class="flex items-center gap-3 mb-3">
                        {escuela.logo && (
                          <img
                            src={urlFor(escuela.logo).width(80).height(80).url()}
                            alt={escuela.nombre}
                            class="w-12 h-12 object-contain rounded-sm flex-none bg-paper"
                          />
                        )}
                        <div>
                          <h4 class="text-base md:text-lg m-0">{escuela.nombre}</h4>
                          {escuela.sensei && (
                            <p class="text-text-soft text-xs flex items-center gap-1">
                              Instructor: {escuela.sensei}
                            </p>
                          )}
                        </div>
                      </div>
                      {(escuela.direccion || escuela.ciudad) && (
                        <p class="text-text-soft text-sm mb-4">{[escuela.direccion, escuela.ciudad].filter(Boolean).join(', ')}</p>
                      )}
                      <div class="flex flex-wrap gap-2 border-t border-line pt-4">
                        {escuela.email && (
                          <a href={`mailto:${escuela.email}`} class="inline-flex items-center gap-1.5 font-mono text-xs tracking-wider uppercase border border-line px-3 py-1.5 rounded-sm">
                            Email
                          </a>
                        )}
                        {escuela.whatsapp && (
                          <a href={`https://wa.me/${escuela.whatsapp}`} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 font-mono text-xs tracking-wider uppercase border border-line px-3 py-1.5 rounded-sm">
                            WhatsApp
                          </a>
                        )}
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}


</BaseLayout>
