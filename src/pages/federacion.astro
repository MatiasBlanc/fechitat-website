---
// Federación — historia, directorio, salón de campeones y afiliación.
import BaseLayout from '../layouts/BaseLayout.astro';
import HangulRail from '../components/HangulRail.astro';
import Eyebrow from '../components/Eyebrow.astro';
import PageHero from '../components/PageHero.astro';
import BeltBar from '../components/BeltBar.astro';
import { img } from '../lib/imagenes';

const titulo = 'La Federación — FECHITAT';

const riel = [
  { href: '#quienes', kr: '우리', label: 'Quiénes somos' },
  { href: '#historia', kr: '역사', label: 'Historia' },
  { href: '#directivos', kr: '임원', label: 'Directivos' },
  { href: '#campeones', kr: '챔피언', label: 'Campeones' },
  { href: '#afiliacion', kr: '가입', label: 'Afiliación' },
];

const directivos = [
  { iniciales: 'JB', nombre: 'Juan Bravo', cargo: 'Presidente', email: 'presidencia@fechitat.cl', color: '' },
  { iniciales: 'CS', nombre: 'Camila Soto', cargo: 'Vicepresidenta', email: 'vicepresidencia@fechitat.cl', color: '#c4161c' },
  { iniciales: 'RM', nombre: 'Rodrigo Muñoz', cargo: 'Secretario general', email: 'secretaria@fechitat.cl', color: '#b08d57' },
  { iniciales: 'DT', nombre: 'Daniela Toro', cargo: 'Directora técnica', email: 'tecnica@fechitat.cl', color: '#274b85' },
];

const campeones = [
  { iniciales: 'OR', nombre: 'Osvaldo Rojas', grado: 'Sahyun Nim · 7° Dan', color: '#c4161c' },
  { iniciales: 'ER', nombre: 'Ernesto Reyes', grado: 'Sahyun Nim · 7° Dan', color: '#274b85' },
  { iniciales: 'JL', nombre: 'Javier Lillo', grado: 'Sabum Nim · 6° Dan', color: '#b08d57' },
  { iniciales: 'MR', nombre: 'Marcelo Russo', grado: 'Sabum Nim · 6° Dan', color: '#3f8f4f' },
];

const hitos = [
  { anio: '2005', tituloHito: 'Primeros dojangs ITF', texto: 'Sabum Nim pioneros comienzan a enseñar Taekwon-Do ITF en la IV Región.' },
  { anio: '2011', tituloHito: 'Se constituye la Federación', texto: 'Osvaldo Rojas, Ernesto Reyes y Javier Lillo respaldan la creación de FECHITAT con personalidad jurídica.' },
  { anio: '2013', tituloHito: 'Se une Sabumnim Marcelo Russo', texto: 'Sus escuelas de la IV Región se integran, ampliando la red nacional.' },
  { anio: '2018', tituloHito: 'Primer podio panamericano', texto: 'La selección nacional obtiene sus primeras medallas internacionales.' },
  { anio: '2025', tituloHito: 'Rumbo a Jesolo', texto: '+150 competidores activos y delegación confirmada al Mundial ITF.', ultimo: true },
];
---

<BaseLayout title={titulo}>
  <HangulRail links={riel} />

  <PageHero
    title="La Federación"
    crumb="Federación"
    description="FECHITAT es la organización que representa oficialmente al Taekwon-Do ITF Original en Chile, reuniendo dojangs, instructores y practicantes de todo el país."
  />

  <!-- Quiénes somos -->
  <section id="quienes" class="py-[4.4em]">
    <div class="max-w-[var(--maxw)] mx-auto px-[28px] grid grid-cols-2 gap-[3em] items-center max-[900px]:grid-cols-1">
      <div>
        <Eyebrow>Quiénes somos</Eyebrow>
        <h2>Una organización nacional con vocación internacional</h2>
        <p class="text-text-soft">
          Reunimos a los dojangs, instructores y practicantes del país para
          promover la enseñanza del Taekwon-Do ITF Original, preservando su
          técnica y filosofía tradicional mientras proyectamos a nuestros
          deportistas a competencias mundiales.
        </p>
        <p class="text-text-soft">
          Trabajamos junto a Sabum Nim e instituciones deportivas para formar
          no solo competidores, sino personas con disciplina, respeto y
          autocontrol dentro y fuera del dojang.
        </p>
      </div>
      <img
        src={img.equipoNacional}
        alt="Equipo nacional de Taekwon-Do ITF junto a la bandera de Chile"
        class="rounded-[var(--radius-sm)]"
      />
    </div>
  </section>

  <!-- Línea de tiempo -->
  <section class="py-[4.4em] bg-white" id="historia">
    <div class="max-w-[var(--maxw)] mx-auto px-[28px]">
      <Eyebrow>Nuestra historia</Eyebrow>
      <h2 class="mb-[1.4em]">Línea de tiempo de la federación</h2>
    </div>
    <div class="timeline-track overflow-x-auto cursor-grab px-[28px] pb-[1em]">
      <div class="flex gap-0 min-w-[1100px] max-w-[var(--maxw)] mx-auto relative">
        <div class="absolute top-[27px] left-0 right-0 h-[2px] bg-line"></div>
        {
          hitos.map((hito) => (
            <div class="flex-1 relative pt-[2.6em]">
              <div
                class:list={[
                  'absolute top-[20px] left-0 w-[14px] h-[14px] rounded-full border-[3px] border-white shadow-[0_0_0_1px_var(--color-line)]',
                  hito.ultimo ? 'bg-ink' : 'bg-red',
                ]}
              ></div>
              <Eyebrow>{hito.anio}</Eyebrow>
              <h4 class="text-[1rem]">{hito.tituloHito}</h4>
              <p class="text-[0.88rem] text-text-soft max-w-[22ch]">{hito.texto}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Directorio -->
  <section id="directivos" class="py-[4.4em]">
    <div class="max-w-[var(--maxw)] mx-auto px-[28px]">
      <Eyebrow>Quiénes lideran</Eyebrow>
      <h2 class="mb-[1.2em]">Directorio</h2>
      <div class="grid grid-cols-4 gap-[1.6em] max-[900px]:grid-cols-2 max-[600px]:grid-cols-1">
        {
          directivos.map((directivo) => (
            <div class="bg-white border border-line rounded-[var(--radius-sm)] overflow-hidden">
              <div class="p-[1.2em_1.3em_1.4em] text-center">
                <div
                  class="w-[64px] h-[64px] rounded-full bg-blue text-white flex items-center justify-center font-heading font-extrabold text-[1.3rem] mx-auto mb-[0.8em]"
                  style={directivo.color ? `background:${directivo.color};` : undefined}
                >
                  {directivo.iniciales}
                </div>
                <h4 class="text-[1.02rem]">{directivo.nombre}</h4>
                <p class="text-text-soft text-[0.85rem] m-0 mb-[0.8em]">{directivo.cargo}</p>
                <a
                  href={`mailto:${directivo.email}`}
                  class="font-mono text-[0.72rem] tracking-[0.06em] uppercase border border-line px-[1em] py-[0.5em] rounded-[20px] bg-white cursor-pointer transition-all duration-150 hover:bg-ink hover:text-white hover:border-ink"
                >Contactar</a>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Salón de campeones -->
  <section class="py-[4.4em] bg-ink text-[#e6e8ee]" id="campeones">
    <div class="max-w-[var(--maxw)] mx-auto px-[28px]">
      <div class="flex items-end justify-between gap-[2em] flex-wrap mb-[2em]">
        <div><Eyebrow>Salón de campeones</Eyebrow><h2 class="text-white">Maestros que marcaron escuela</h2></div>
      </div>
      <div class="grid grid-cols-2 gap-[1.6em] max-[900px]:grid-cols-1">
        {
          campeones.map((campeon) => (
            <div class="flex gap-[1em] items-center py-[1em] border-b border-white/10">
              <div
                class="w-[64px] h-[64px] rounded-full bg-blue text-white flex items-center justify-center font-heading font-extrabold text-[1.3rem] flex-none"
                style={`background:${campeon.color};`}
              >
                {campeon.iniciales}
              </div>
              <div>
                <Eyebrow>{campeon.grado}</Eyebrow>
                <h4 class="text-white text-[1.05rem] m-0">{campeon.nombre}</h4>
              </div>
            </div>
          ))
        }
      </div>
      <div class="text-center mt-[2em]">
        <a href="#" class="inline-flex items-center gap-[0.5em] bg-red text-white font-mono text-[0.78rem] tracking-[0.08em] uppercase py-[0.9em] px-[1.5em] rounded-[var(--radius-sm)] cursor-pointer transition-transform duration-150 ease-[ease] hover:bg-red-dark hover:-translate-y-[1px]">Conocer más maestros</a>
      </div>
    </div>
  </section>

  <!-- Beneficios de afiliación -->
  <section id="afiliacion" class="py-[4.4em]">
    <div class="max-w-[var(--maxw)] mx-auto px-[28px] grid grid-cols-2 gap-[3em] max-[900px]:grid-cols-1">
      <div>
        <Eyebrow>Beneficios de afiliación</Eyebrow>
        <h2>Por qué ser parte de FECHITAT</h2>
        <p class="text-text-soft">
          Al afiliar tu escuela a la federación, tus alumnos acceden a exámenes
          de grado reconocidos por ITF, seguro deportivo en competencias
          oficiales y la posibilidad de representar a Chile en torneos
          panamericanos y mundiales.
        </p>
        <ul class="text-text-soft pl-[1.1em] leading-8">
          <li>Presencia activa a nivel internacional</li>
          <li>Certificación oficial de grados y cinturones negros</li>
          <li>Acceso a seminarios técnicos con maestros invitados</li>
          <li>Cobertura en el calendario nacional de competencias</li>
        </ul>
        <a href="#" class="inline-flex items-center gap-[0.5em] bg-ink text-white font-mono text-[0.78rem] tracking-[0.08em] uppercase py-[0.9em] px-[1.5em] rounded-[var(--radius-sm)] cursor-pointer transition-transform duration-150 ease-[ease] hover:bg-black hover:-translate-y-[1px] mt-[0.6em]">Afiliar mi escuela</a>
      </div>
      <div class="bg-white border border-line rounded-[var(--radius-sm)] overflow-hidden">
        <div class="p-[1.2em_1.3em_1.4em]">
          <Eyebrow>ITF Affiliated</Eyebrow>
          <h3 class="text-[1.6rem]">Reconocimiento internacional garantizado</h3>
          <p class="text-text-soft text-[0.92rem]">
            Nuestros exámenes, torneos y grados son válidos ante la
            International Taekwon-Do Federation, permitiendo la movilidad de
            tus alumnos hacia cualquier país afiliado.
          </p>
          <BeltBar />
          <p class="text-[0.8rem] text-text-soft font-mono mt-[1.4em]">10° GUP → 1° DAN</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Arrastre horizontal de la línea de tiempo -->
  <script>
    const tl = document.querySelector('.timeline-track');
    if (tl) {
      let isDown = false;
      let startX = 0;
      let scrollLeft = 0;
      tl.addEventListener('mousedown', (e) => {
        isDown = true;
        startX = e.pageX - tl.offsetLeft;
        scrollLeft = tl.scrollLeft;
      });
      tl.addEventListener('mouseleave', () => { isDown = false; });
      tl.addEventListener('mouseup', () => { isDown = false; });
      tl.addEventListener('mousemove', (e) => {
        if (!isDown) return;
        e.preventDefault();
        const x = e.pageX - tl.offsetLeft;
        tl.scrollLeft = scrollLeft - (x - startX) * 1.4;
      });
    }
  </script>
</BaseLayout>
