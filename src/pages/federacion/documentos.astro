---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/ui/Button.astro';

export const prerender = true;
---

<BaseLayout title="Redirigiendo a Documentos Oficiales | FECHITAT" description="Redirigiendo al centro de documentación oficial.">
  <div class="py-24 text-center max-w-lg mx-auto px-4">
    <h1 class="text-2xl font-bold text-slate-900 mb-4">Centro de Documentación FECHITAT</h1>
    <p class="text-slate-600 mb-6">La documentación oficial se encuentra disponible en nuestro centro normativo unificado.</p>
    <Button href="/documentos" variant="primary" size="md">Ver Documentos Oficiales</Button>
  </div>
  <script>
    window.location.replace('/documentos');
  </script>
</BaseLayout>
