  },
  {
    rango: '4° a 3° Gup',
    cinturon: 'Azul a Azul Punta Roja',
    posiciones: ['Las anteriores', 'En L más corta (Dwitbal Sogi)', 'De caminar más larga (Nachuo Sogi)'],
    ataquesBrazo: ['Los anteriores', 'Con codo ascendente frontal (Wipalkup Taerigi)', 'Con puños dobles frontal (Sang Joomuk Sewo Jirugi)', 'Con puños tipo gancho a zona media (Sang Joomuk Dwijibo Jirugi)'],
    ataquesPierna: ['Los anteriores', 'Patada lateral saltando y girando 360°', 'Patada descendente hacia fuera con giro 180° saltando', 'Patada semicircular con salto y giro 360°', 'Patada abanico hacia adentro con salto y giro 360°', 'Introducción a Bituro Chagi'],
