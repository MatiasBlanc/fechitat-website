  rango: string;
  cinturon: string;
  posiciones: string[];
  ataquesBrazo: string[];
  ataquesPierna: string[];
  defensas: string[];
  formas: string[];
  combate: string[];
  rotura?: string[];
  teoria: string[];
  defensaPersonal?: string[];
}

