    combate: ['Técnicas de 1, 2 y 3 pasos', 'Libre'],
    defensaPersonal: ['Resolución de ataques y tomas de palancas (cuello, hombro, codo, muñecas, dedos, rodillas)'],
    rotura: ['De técnica: Twimyo Bandae Dollyo Chagi', 'De poder: Dollyo Chagi mínimo 2 pulgadas', 'Libre'],
    teoria: ['¿Qué es el Tul?', 'Distintos tipos de enfrentamiento', 'Diferencia entre Arte Marcial y Deporte', 'Ciclo de composición del Taekwon-Do', 'Significado y cantidad de movimientos de Hwa-Rang Tul', '¿Qué representa el color del cinturón negro?'],
  },
  {
    rango: '1° Gup a 1er Dan',
    cinturon: 'Rojo Punta Negra a Negro',
    posiciones: ['Revisión de todas las anteriores'],
    ataquesBrazo: ['Los anteriores', 'Con revés de canto de mano (Sonkal Dung Ap Taerigi)'],
    ataquesPierna: ['Los anteriores', 'Patada abanico hacia fuera saltando (Twimyo Bakuro Sewo Chagi)', 'Patada abanico hacia dentro saltando (Twimyo Anuro Sewo Chagi)', 'Patada con talón hacia atrás (Dwitcha Busigi)', 'Dos golpes con un salto'],
    defensas: ['Las anteriores', 'Con antebrazo externo hacia adentro (Palmok Kaunde Ap Makgi)', 'Con cantos de manos en cruz (Kyocha Sonkal Monchau Makgi)', 'Con palmas de manos ascendentes (Sang Sonbadak Ollyo Makgi)'],
    formas: ['Hwa-Rang (anterior)', 'Choong-Moo (30 movimientos)', 'Revisión de cualquier forma anterior'],
    combate: ['Técnicas de 1, 2 y 3 pasos', 'Semi libre', 'Libre'],
    defensaPersonal: ['Resolución con toma de pierna sobre cualquier patada', 'Estudio y aplicación de puntos vitales en agarres y/o ataques'],
    rotura: ['De técnica', 'De poder', 'Libre'],
    teoria: ['Teoría del poder', 'Relación instructor-alumno', '1er Dan: ¿Experto o novato?', 'Cultura Moral y Filosofía del Taekwon-Do', 'Significado y cantidad de movimientos de Choong-Moo', '¿Qué representa el color del cinturón negro?', 'Vocabulario'],
  },
];

const descripcionPrograma =
  'Diseñada y revisada por los Sabumnim Osvaldo Rojas y Javier Lillo, Directores Técnicos de FECHITAT. Cada grado incluye los requisitos de posiciones, técnicas, formas, combate, rotura y teoría.';
const programaSanity = await getProgramaExamen();
const programaVisible = programaSanity?.grados?.length
  ? programaSanity
  : { titulo: 'Programa de examinación FECHITAT', descripcion: descripcionPrograma, grados };
---

<BaseLayout title={titulo} description={descripcion}>
  <PageHero
    title={programaVisible.titulo}
    description={programaVisible.descripcion ?? 'Requisitos de cada grado para los exámenes de progresión de FECHITAT.'}
  />

  <section class="py-10 md:py-16">
    <div class="max-w-5xl mx-auto px-5 md:px-7">
      <div class="mb-10">
        <h2>{programaVisible.titulo}</h2>
        <p class="text-text-soft text-sm md:text-base max-w-[60ch] mt-2">
          {programaVisible.descripcion ?? descripcionPrograma}
        </p>
      </div>

      <div class="space-y-4">
        {programaVisible.grados.map((grado) => (
          <details class="bg-white border border-line rounded-sm overflow-hidden group">
            <summary class="flex items-center justify-between gap-4 p-5 cursor-pointer list-none select-none hover:bg-paper transition-colors duration-150">
              <div>
                <span class="font-mono text-xs tracking-widest uppercase text-text-soft">
                  {grado.rango}
                </span>
                <h3 class="text-base md:text-lg m-0 mt-1">{grado.cinturon}</h3>
              </div>
              <span class="text-text-soft text-lg transition-transform duration-200 group-open:rotate-45">+</span>
            </summary>

            <div class="px-5 pb-5 border-t border-line">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-5">

                {/* Posiciones */}
                <div>
                  <h4 class="text-sm font-mono tracking-wider uppercase text-red mb-2">Posiciones (Sogi)</h4>
                  <ul class="space-y-1">
                    {grado.posiciones.map((item) => <li class="text-sm text-text-soft">• {item}</li>)}
                  </ul>
                </div>

                {/* Ataques con brazos */}
                <div>
                  <h4 class="text-sm font-mono tracking-wider uppercase text-red mb-2">Ataques con brazos (Son Gisool)</h4>
                  <ul class="space-y-1">
                    {grado.ataquesBrazo.map((item) => <li class="text-sm text-text-soft">• {item}</li>)}
                  </ul>
                </div>

                {/* Ataques con piernas */}
                <div>
                  <h4 class="text-sm font-mono tracking-wider uppercase text-red mb-2">Ataques con piernas (Bal Gisool)</h4>
                  <ul class="space-y-1">
                    {grado.ataquesPierna.map((item) => <li class="text-sm text-text-soft">• {item}</li>)}
                  </ul>
                </div>

                {/* Defensas */}
                <div>
                  <h4 class="text-sm font-mono tracking-wider uppercase text-red mb-2">Defensa con brazos (Makgi)</h4>
                  <ul class="space-y-1">
                    {grado.defensas.map((item) => <li class="text-sm text-text-soft">• {item}</li>)}
                  </ul>
                </div>

                {/* Formas */}
                <div>
                  <h4 class="text-sm font-mono tracking-wider uppercase text-red mb-2">Formas (Tul)</h4>
                  <ul class="space-y-1">
                    {grado.formas.map((item) => <li class="text-sm text-text-soft">• {item}</li>)}
                  </ul>
                </div>

                {/* Combate */}
                <div>
                  <h4 class="text-sm font-mono tracking-wider uppercase text-red mb-2">Combate (Matsokgi)</h4>
                  <ul class="space-y-1">
                    {grado.combate.map((item) => <li class="text-sm text-text-soft">• {item}</li>)}
                  </ul>
                </div>

                {/* Defensa personal (si existe) */}
                {grado.defensaPersonal && (
                  <div>
                    <h4 class="text-sm font-mono tracking-wider uppercase text-red mb-2">Defensa personal</h4>
                    <ul class="space-y-1">
                      {grado.defensaPersonal.map((item) => <li class="text-sm text-text-soft">• {item}</li>)}
                    </ul>
                  </div>
                )}

                {/* Rotura (si existe) */}
                {grado.rotura && (
                  <div>
                    <h4 class="text-sm font-mono tracking-wider uppercase text-red mb-2">Rotura (Kyokpa)</h4>
                    <ul class="space-y-1">
                      {grado.rotura.map((item) => <li class="text-sm text-text-soft">• {item}</li>)}
                    </ul>
                  </div>
                )}

                {/* Teoría */}
                <div class="md:col-span-2">
                  <h4 class="text-sm font-mono tracking-wider uppercase text-red mb-2">Teoría</h4>
                  <ul class="grid grid-cols-1 sm:grid-cols-2 gap-1">
                    {grado.teoria.map((item) => <li class="text-sm text-text-soft">• {item}</li>)}
                  </ul>
                </div>

              </div>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
