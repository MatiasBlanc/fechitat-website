---
// Footer: igual en las 6 páginas.
// Enlaces internos placeholder (documentos/transparencia) — TODO:
// apuntar a las rutas reales cuando existan.
import UIcon from './icons/UIcon.astro';
import SocialLinks from './SocialLinks.astro';
---

<footer class="bg-ink text-[#aeb3bf] py-[3.2em] pb-[1.6em]">
  <div class="max-w-[var(--maxw)] mx-auto px-[28px]">
    <div class="grid grid-cols-[1.4fr_1fr_1fr_1fr] gap-[2em] pb-[2.6em] border-b border-white/10 max-[800px]:grid-cols-2">
      <div>
        <div class="flex items-center gap-[0.7em] text-white font-heading font-extrabold tracking-[0.02em] text-[1.05rem] mb-[1em]">
          <img src="/images/general/fechitat-logo.svg" alt="" class="w-[36px] h-[36px] object-contain" />
          FECHITAT
        </div>
        <p class="max-w-[32ch] text-[#9aa0ad]">
          Federación Chilena de Taekwon-Do Tradicional, afiliada a ITF.
          Formando artistas marciales desde los dojangs de todo Chile.
        </p>
      </div>
      <div>
        <h4 class="text-white font-mono text-[0.78rem] tracking-[0.08em] uppercase mb-[1em]">Legales</h4>
        <ul class="list-none p-0 m-0 flex flex-col gap-[0.6em] text-[0.9rem]">
          <li><a href="#" class="hover:text-white transition-colors duration-150">Documentos</a></li>
          <li><a href="#" class="hover:text-white transition-colors duration-150">Transparencia</a></li>
          <li><a href="#" class="hover:text-white transition-colors duration-150">Estatutos</a></li>
          <li><a href="#" class="hover:text-white transition-colors duration-150">Afiliación a la federación</a></li>
          <li><a href="#" class="hover:text-white transition-colors duration-150">Listado de escuelas</a></li>
        </ul>
      </div>
      <div>
        <h4 class="text-white font-mono text-[0.78rem] tracking-[0.08em] uppercase mb-[1em]">Recursos</h4>
        <ul class="list-none p-0 m-0 flex flex-col gap-[0.6em] text-[0.9rem]">
          <li><a href="#" class="hover:text-white transition-colors duration-150">Manual de exámenes</a></li>
          <li><a href="#" class="hover:text-white transition-colors duration-150">Reglamento de torneos</a></li>
          <li><a href="#" class="hover:text-white transition-colors duration-150">Enciclopedia técnica</a></li>
        </ul>
      </div>
      <div>
        <h4 class="text-white font-mono text-[0.78rem] tracking-[0.08em] uppercase mb-[1em]">Contacto</h4>
        <ul class="list-none p-0 m-0 flex flex-col gap-[0.6em] text-[0.9rem]">
          <li class="flex items-center gap-[0.5em]">
            <UIcon name="mail" size={16} />
            <span>contacto@fechitat.cl</span>
          </li>
          <li class="flex items-center gap-[0.5em]">
            <UIcon name="phone" size={16} />
            <span>+569 8888 9668</span>
          </li>
        </ul>
      </div>
    </div>
    <div class="flex justify-between items-center pt-[1.6em] text-[0.82rem] flex-wrap gap-[1em]">
      <div>Hecho en ★ con espíritu indómito.</div>
      <SocialLinks />
    </div>
  </div>
</footer>
