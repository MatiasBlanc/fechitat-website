---
/**
 * Componente Timeline — Línea de tiempo responsive.
 *
 * - En móvil (< md): layout vertical alternado (zigzag).
 * - En desktop (≥ md): layout horizontal con scroll drag.
 * - Cada hito trunca la descripción a 2 líneas con "Leer más" expandible.
 *
 * Props:
 *   hitos  – Array de { anio, titulo, descripcion }
 */
interface Hito {
  anio: string;
  titulo: string;
  descripcion: string;
}

interface Props {
  hitos: Hito[];
}

const { hitos } = Astro.props;
---

<!-- ======== Timeline vertical (móvil) ======== -->
<div class="timeline-vertical md:hidden">
  <div class="relative pl-8">
    <!-- Línea vertical -->
    <div class="absolute left-3 top-0 bottom-0 w-0.5 bg-slate-200"></div>

    {hitos.map((hito, i) => (
      <div class:list={['relative pb-8 last:pb-0', i % 2 === 0 ? 'timeline-item-left' : 'timeline-item-right']}>
        <!-- Punto en la línea -->
        <div
          class="absolute left-[-17px] top-1.5 w-3.5 h-3.5 rounded-full border-2 border-white shadow-xs bg-itf-blue z-10"
        ></div>

        <!-- Card -->
        <div class="timeline-card bg-white border border-slate-200 rounded-xl p-4 shadow-xs">
          <span class="block font-mono text-xs font-semibold uppercase tracking-wider text-itf-blue mb-1">
            {hito.anio}
          </span>
          <h4 class="text-sm font-bold text-slate-900 leading-snug mb-1.5">{hito.titulo}</h4>
          <p
            class="text-xs text-slate-600 leading-relaxed timeline-desc"
            data-full={hito.descripcion}
          >
            {hito.descripcion}
          </p>
          {hito.descripcion.length > 120 && (
            <button
              class="timeline-toggle mt-2 font-mono text-xs font-semibold uppercase tracking-wider text-itf-blue hover:underline bg-transparent border-none cursor-pointer p-0"
              aria-expanded="false"
            >
              Leer más ↓
            </button>
          )}
        </div>
      </div>
    ))}
  </div>
</div>

<!-- ======== Timeline horizontal (desktop) ======== -->
<div class="timeline-horizontal hidden md:block">
  <div class="timeline-track overflow-x-auto cursor-grab pb-4">
    <div class="flex gap-4 min-w-max max-w-7xl mx-auto relative pt-10">
      <!-- Línea horizontal -->
      <div class="absolute top-[27px] left-0 right-0 h-0.5 bg-slate-200"></div>

      {hitos.map((hito) => (
        <div class="flex-none w-64 lg:w-72 relative">
          <!-- Punto -->
          <div
            class="absolute top-[-25px] left-6 w-3.5 h-3.5 rounded-full border-2 border-white shadow-xs bg-itf-blue z-10"
          ></div>

          <!-- Card -->
          <div class="timeline-card bg-white border border-slate-200 rounded-xl p-5 shadow-xs transition-all duration-200 hover:shadow-md">
            <span class="block font-mono text-xs font-semibold uppercase tracking-wider text-itf-blue mb-1.5">
              {hito.anio}
            </span>
            <h4 class="text-sm font-bold text-slate-900 leading-snug mb-1.5">{hito.titulo}</h4>
            <p
              class="text-xs text-slate-600 leading-relaxed timeline-desc line-clamp-2"
              data-full={hito.descripcion}
            >
              {hito.descripcion}
            </p>
            {hito.descripcion.length > 80 && (
              <button
                class="timeline-toggle mt-2 font-mono text-xs font-semibold uppercase tracking-wider text-itf-blue hover:underline bg-transparent border-none cursor-pointer p-0"
                aria-expanded="false"
              >
                Leer más ↓
              </button>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Indicador de scroll -->
  <div class="flex justify-center gap-2 mt-4">
    <div class="flex items-center gap-1.5 font-mono text-xs tracking-wider uppercase text-slate-500 select-none">
      <svg class="w-4 h-4 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18" />
      </svg>
      Desliza horizontalmente para explorar
      <svg class="w-4 h-4 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
    </div>
  </div>
</div>

<style>
  /* Limitar descripción a 2 líneas */
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Estado expandido */
  .timeline-desc.expanded {
    -webkit-line-clamp: unset;
    display: block;
  }

  /* Animación de aparición para cards */
  .timeline-vertical .timeline-card {
    animation: fadeSlideUp 0.4s ease-out both;
  }

  .timeline-vertical .timeline-card:nth-child(1) { animation-delay: 0.05s; }
  .timeline-vertical .timeline-card:nth-child(2) { animation-delay: 0.1s; }
  .timeline-vertical .timeline-card:nth-child(3) { animation-delay: 0.15s; }
  .timeline-vertical .timeline-card:nth-child(4) { animation-delay: 0.2s; }

  @keyframes fadeSlideUp {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Cursor grab activo */
  .timeline-track:active {
    cursor: grabbing;
  }
</style>

<script>
  // Expandir / contraer descripción
  document.querySelectorAll('.timeline-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const card = btn.closest('.timeline-card');
      const desc = card?.querySelector('.timeline-desc') as HTMLElement | null;
      if (!desc) return;

      const expanded = desc.classList.toggle('expanded');
      btn.setAttribute('aria-expanded', String(expanded));
      btn.textContent = expanded ? 'Leer menos ↑' : 'Leer más ↓';
    });
  });

  // Drag-to-scroll para timeline horizontal
  const track = document.querySelector('.timeline-horizontal .timeline-track');
  if (track) {
    let isDown = false;
    let startX = 0;
    let scrollLeft = 0;

    track.addEventListener('mousedown', (e: Event) => {
      isDown = true;
      const me = e as MouseEvent;
      startX = me.pageX - (track as HTMLElement).offsetLeft;
      scrollLeft = track.scrollLeft;
    });
    track.addEventListener('mouseleave', () => { isDown = false; });
    track.addEventListener('mouseup', () => { isDown = false; });
    track.addEventListener('mousemove', (e: Event) => {
      if (!isDown) return;
      e.preventDefault();
      const me = e as MouseEvent;
      const x = me.pageX - (track as HTMLElement).offsetLeft;
      track.scrollLeft = scrollLeft - (x - startX) * 1.4;
    });
  }
</script>
