---
interface Props {
  title: string;
  description?: string;
  crumb?: string;
  image?: string;
  imageAlt?: string;
  imageStyle?: string;
}

const { title, description, crumb, image, imageAlt, imageStyle } = Astro.props;
---

<section class="bg-ink text-white py-10 md:py-14 pb-8 md:pb-10">
  <div
    class:list={[
      'max-w-6xl mx-auto px-5 md:px-7',
      image ? 'grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8 items-center' : '',
    ]}
  >
    <div>
      {crumb && (
        <div class="font-mono text-xs tracking-[0.1em] uppercase text-light-muted mb-4">
          <a href="/" class="hover:text-white transition-colors duration-150">Inicio</a> / {crumb}
        </div>
      )}
      <h1 class="text-white text-[clamp(1.8rem,5vw,3.2rem)]" set:html={title} />
      {description && <p class="text-light-soft max-w-[60ch] mt-2">{description}</p>}
      <slot />
    </div>
    {image && <img src={image} alt={imageAlt ?? ''} style={imageStyle} class="rounded-sm w-full" />}
  </div>
</section>
