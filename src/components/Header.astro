---
const { pathname } = Astro.url;

const links = [
  { href: "/", label: "Inicio" },
  { href: "/federacion", label: "Federación" },
  { href: "/eventos", label: "Eventos" },
  { href: "/blog", label: "Blog" },
];

const esActivo = (href) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<header class="sticky top-0 z-50 bg-ink border-b border-white/10">
  <div class="max-w-[1180px] mx-auto px-5 md:px-7 flex items-center justify-between h-16 md:h-[68px]">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 text-white font-heading font-extrabold tracking-wide text-base md:text-lg" aria-label="FECHITAT — Inicio">
      <img src="/images/general/fechitat-logo.svg" alt="" class="w-9 h-9 object-contain" />
      <span>FECHITAT</span>
    </a>

    <!-- Navegación desktop -->
    <nav class="hidden lg:flex items-center gap-8" aria-label="Navegación principal">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              'font-mono text-xs tracking-widest uppercase py-1 border-b-2 border-transparent transition-colors duration-150',
              esActivo(link.href)
                ? 'text-white border-red'
                : 'text-light-soft hover:text-white hover:border-red',
            ]}
          >
            {link.label}
          </a>
        ))
      }
      <a href="/dojangs" class="inline-flex items-center gap-2 bg-red text-white font-mono text-xs tracking-widest uppercase py-2.5 px-5 rounded-sm transition-all duration-150 hover:bg-red-dark hover:-translate-y-px">
        Encuentra tu dojang
      </a>
    </nav>

    <!-- Botón burger (mobile) -->
    <button
      class="lg:hidden flex items-center justify-center w-10 h-10 text-white text-2xl cursor-pointer bg-transparent border-none"
      type="button"
      data-burger
      aria-expanded="false"
      aria-label="Abrir menú"
    >
      ☰
    </button>
  </div>

  <!-- Menú mobile (overlay) -->
  <nav
    class="mobile-nav fixed inset-0 top-16 bg-ink flex flex-col px-5 py-8 gap-6 translate-x-full transition-transform duration-300 lg:hidden z-50"
    aria-label="Navegación móvil"
  >
    {
      links.map((link) => (
        <a
          href={link.href}
          class:list={[
            'font-mono text-sm tracking-widest uppercase py-2 border-l-2 transition-colors duration-150 pl-4',
            esActivo(link.href)
              ? 'text-white border-red'
              : 'text-light-soft hover:text-white border-transparent',
          ]}
        >
          {link.label}
        </a>
      ))
    }
    <a href="/dojangs" class="inline-flex items-center justify-center gap-2 bg-red text-white font-mono text-sm tracking-widest uppercase py-3 px-6 rounded-sm transition-all duration-150 hover:bg-red-dark mt-4">
      Encuentra tu dojang
    </a>
  </nav>
</header>

<style>
  .mobile-nav.open {
    transform: translateX(0);
  }
</style>
