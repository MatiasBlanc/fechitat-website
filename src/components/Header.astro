---
import Button from "./ui/Button.astro";
import UIcon from "./icons/UIcon.astro";

const { pathname } = Astro.url;

const esActivo = (href: string) => {
  if (href === "/") return pathname === "/";
  return pathname.startsWith(href);
};

const navLinks = [
  { href: "/federacion", label: "Federación", active: esActivo("/federacion") },
  { href: "/escuelas", label: "Escuelas", active: esActivo("/escuelas") },
  { href: "/eventos", label: "Eventos", active: esActivo("/eventos") },
  { href: "/estudio", label: "Formación", active: esActivo("/estudio") || esActivo("/examen") },
  { href: "/blog", label: "Actualidad", active: esActivo("/blog") },
];

const mobileBottomItems = [
  { href: "/", label: "Inicio", icon: "home", active: pathname === "/" },
  { href: "/escuelas", label: "Escuelas", icon: "map-pin", active: esActivo("/escuelas") },
  { href: "/eventos", label: "Eventos", icon: "calendar", active: esActivo("/eventos") },
  { href: "/estudio", label: "Formación", icon: "book", active: esActivo("/estudio") || esActivo("/examen") },
];
---

<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-200 shadow-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-16 md:h-18">
    <!-- Logo Institucional -->
    <a
      href="/"
      class="flex items-center gap-3 text-slate-950 font-bold tracking-tight text-lg group focus-visible:ring-2 focus-visible:ring-itf-red rounded-md p-1 -ml-1"
      aria-label="FECHITAT — Inicio"
    >
      <img
        src="/images/general/fechitat-logo.svg"
        alt=""
        width="36"
        height="36"
        class="w-9 h-9 object-contain transition-transform group-hover:scale-105"
      />
      <div class="flex flex-col leading-none">
        <span class="font-extrabold text-base sm:text-lg tracking-wide text-slate-900">FECHITAT</span>
        <span class="text-xs font-semibold text-itf-blue tracking-wider uppercase">Taekwon-Do ITF Chile</span>
      </div>
    </a>

    <!-- Navegación Desktop -->
    <nav class="hidden lg:flex items-center gap-1 xl:gap-2" aria-label="Navegación principal">
      {navLinks.map((link) => (
        <a
          href={link.href}
          data-astro-prefetch="hover"
          class:list={[
            "px-3 py-2 text-sm font-semibold rounded-md transition-colors",
            link.active
              ? "text-itf-red bg-red-50 font-bold"
              : "text-slate-700 hover:text-slate-950 hover:bg-slate-100",
          ]}
          aria-current={link.active ? "page" : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- CTA Header Desktop & Drawer trigger mobile -->
    <div class="flex items-center gap-3">
      <div class="hidden lg:block">
        <Button href="/escuelas" variant="primary" size="sm">
          Encontrar una escuela
        </Button>
      </div>

      <!-- Botón Menú Mobile Superior -->
      <button
        type="button"
        id="btn-abrir-drawer"
        class="lg:hidden inline-flex items-center justify-center p-2.5 rounded-lg text-slate-700 hover:text-slate-950 hover:bg-slate-100 focus-visible:ring-2 focus-visible:ring-itf-red transition-colors"
        aria-expanded="false"
        aria-controls="drawer-navegacion"
        aria-label="Abrir menú de navegación"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Navigation: Bottom Nav Bar -->
<nav
  aria-label="Navegación móvil inferior"
  class="fixed bottom-0 inset-x-0 z-40 bg-white/95 backdrop-blur-md border-t border-slate-200 lg:hidden shadow-md"
>
  <div class="grid grid-cols-5 h-16">
    {mobileBottomItems.map((item) => (
      <a
        href={item.href}
        class:list={[
          "flex flex-col items-center justify-center gap-1 text-xs transition-colors py-1 focus-visible:ring-2 focus-visible:ring-itf-red focus-visible:outline-none",
          item.active
            ? "text-itf-red font-bold"
            : "text-slate-600 hover:text-slate-900 font-semibold",
        ]}
        aria-current={item.active ? "page" : undefined}
      >
        {item.icon === "home" && (
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
          </svg>
        )}
        {item.icon === "map-pin" && (
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
          </svg>
        )}
        {item.icon === "calendar" && (
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
          </svg>
        )}
        {item.icon === "book" && (
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />
          </svg>
        )}
        <span>{item.label}</span>
      </a>
    ))}

    <!-- Quinto botón: Menú (Abre Drawer) -->
    <button
      type="button"
      id="btn-abrir-drawer-bottom"
      class="flex flex-col items-center justify-center gap-1 text-xs font-semibold text-slate-600 hover:text-slate-900 transition-colors py-1 cursor-pointer focus-visible:ring-2 focus-visible:ring-itf-red focus-visible:outline-none"
      aria-expanded="false"
      aria-controls="drawer-navegacion"
      aria-label="Abrir menú completo"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
      <span>Menú</span>
    </button>
  </div>
</nav>

<!-- Mobile Navigation Drawer / Modal -->
<div
  id="drawer-navegacion"
  class="fixed inset-0 z-50 pointer-events-none transition-opacity duration-300 opacity-0 lg:hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Menú principal de navegación"
>
  <!-- Backdrop -->
  <div
    id="drawer-backdrop"
    class="absolute inset-0 bg-slate-950/60 backdrop-blur-xs transition-opacity"
    aria-hidden="true"
  ></div>

  <!-- Panel del Drawer -->
  <div
    id="drawer-panel"
    class="absolute top-0 right-0 bottom-0 w-full max-w-sm bg-white shadow-2xl flex flex-col translate-x-full transition-transform duration-300 pointer-events-auto"
  >
    <!-- Encabezado del Drawer -->
    <div class="flex items-center justify-between p-5 border-b border-slate-200">
      <div class="flex items-center gap-2.5">
        <img src="/images/general/fechitat-logo.svg" alt="" width="32" height="32" class="w-8 h-8 object-contain" />
        <span class="font-extrabold text-slate-900 text-lg">FECHITAT</span>
      </div>
      <button
        type="button"
        id="btn-cerrar-drawer"
        class="p-2 rounded-lg text-slate-500 hover:text-slate-900 hover:bg-slate-100 transition-colors focus-visible:ring-2 focus-visible:ring-itf-red"
        aria-label="Cerrar menú"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Enlaces del Drawer -->
    <nav class="flex-1 overflow-y-auto p-5 space-y-1" aria-label="Enlaces del menú móvil">
      <a
        href="/"
        class:list={[
          "flex items-center justify-between px-4 py-3 rounded-lg text-sm font-semibold transition-colors",
          pathname === "/" ? "bg-itf-red-light text-itf-red font-bold" : "text-slate-700 hover:bg-slate-50 hover:text-slate-900",
        ]}
      >
        <span>Inicio</span>
        <span class="text-xs text-slate-400">→</span>
      </a>

      <a
        href="/federacion"
        class:list={[
          "flex items-center justify-between px-4 py-3 rounded-lg text-sm font-semibold transition-colors",
          esActivo("/federacion") ? "bg-itf-red-light text-itf-red font-bold" : "text-slate-700 hover:bg-slate-50 hover:text-slate-900",
        ]}
      >
        <span>Federación</span>
        <span class="text-xs text-slate-400">→</span>
      </a>

      <a
        href="/formacion#filosofia"
        class="flex items-center justify-between px-4 py-3 rounded-lg text-sm font-semibold text-slate-700 hover:bg-slate-50 hover:text-slate-900 transition-colors"
      >
        <span>Taekwon-Do</span>
        <span class="text-xs text-slate-400">→</span>
      </a>

      <a
        href="/escuelas"
        class:list={[
          "flex items-center justify-between px-4 py-3 rounded-lg text-sm font-semibold transition-colors",
          esActivo("/escuelas") ? "bg-itf-red-light text-itf-red font-bold" : "text-slate-700 hover:bg-slate-50 hover:text-slate-900",
        ]}
      >
        <span>Escuelas Afiliadas</span>
        <span class="text-xs text-slate-400">→</span>
      </a>

      <a
        href="/eventos"
        class:list={[
          "flex items-center justify-between px-4 py-3 rounded-lg text-sm font-semibold transition-colors",
          esActivo("/eventos") ? "bg-itf-red-light text-itf-red font-bold" : "text-slate-700 hover:bg-slate-50 hover:text-slate-900",
        ]}
      >
        <span>Competición y Eventos</span>
        <span class="text-xs text-slate-400">→</span>
      </a>

      <a
        href="/estudio"
        class:list={[
          "flex items-center justify-between px-4 py-3 rounded-lg text-sm font-semibold transition-colors",
          esActivo("/estudio") ? "bg-itf-red-light text-itf-red font-bold" : "text-slate-700 hover:bg-slate-50 hover:text-slate-900",
        ]}
      >
        <span>Material de Estudio</span>
        <span class="text-xs text-slate-400">→</span>
      </a>

      <a
        href="/examen"
        class:list={[
          "flex items-center justify-between px-4 py-3 rounded-lg text-sm font-semibold transition-colors",
          esActivo("/examen") ? "bg-itf-red-light text-itf-red font-bold" : "text-slate-700 hover:bg-slate-50 hover:text-slate-900",
        ]}
      >
        <span>Programa de Examen</span>
        <span class="text-xs text-slate-400">→</span>
      </a>

      <a
        href="/blog"
        class:list={[
          "flex items-center justify-between px-4 py-3 rounded-lg text-sm font-semibold transition-colors",
          esActivo("/blog") ? "bg-itf-red-light text-itf-red font-bold" : "text-slate-700 hover:bg-slate-50 hover:text-slate-900",
        ]}
      >
        <span>Blog y Noticias</span>
        <span class="text-xs text-slate-400">→</span>
      </a>

      <div class="pt-4 mt-4 border-t border-slate-200">
        <a
          href="/federacion/documentos"
          class:list={[
            "flex items-center justify-between px-4 py-3 rounded-lg text-sm font-semibold transition-colors",
            esActivo("/federacion/documentos") ? "bg-itf-red-light text-itf-red font-bold" : "text-slate-700 hover:bg-slate-50 hover:text-slate-900",
          ]}
        >
          <span>Documentos Oficiales</span>
          <span class="text-xs font-semibold px-2 py-0.5 rounded bg-itf-blue-light text-itf-blue">PDF</span>
        </a>
      </div>
    </nav>

    <!-- Footer del Drawer -->
    <div class="p-5 border-t border-slate-200 space-y-3 bg-slate-50">
      <Button href="/escuelas" variant="primary" size="md" class="w-full justify-center">
        Encontrar una escuela
      </Button>

      <div class="text-xs text-slate-500 text-center pt-2">
        <p>contacto@fechitat.cl</p>
        <p class="mt-0.5">Taekwon-Do ITF Original en Chile</p>
      </div>
    </div>
  </div>
</div>

<script>
  function setupDrawer() {
    const drawer = document.getElementById("drawer-navegacion");
    const panel = document.getElementById("drawer-panel");
    const backdrop = document.getElementById("drawer-backdrop");
    const btnAbrir = document.getElementById("btn-abrir-drawer");
    const btnAbrirBottom = document.getElementById("btn-abrir-drawer-bottom");
    const btnCerrar = document.getElementById("btn-cerrar-drawer");

    function abrirDrawer() {
      if (!drawer || !panel) return;
      drawer.classList.remove("pointer-events-none", "opacity-0");
      drawer.classList.add("pointer-events-auto", "opacity-100");
      panel.classList.remove("translate-x-full");
      panel.classList.add("translate-x-0");
      btnAbrir?.setAttribute("aria-expanded", "true");
      btnAbrirBottom?.setAttribute("aria-expanded", "true");
      document.body.style.overflow = "hidden";
      btnCerrar?.focus();
    }

    function cerrarDrawer() {
      if (!drawer || !panel) return;
      panel.classList.remove("translate-x-0");
      panel.classList.add("translate-x-full");
      drawer.classList.remove("opacity-100");
      drawer.classList.add("opacity-0");
      setTimeout(() => {
        drawer.classList.remove("pointer-events-auto");
        drawer.classList.add("pointer-events-none");
      }, 300);
      btnAbrir?.setAttribute("aria-expanded", "false");
      btnAbrirBottom?.setAttribute("aria-expanded", "false");
      document.body.style.overflow = "";
      btnAbrir?.focus();
    }

    btnAbrir?.addEventListener("click", abrirDrawer);
    btnAbrirBottom?.addEventListener("click", abrirDrawer);
    btnCerrar?.addEventListener("click", cerrarDrawer);
    backdrop?.addEventListener("click", cerrarDrawer);

    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && drawer?.classList.contains("opacity-100")) {
        cerrarDrawer();
      }
    });

    // Cerrar al navegar en móvil
    drawer?.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => cerrarDrawer());
    });
  }

  // Inicializar en primera carga y tras navegación ClientRouter
  setupDrawer();
  document.addEventListener("astro:page-load", setupDrawer);
</script>

