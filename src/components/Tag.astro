---
// Etiqueta semántica sutil
interface Props {
  variant?: 'default' | 'red' | 'blue' | 'gold';
  style?: string;
  class?: string;
}

const { variant = 'default', style, class: className = '' } = Astro.props;

const variantClasses = {
  default: 'bg-slate-100 text-slate-700 border border-slate-200',
  red: 'bg-itf-red-light text-itf-red border border-itf-red-border font-semibold',
  blue: 'bg-itf-blue-light text-itf-blue border border-itf-blue-border',
  gold: 'bg-amber-50 text-amber-900 border border-amber-200',
};
---

<span
  class:list={[
    'inline-flex items-center text-xs font-semibold px-2.5 py-0.5 rounded-md transition-colors',
    variantClasses[variant],
    className,
  ]}
  style={style}
><slot /></span>

