---
interface EnlaceRiel {
  href: string;
  kr: string;
  label: string;
}

interface Props {
  links: EnlaceRiel[];
}

const { links } = Astro.props;
---

<div class="hangul-rail hidden xl:flex fixed right-4 top-1/2 -translate-y-1/2 flex-col gap-6 z-40" aria-label="Navegación de secciones">
  {
    links.map((enlace, index) => (
      <a
        href={enlace.href}
        data-side-nav-link
        class:list={[
          'writing-mode-vertical font-mono text-[0.68rem] tracking-[0.08em] flex items-center gap-[0.6em] transition-all duration-200',
          index === 0
            ? 'active opacity-100 text-red'
            : 'opacity-55 text-text-soft hover:opacity-100 hover:text-red',
        ]}
      >
        <span class="text-[0.85rem]">{enlace.kr}</span>
        <span>{enlace.label}</span>
      </a>
    ))
  }
</div>

<script>
  const enlaces = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-side-nav-link]'));
  const secciones = enlaces
    .map((enlace) => document.getElementById(enlace.hash.slice(1)))
    .filter((seccion): seccion is HTMLElement => Boolean(seccion));

  const activarEnlace = (seccionActiva: HTMLElement) => {
    enlaces.forEach((enlace) => {
      const estaActivo = enlace.hash === `#${seccionActiva.id}`;
      enlace.classList.toggle('active', estaActivo);
      enlace.classList.toggle('opacity-100', estaActivo);
      enlace.classList.toggle('text-red', estaActivo);
      enlace.classList.toggle('opacity-55', !estaActivo);
      enlace.classList.toggle('text-text-soft', !estaActivo);
    });
  };

  if (secciones.length && 'IntersectionObserver' in window) {
    const observador = new IntersectionObserver(
      (entradas) => {
        const visible = entradas.find((entrada) => entrada.isIntersecting)?.target;
        if (visible instanceof HTMLElement) activarEnlace(visible);
      },
      { rootMargin: '-35% 0px -55% 0px', threshold: 0 },
    );
    secciones.forEach((seccion) => observador.observe(seccion));
  }
</script>
