---
// Botón redondeado del filtro de blog, con estado activo.
interface Props {
  active?: boolean;
}

const { active = false } = Astro.props;
---

<button
  class:list={[
    'font-mono text-[0.72rem] tracking-[0.06em] uppercase border border-line px-[1em] py-[0.5em] rounded-[20px] bg-white cursor-pointer transition-all duration-150',
    active
      ? 'bg-ink text-white border-ink'
      : 'hover:bg-ink hover:text-white hover:border-ink',
  ]}
  type="button"
><slot /></button>
