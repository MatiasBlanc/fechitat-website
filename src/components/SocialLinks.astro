---
// Enlaces a redes sociales con iconos SVG reales.
// Se usa en Header y Footer.
import SocialIcon from './icons/SocialIcon.astro';

interface EnlaceSocial {
  href: string;
  icono: 'x' | 'instagram' | 'youtube' | 'facebook';
  etiqueta: string;
}

interface Props {
  class?: string;
  enlaces?: EnlaceSocial[];
}

const enlacesPorDefecto: EnlaceSocial[] = [
  { href: '#', icono: 'x', etiqueta: 'X (Twitter)' },
  { href: '#', icono: 'instagram', etiqueta: 'Instagram' },
  { href: '#', icono: 'youtube', etiqueta: 'YouTube' },
  { href: '#', icono: 'facebook', etiqueta: 'Facebook' },
];

const { class: clase = 'flex gap-4 items-center', enlaces = enlacesPorDefecto } = Astro.props;
---

<div class={clase}>
  {
    enlaces.map((enlace) => (
      <a
        href={enlace.href}
        aria-label={enlace.etiqueta}
        class="w-8 h-8 border border-white/20 rounded-full flex items-center justify-center text-light-soft text-xs hover:border-itf-red hover:text-white transition-colors duration-150"
      >
        <SocialIcon name={enlace.icono} size={15} />
      </a>
    ))
  }
</div>
