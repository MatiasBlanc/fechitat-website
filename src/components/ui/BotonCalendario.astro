---
// Botón para agregar un evento al calendario.
import { urlGoogleCalendar } from "../../lib/calendario";

interface Props {
  evento: {
    titulo: string;
    fecha: string;
    fechaFin?: string;
    direccion?: string;
    ciudad?: string;
    lugar?: string;
    descripcion?: string;
  };
  className?: string;
}

const { evento, className = "" } = Astro.props;
const href = urlGoogleCalendar(evento);
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class:list={[
    "inline-flex items-center justify-center gap-2 font-mono text-xs tracking-widest uppercase px-5 py-2.5 rounded-sm transition-all duration-150",
    className || "bg-transparent border border-ink text-ink",
  ]}
>
  <svg
    aria-hidden="true"
    width="14"
    height="14"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <rect x="3" y="4" width="18" height="18" rx="2" />
    <line x1="16" y1="2" x2="16" y2="6" />
    <line x1="8" y1="2" x2="8" y2="6" />
    <line x1="3" y1="10" x2="21" y2="10" />
  </svg>
  Agregar a calendario
</a>