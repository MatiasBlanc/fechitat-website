---
// Componente Button reutilizable con variantes.
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost' | 'dark' | 'dark-ghost';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  class?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  class: clase = '',
  type = 'button',
  disabled = false,
} = Astro.props;

const baseClasses = 'inline-flex items-center gap-2 font-semibold font-kumbh tracking-wider uppercase rounded-sm cursor-pointer transition-all duration-150 active:opacity-90 disabled:opacity-50 disabled:cursor-not-allowed disabled:pointer-events-none';

const sizeClasses = {
  sm: 'text-xs py-2 px-3.5',
  md: 'text-xs py-2.5 px-5',
  lg: 'text-sm py-3 px-6',
};

const variantClasses = {
  primary: 'bg-itf-red text-white hover:bg-itf-red-dark shadow-xs',
  secondary: 'bg-slate-900 text-white hover:bg-slate-800 shadow-xs',
  ghost: 'bg-transparent border border-white/60 text-white hover:bg-white/10',
  dark: 'bg-slate-900 text-white hover:bg-slate-800 shadow-xs',
  'dark-ghost': 'bg-transparent border border-slate-900 text-slate-900 hover:bg-slate-100',
  blue: 'bg-itf-blue text-white hover:bg-itf-blue-dark shadow-xs',
};

const allClasses = `${baseClasses} ${sizeClasses[size]} ${variantClasses[variant] ?? variantClasses.primary} ${clase}`;
---

{href ? (
  <a href={href} class={allClasses}>
    <slot />
  </a>
) : (
  <button type={type} class={allClasses} disabled={disabled}>
    <slot />
  </button>
)}
