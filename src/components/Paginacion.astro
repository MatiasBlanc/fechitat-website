---
// Paginación de listados: funciona sin JavaScript (enlaces reales).
interface Props {
  /** Página actual (1-based). */
  actual: number;
  /** Total de páginas. */
  total: number;
  /** Base de la URL (p. ej. "/blog"). La página 1 no lleva sufijo. */
  base: string;
}

const { actual, total, base } = Astro.props;

const paginas = Array.from({ length: total }, (_, i) => i + 1);
const hrefPagina = (n: number) => (n === 1 ? `${base}/` : `${base}/pagina/${n}`);

if (total <= 1) return null;
---

<nav class="mt-10" aria-label="Paginación">
  <ul class="flex items-center justify-center gap-2 list-none p-0 m-0">
    <li>
      {actual > 1 ? (
        <a
          href={hrefPagina(actual - 1)}
          class="inline-flex items-center justify-center w-10 h-10 border border-line bg-white text-ink font-mono text-sm rounded-sm transition-colors duration-150 hover:bg-ink hover:text-white"
          aria-label="Página anterior"
        >
          ←
        </a>
      ) : (
        <span
          class="inline-flex items-center justify-center w-10 h-10 border border-line text-text-soft/50 rounded-sm"
          aria-hidden="true"
        >
          ←
        </span>
      )}
    </li>

    {paginas.map((n) => (
      <li>
        {n === actual ? (
          <span
            class="inline-flex items-center justify-center w-10 h-10 bg-red text-white font-mono text-sm rounded-sm"
            aria-current="page"
          >
            {n}
          </span>
        ) : (
          <a
            href={hrefPagina(n)}
            class="inline-flex items-center justify-center w-10 h-10 border border-line bg-white text-ink font-mono text-sm rounded-sm transition-colors duration-150 hover:bg-ink hover:text-white"
          >
            {n}
          </a>
        )}
      </li>
    ))}

    <li>
      {actual < total ? (
        <a
          href={hrefPagina(actual + 1)}
          class="inline-flex items-center justify-center w-10 h-10 border border-line bg-white text-ink font-mono text-sm rounded-sm transition-colors duration-150 hover:bg-ink hover:text-white"
          aria-label="Página siguiente"
        >
          →
        </a>
      ) : (
        <span
          class="inline-flex items-center justify-center w-10 h-10 border border-line text-text-soft/50 rounded-sm"
          aria-hidden="true"
        >
          →
        </span>
      )}
    </li>
  </ul>
</nav>
