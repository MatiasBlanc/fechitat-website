---
// Grilla de posts del blog, semántica y accesible.
import Tag from "./Tag.astro";
import { urlFor } from "../lib/sanity";

interface Props {
  posts: Array<{
    _id: string;
    titulo: string;
    slug?: { current?: string };
    fecha?: string;
    autor?: string;
    extracto?: string;
    imagen?: unknown;
    imagenUrl?: string;
    imagenAlt?: string;
    categorias?: string[];
  }>;
}

const { posts } = Astro.props;

/** Nombres legibles de las categorías del blog. */
const NOMBRES_CATEGORIAS: Record<string, string> = {
  noticias: "Noticias",
  tecnica: "Técnica",
  entrevistas: "Entrevistas",
  eventos: "Eventos",
  historia: "Historia",
};
---

{
  posts.length > 0 ? (
    <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8 list-none p-0 m-0">
      {posts.map((post) => {
        const href = post.slug?.current
          ? `/blog/${post.slug.current}`
          : "/blog";
        const categoria = post.categorias?.[0];
        return (
          <li data-post-categoria={post.categorias?.join(',') ?? ''} class="h-full">
            <a
              href={href}
              class="group flex flex-col bg-white border border-line rounded-lg overflow-hidden transition-all duration-300 hover:-translate-y-1.5 hover:shadow-xl hover:border-slate-300 h-full"
            >
              <div class="aspect-[16/10] overflow-hidden bg-slate-100">
                {post.imagenUrl || post.imagen ? (
                  <img
                    src={post.imagenUrl ?? urlFor(post.imagen).width(600).auto("format").url()}
                    alt={post.imagenAlt ?? `Imagen de ${post.titulo}`}
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                ) : (
                  <div class="w-full h-full bg-slate-200" />
                )}
              </div>
              <div class="p-5 sm:p-6 flex flex-col flex-1 justify-between">
                <div>
                  <div class="flex items-center gap-2 mb-3">
                    {categoria && (
                      <Tag>{NOMBRES_CATEGORIAS[categoria] ?? categoria}</Tag>
                    )}
                    {post.fecha && (
                      <time
                        class="font-mono text-xs text-text-soft"
                        datetime={post.fecha}
                      >
                        {new Date(post.fecha).toLocaleDateString("es-CL", {
                          day: "numeric",
                          month: "short",
                          year: "numeric",
                        })}
                      </time>
                    )}
                  </div>
                  <h3 class="text-lg sm:text-xl font-bold text-slate-900 group-hover:text-red transition-colors leading-snug line-clamp-2">
                    {post.titulo}
                  </h3>
                  {post.extracto && (
                    <p class="text-text-soft text-sm mt-2 line-clamp-2 leading-relaxed">
                      {post.extracto}
                    </p>
                  )}
                </div>
                <div class="mt-4 pt-3 border-t border-slate-100">
                  <span class="font-mono text-xs uppercase tracking-wider text-red font-semibold group-hover:underline">
                    Leer artículo →
                  </span>
                </div>
              </div>
            </a>
          </li>
        );
      })}
    </ul>
  ) : (
    <div class="text-center py-16">
      <p class="text-text-soft text-lg mb-2">Todavía no hay artículos publicados.</p>
      <p class="text-text-soft text-sm">
        El blog de la federación estará disponible muy pronto.
      </p>
    </div>
  )
}
